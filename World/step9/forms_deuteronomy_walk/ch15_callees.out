  metzora.poor('vower')                                                  {'v': 'the_lepers_status_not_the_vowers', 'p': 'ANSWER-SHEET', 'why': 'Mishnah Arakhin 4:2 — "this leper\'s offering is upon me": a poor leper, the poor offering; 14:21 "if HE is poor" (Sifra, Metzora, Section 4 2)', 'fx': ['accepted']}
==== cold_run_metzora.shave sig ('q',) (2026 chars) asks-in-source ['day_gap', 'festival', 'instrument', 'late', 'nazirite', 'sites', 'status', 'three_shavers']
def shave(q):
        if q == 'sites':
            return cell('head_beard_eyebrows_all_hair', I, '14:9 "his HEAD and his BEARD and his EYEBROWS — all his hair '
                        'he shall shave" ("all his hair" x%d in the verse)' % c_all_hair, 

  metzora.shave('day_gap')                                               {'v': 'shave_seventh_offer_eighth_sunset_between', 'p': 'MOVE', 'why': '14:9 "on the SEVENTH day" / 14:10 "on the EIGHTH day" [INK] — Sifra, Metzora, Chapter 2 7: shaved on the eighth, not the same day (R. Akiva: sunset must interpose; Mishnah Nazir 6:6 R. Tarfon\'s challenge: the leper\'s purity ha
  metzora.shave('festival')                                              {'v': 'shaves_on_the_festival', 'p': 'ANSWER-SHEET', 'why': 'Mishnah Moed Katan 3:1 — the leper rising from impurity to purity shaves on the festival (the commanded shave is not delayed)', 'fx': ['shaved_whole']}
  metzora.shave('instrument')                                            {'v': 'razor_only_two_hairs_left_is_nothing', 'p': 'ANSWER-SHEET', 'why': 'Mishnah Negaim 14:4 — not by a razor, or two hairs left: did nothing (Sifra, Metzora, Chapter 2 6)', 'fx': ['shaved_whole']}
  metzora.shave('late')                                                  {'v': 'valid_8th_9th_10th', 'p': 'MOVE', 'why': 'Sifra, Metzora, Chapter 2 5 — late shaving valid', 'fx': ['shaved_whole']}
  metzora.shave('nazirite')                                              {'v': 'commanded_shave_overrides', 'p': 'ANSWER-SHEET', 'why': 'Mishnah Nazir 6:5 — shaving was permitted from its rule by the shaving of mitzvah', 'fx': ['shaved_whole']}
  metzora.shave('sites')                                                 {'v': 'head_beard_eyebrows_all_hair', 'p': 'INK', 'why': '14:9 "his HEAD and his BEARD and his EYEBROWS — all his hair he shall shave" ("all his hair" x2 in the verse)', 'fx': ['shaved_whole']}
  metzora.shave('status')                                                {'v': 'tevul_yom_eats_tithe_sunset_terumah_atonement_holies', 'p': 'ANSWER-SHEET', 'why': 'Mishnah Negaim 14:3 — the three purities: after the second shave a tevul yom eating tithe; sunset, terumah; the atonement, holies (Keritot 2:1: the leper lacks atonement)', 'fx': ['declared_pure', 'barred_from
  metzora.shave('three_shavers')                                         {'v': 'nazirite_leper_levites', 'p': 'ANSWER-SHEET', 'why': 'Mishnah Negaim 14:4 — the three who shave by command', 'fx': ['—']}
==== YO — the clock cells on the design's values (the cycle's years; the Hebrew slave sold to an Israelite for 60 with 20 years to the jubilee, 6 elapsed; the valuation of a male 30; the going out; the interest's scope):
