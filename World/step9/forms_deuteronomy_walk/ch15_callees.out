  YO.cycle(14)                                                           {'v': 'sabbath_of_the_land', 'p': 'INK', 'why': 'ובשנה השביעת שבת שבתון (in the seventh year a sabbath of rest) at 25:4 — no sowing, pruning, reaping, gathering (25:4-5)', 'fx': ['land_release', 'labor_barred']}
  YO.cycle(49)                                                           {'v': 'sabbath_of_the_land', 'p': 'INK', 'why': 'ובשנה השביעת שבת שבתון (in the seventh year a sabbath of rest) at 25:4 — no sowing, pruning, reaping, gathering (25:4-5)', 'fx': ['land_release', 'labor_barred']}
  YO.cycle(50)                                                           {'v': 'jubilee', 'p': 'INK', 'why': 'שנת החמשים (the fiftieth year) at 25:10-11 — seven sabbaths of years = forty-nine (25:8 states תשע וארבעים), the fiftieth sanctified', 'fx': ['jubilee_release', 'returns_to_holding', 'goes_free', 'land_release', 'labor_barred']}
  YO.jubilee()                                                           {'cycle_length': {'v': 49, 'p': 'INK', 'why': 'תשע וארבעים שנה at 25:8 — the product stated', 'fx': ['jubilee_release']}, 'jubilee_year': {'v': 50, 'p': 'INK', 'why': 'החמשים at 25:10 and 25:11', 'fx': ['jubilee_release']}, 'release_day': {'v': 'tenth_of_seventh_month_yom_kippur', 'p': 'INK', 'why': 'בחדש השבעי בעשור לחדש ביום הכפרים at 25:9', 'fx': ['jubilee_release', 'returns_to_holding', 'goes_free']}, 'sanctified
  YO.sabbatical()                                                        {'torah_labors': {'v': 4, 'p': 'INK', 'why': 'the four verbs the ink writes at 25:4-5: תזרע / תזמר / תקצור / תבצר — sow, prune, reap, gather', 'fx': ['labor_barred', 'land_release']}, 'derivative_layer': {'v': 'rabbinic_verse_as_support', 'p': 'MOVE', 'why': 'the census the Sifra reads from "your field NOT, your vineyard NOT" (weeding, hoeing, trimming, fertilizing, smoking) is RULED rabbinic, the verse a mere suppor
  YO.interest()                                                          {'both_nouns': {'v': 'barred', 'p': 'INK', 'why': 'נשך ותרבית at 25:36; בנשך / ובמרבית at 25:37', 'fx': ['interest_barred']}, 'definitions': {'v': 'money_bite_vs_produce_increase', 'p': 'MOVE', 'why': 'a sela for five dinars; wheat reckoned at the risen price for wine he lacks (Sifra Behar Section 5 2)', 'fx': ['interest_barred']}}
  YO.hebrew_slave("israelite", 60, 20, 6)                                {'status': {'v': 'hireling_resident', 'p': 'INK', 'why': 'כשכיר כתושב יהיה עמך at 25:40', 'fx': ['—']}, 'slave_work': {'v': 'barred', 'p': 'INK', 'why': 'לא תעבד בו עבדת עבד at 25:39', 'fx': ['—']}, 'rigor': {'v': 'barred', 'p': 'INK', 'why': 'לא תרדה בו בפרך at 25:43 (and 25:53 in your sight)', 'fx': ['—']}, 'exit': {'v': 'at_jubilee_with_children', 'p': 'INK', 'why': 'עד שנת היבל יעבד עמך (until the Jubilee year he
  YO.hebrew_slave("gentile", 60, 20, 6)                                  {'status': {'v': 'hireling_resident', 'p': 'INK', 'why': 'כשכיר כתושב יהיה עמך at 25:40', 'fx': ['—']}, 'slave_work': {'v': 'barred', 'p': 'INK', 'why': 'לא תעבד בו עבדת עבד at 25:39', 'fx': ['—']}, 'rigor': {'v': 'barred', 'p': 'INK', 'why': 'לא תרדה בו בפרך at 25:43 (and 25:53 in your sight)', 'fx': ['—']}, 'exit': {'v': 'at_jubilee_with_children', 'p': 'INK', 'why': 'עד שנת היבל יעבד עמך (until the Jubilee year he
  YO.going_out()                                                         {'v': 'to_the_priests', 'p': 'INK', 'why': 'והיה השדה בצאתו ביבל קדש ליהוה כשדה החרם לכהן תהיה אחזתו (and the field in its going out in the jubilee shall be holy to the LORD as the devoted field; to the priest shall be its holding) at 27:21 — the holding unredeemed', 'fx': ['goes_out_in_the_jubilee', 'due_to_priest']}
