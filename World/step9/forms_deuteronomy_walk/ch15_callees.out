  food_tithe.the_second_tithe({ask:named_the_second})                    ("named the second (14:22) — 'tithe, you shall tithe' the second tithe at its first seat (the Sifrei 105:2; the first the Levite's — KO.the_tithe by CALL, tithe_granted unmoved; PN's two tithes by CALL): THE WRITE second_tithe_owed — a STATUS on Israel at the chapter's own day; the readback row 14:2
  food_tithe.the_second_tithe({ask:the_exiles_arm})                      ("the exile's arm (14:23) — no Temple: the produce left to rot, the animal buried with its hide (Mishnah Maaser Sheni 1:5-6; the eras table by CALL): the one in exile who buries it with its hide accepted", ['accepted'])
  food_tithe.the_second_tithe({ask:the_firstling})                       ('the firstling (14:23) — holy, not redeemed, given on the eighth day, eaten two days and a night (OR.firstling, KO.the_gifts by CALL; Bekhorot 34a-35a the blemish): the priest who eats the firstling within its window accepted', ['accepted'])
  food_tithe.the_second_tithe({ask:the_firstling_from_outside})          ('the firstling from outside (14:23) — not brought from outside the Land (the Sifrei 106:2; Temurah 21b:3): the one who brings a firstling from Babylonia exempt', ['exempt'])
  food_tithe.the_second_tithe({ask:the_house_standing})                  ('the House standing (14:23) — the second tithe eaten only while the House stands, from its juxtaposition with the firstling (the Sifrei 106:4; Temurah 21a:17; KO.the_gifts by CALL): the one who eats it in Jerusalem with no Temple standing barred from it', ['barred_from_it'])
  food_tithe.the_second_tithe({ask:the_liabilities})                     ("the liabilities (14:22) — the yield of your seed, the field, year by year: food, guarded, grown from the ground (the Sifrei 105:1-19; Mishnah Maasrot 1:1 — KO.the_tithe by CALL), the thresholds the pile smoothed (KO 'thresholds'): the one who eats a casual snack before the pile is smoothed exempt"
  food_tithe.the_second_tithe({ask:the_wall_two_capacities})             ("the wall's two capacities (14:23) — within the wall of Jerusalem (the Sifrei 106:3; Mishnah Zevachim 5:8): for eating Torah law, for admission rabbinic (Makkot 20a:7; PN by CALL): the one who eats the second tithe outside the wall lashed", ['lashes'])
  food_tithe.the_second_tithe({ask:the_year_passed})                     ("the year passed (14:23) — 'all the days': no bar from the passing of the year (the Sifrei 106:5; Zevachim 29b:2): the one who brings the second tithe after its year accepted", ['accepted'])
  food_tithe.the_second_tithe({ask:year_by_year})                        ("year by year (14:22) — no tithing from one year's produce for another's (the Sifrei 105:16-19); the tithes' new year Tishri 1 with the first third (Rosh Hashanah 12a:6-9, 12b:9-11 — THE PARAMETER the_tithes_new_year): the one who tithes from the new for the old barred from it", ['barred_from_it'])
