 C between_the_evenings_from = {'value': {'hour': 6.5}, 'settings': {'r_yehoshua_ben_levi': {'hour': 6.5}, 'rava': 'from when the sun begins to decline westward'}, 'channel': 'received', 'source': "Pesachim 58a:3 — Rabbi Yehoshua ben Levi on Exod 29:39 'the one lamb in the morning and the second lamb between the evenings': 'divide it between two evenings — two hours and a half here, two and a half there, and one hour for its doing' (the tamid slaughtered at eight and a half, offered at nine and a half — the Mishnah 58a:1); Rava 58a:5: 'the tamid's command from when the shadows of evening decline — from when the sun begins to go west' (מעידנא דמתחיל שמשא למערב). The ink's six seats of בין הערבים ('between the evenings'): Exod 12:6, 16:12, 29:39, 29:41, 30:8, Lev 23:5", 'teacher': 'Pesachim 58a:3; Pesachim 58a:5', 'exercised_by': []}
 C night_start = {'value': 'the_stars', 'channel': 'received', 'source': "Berakhot 2a:1 (the Mishnah) — the evening Shema 'from the hour the priests enter to eat their terumah' (משעה שהכהנים נכנסים לאכול בתרומתן — the stars' appearance, the impure priest pure at sunset by Lev 22:7); the night's END the dawn's column, 2a:3-4 (עמוד השחר — Rabban Gamliel: 'until the dawn's column rises'; 'all that the sages said until midnight, their command is until the dawn's column rises'). DATA for the slot table's bounds; nothing in the engine counts hours", 'teacher': 'Berakhot 2a:1', 'exercised_by': []}
 C day_boundary = {'value': 'evening', 'channel': 'ink', 'source': "Gen 1:5, 8, 13, 19, 23, 31 — 'and there was evening and there was morning': the day begins at evening. Chullin 83a:15 (the Mishnah): 'one day' said of it-and-its-young (Lev 22:28) — the day follows the night (היום הולך אחר הלילה); ben Zoma derived it from 'one day' at creation (Gen 1:5)", 'teacher': 'Chullin 83a:15', 'open': "OPEN-5 (O9, 2026-09-08; CLOCK.md 12e): the Temple's day is the row temple_day_boundary; 'until the evening' timers run to the next day boundary (day + 1); a timer's opt-in `boundary: morning` orders its fire after the evening-boundary fires of the same day", 'exercised_by': ["the day-grain worlds' 'until the evening' timers"]}
 C twilight_doubt = {'value': 'doubt_of_both_days', 'settings': {'r_yehuda': "from sunset while the east's face reddens (34b:3)", 'r_nechemya': "half a mil's walk from sunset", 'r_yose': 'the blink of an eye — one enters as the other leaves', 'shmuel_measure': 'three quarters of a mil (34b:6)'}, 'channel': 'received', 'source': "Shabbat 34b:2 — 'twilight is a doubt: of the day and of the night, doubtful wholly day, doubtful wholly night — cast it to the stringency of both days' (בין השמשות ספק מן היום ומן הלילה... מטילין אותו לחומר שני ימים); its definition 34b:3, its measure 34b:6; 34b:4 the use: a discharge seen at twilight is doubtful for impurity and for the offering. In the engine's terms the doubt is a BOUND of two days on an event at twilight", 'teacher': 'Shabbat 34b:2', 'open': "UNEXERCISED — no narrated act of the three books stands at twilight (the sun 'about to set' at Gen 15:12 is the day's last slot; 'had set, and it was dark' at 15:17 is the night); the bound of two days awaits a tape that carries one", 'exercised_by': []}
 C the_removal_date = {'era': 'exodus', 'idiom': 'the_removal_date', 'value': {'the_eve': "THE EVE OF THE LAST FESTIVAL DAY OF PASSOVER of the fourth and the seventh year — Mishnah Maaser Sheni 5:6 (the Sifrei 109:1-3: 'at the end of three years' read with 31:10's 'at the end of seven years' by I2, checked in MIDDOT.md — the festival of the eighth year's beginning; 26:12 ahead the confession's seat)", 'the_years': "the fourth and the seventh of the sabbatical count — THE CELL READS THE COUNT'S YEAR FROM THE CYCLE BY CALL (yovel.cycle; yovel.sabbatical; calendar.sabbatical), never a constant; the seventh year exempt from the tithe (109:4; Exodus 23:10-11 through its spine; 15:1 ahead); on the bare world before the entry the count not begun — the cell's verdict 'no count'", 'one_tithe_not_two': "the poor man's tithe REPLACES the second in the third and the sixth year (109:5, 109:10-11; Rosh Hashanah 12b:1-5 — the second year into the third, 'the year of THE tithe'); THE LEVITE NEVER INTERRUPTED (12b:4 — R. Yehuda from 14:29's Levite, R. Eliezer ben Yaakov from the inheritance's juxtaposition)", 'the_uses': "the poor man's tithe's uses BARRED — no debt paid from it, no ransom, no wedding gift, no charity (Tosefta Peah 4:16); the measures at the threshing floor (Mishnah Peah 8:5-6; Tosefta Peah 4:2, 4:8-10 — half a kav (a measure) of wheat, a kav of barley; 'sufficient for his lack' even a horse; the wanderer's loaf)"}, 'boundary': "a clock datum, not a marker — the date rendered by the calendar's own keys (the eve of passover_7) in the count's fourth and seventh year; the count's year by CALL; the removal's confession at 26:12-14 ahead", 'channel': 'received', 'source': 'Deut 14:28-29, 26:12-14, 31:10; Exodus 23:10-11; Mishnah Maaser Sheni 5:6; Mishnah Peah 8:5-6; Tosefta Peah 4:2, 4:8-10, 4:16; the Sifrei on Deuteronomy 109:1-5, 109:10-11; Babylonian Talmud Rosh Hashanah 12b:1-5', 'teacher': 'Mishnah Maaser Sheni 5:6; Rosh Hashanah 12b:1-5', 'exercised_by': ['food_tithe']}
