 C intercalation_grounds = {'value': ['spring_grain', 'tree_fruit', 'season'], 'channel': 'received', 'source': "Sanhedrin 11b:5 — 'the year is intercalated on three grounds: the spring grain, the fruit of the trees, and the season; on two of them they intercalate, on one of them alone they do not'", 'teacher': 'Sanhedrin 11b:5', 'open': "OPEN-2 — the court's grain and fruit observations are not on the tape; the SEASON ground alone is modeled (Sanhedrin 13a:1 on Exod 34:22 'the festival of ingathering at the turn of the year'), labeled modeled in every fraction, never counted as ink", 'exercised_by': ['count']}
