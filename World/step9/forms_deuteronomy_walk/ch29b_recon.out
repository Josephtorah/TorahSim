==== E. THE CALENDAR (the release year, the booths, the appearing — the hakhel's clock words as parameters) ====
 parameters 73 | keys naming release|seventh|year|sukkot|booth|appear|pilgrim|hakhel|assembl|tithe|jubilee|count|shemitta: ['new_years', 'solar_year_days', 'count_start_offset_years', 'jubilee_sanctified_from', 'jubilee_horn_day', 'sabbatical_years', 'cycle_years', 'jubilee_year', 'life_year_reading', 'the_tithes_new_year', 'the_release_date', 'the_firstlings_year', 'window_count_from', 'hidden_years', 'wage_changes_count', 'road_years', 'prison_two_years', 'covenant_pieces_year']
 parameter rows whole (release, sukkot/booths, appearing): [('the_release_date', {'era': 'exodus', 'idiom': 'the_release_date', 'value': {'the_end': "THE YEAR'S END, NOT ITS BEGINNING — the Sifrei 111:1: 'end' is said here and 'end' is said at 31:10's assembly (I2, checked in MIDDOT.md): as there at its end (the festival of Booths after the seventh year), so here; Sheviit 10:1 the seventh year releases at its end; Rosh Hashanah 8b:8-12 the first of Tishri the new year for the sabbatical, Arakhin 28b:7 the release at the year's end (against the jubilee's onset at its new year)", 'the_year': "THE YEAR WHOSE CLASS IS sabbath_of_the_land — yovel.cycle(year) by CALL (the seventh of the count; the jubilee's fiftieth counted to order the sabbaticals, Arakhin 32b:18); ONE CALENDAR FOR THE WHOLE WORLD, never for each debtor (111:3-7 — 'seven years'/'seven years' the analogy the row names in the Hebrew; R. Yose the Galilean's 'draws near' 111:8, 117:4)", 'the_onset': "AFTER THE CONQUEST AND THE DIVISION (111:9-11; 41:3 — fourteen years; Arakhin 32b:10 the count from Joshua's arrival, renewed at Ezra's return); on the bare world before the entry the count is not begun — the cell's verdict 'no count' (as the removal's date at 14:28)", 'the_territory': "IN THE LAND AND OUTSIDE IT — 'because the LORD's release has been proclaimed' (112:11; Kiddushin 38b:1-4 'in any case'); when the jubilee is not in force the money's release stands BY THE SAGES' DECREE in remembrance (Gittin 36a:13-36b:1; Moed Katan 2b:17) — two arms recorded"}, 'boundary': "a clock datum, not a marker — the release's moment the seventh year's last day by the calendar's own count, the year's class read by call; the loan released on the act (Rosh Hashanah 9b:2-3 'even though they did not release')", 'channel': 'received', 'source': 'Deut 15:1-2, 15:9, 31:10; Exodus 23:10-11; Leviticus 25:1-13; Mishnah Sheviit 10:1, 10:8; the Sifrei on Deuteronomy 111:1-11, 112:11; Babylonian Talmud Rosh Hashanah 8b:8-12, 9a:1, 9b:2-3; Arakhin 28b:7, 32b:10-18; Kiddushin 38b:1-4; Gittin 36a:13-36b:1; Moed Katan 2b:17', 'teacher': 'the Sifrei 111:1-11; Rosh Hashanah 8b-9a', 'exercised_by': ['release_firstborn']})]
