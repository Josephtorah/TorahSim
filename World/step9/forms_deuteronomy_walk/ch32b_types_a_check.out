עוֹת חִצַּי אֲכַלֶּה בָּֽם | hunger_beasts_serpents_sword_terror_sent=וְשֶׁן בְּהֵמוֹת אֲשַׁלַּח בָּם עִם חֲמַת זֹחֲלֵי עָפָֽר | blotting_out_stayed_by_the_enemys_boast=לוּלֵי כַּעַס אוֹיֵב אָגוּר פֶּֽן יְנַכְּרוּ צָרֵימוֹ | nation_void_of_counsel=כִּי גוֹי אֹבַד עֵצוֹת הֵמָּה וְאֵין בָּהֶם תְּבוּנָֽה | one_chasing_a_thousand_rock_sold_them=אֵיכָה יִרְדֹּף אֶחָד אֶלֶף וּשְׁנַיִם יָנִיסוּ רְבָבָה | vine_of_sodom_gall_grapes=כִּֽי מִגֶּפֶן סְדֹם גַּפְנָם וּמִשַּׁדְמֹת עֲמֹרָה | vengeance_laid_up_in_store_sealed=הֲלֹא הוּא כָּמֻס עִמָּדִי חָתֻם בְּאוֹצְרֹתָֽי | lord_judges_his_people_repents_himself=כִּֽי יָדִין יְהוָה עַמּוֹ וְעַל עֲבָדָיו יִתְנֶחָם | where_are_their_gods_asked=וְאָמַר אֵי אֱלֹהֵימוֹ צוּר חָסָיוּ בֽוֹ | i_i_am_he_no_god_beside_me=רְאוּ עַתָּה כִּי אֲנִי אֲנִי הוּא וְאֵין אֱלֹהִים עִמָּדִי | i_kill_and_make_alive_none_delivers=אֲנִי אָמִית וַאֲחַיֶּה מָחַצְתִּי וַאֲנִי אֶרְפָּא וְאֵין מִיָּדִי מַצִּֽיל | hand_lifted_to_heaven_live_forever_sworn=כִּֽי אֶשָּׂא אֶל שָׁמַיִם יָדִי וְאָמַרְתִּי חַי אָנֹכִי לְעֹלָֽם | sword_whetted_vengeance_rendered=אִם שַׁנּוֹתִי בְּרַק חַרְבִּי וְתֹאחֵז בְּמִשְׁפָּט יָדִי אָשִׁיב נָקָם לְצָרָי | nations_sing_with_his_people_land_atones=הַרְנִינוּ גוֹיִם עַמּוֹ כִּי דַם עֲבָדָיו יִקּוֹם | song_spoken_in_the_ears_of_the_people=וַיָּבֹא מֹשֶׁה וַיְדַבֵּר אֶת כָּל דִּבְרֵי הַשִּׁירָֽה הַזֹּאת בְּאָזְנֵי הָעָם | hoshea_speaks_the_song_beside_moses=הוּא וְהוֹשֵׁעַ בִּן נֽוּן | set_your_heart_to_these_words_commanded=שִׂימוּ לְבַבְכֶם לְכָל הַדְּבָרִים אֲשֶׁר אָנֹכִי מֵעִיד בָּכֶם הַיּוֹם | it_is_your_life_no_empty_matter=כִּי לֹֽא דָבָר רֵק הוּא מִכֶּם כִּי הוּא חַיֵּיכֶם | go_up_to_nebo_see_the_land_commanded=עֲלֵה אֶל הַר הָעֲבָרִים הַזֶּה הַר נְבוֹ | die_in_the_mountain_gathered_to_your_people_commanded=וּמֻת בָּהָר אֲשֶׁר אַתָּה עֹלֶה שָׁמָּה וְהֵאָסֵף אֶל עַמֶּיךָ | as_aaron_died_in_hor_and_was_gathered=כַּֽאֲשֶׁר מֵת אַהֲרֹן אָחִיךָ בְּהֹר הָהָר וַיֵּאָסֶף אֶל עַמָּֽיו | trespassed_at_meribath_kadesh_not_sanctified=עַל אֲשֶׁר מְעַלְתֶּם בִּי בְּתוֹךְ בְּנֵי יִשְׂרָאֵל בְּמֵֽי מְרִיבַת קָדֵשׁ | see_the_land_from_afar_not_go_there=כִּי מִנֶּגֶד תִּרְאֶה אֶת הָאָרֶץ וְשָׁמָּה לֹא תָבוֹא
