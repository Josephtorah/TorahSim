_put_on_the_enemies=וְנָתַן יְהוָה אֱלֹהֶיךָ אֵת כָּל הָאָלוֹת הָאֵלֶּה עַל אֹיְבֶיךָ | return_and_hearken_and_do_commanded=וְאַתָּה תָשׁוּב וְשָׁמַעְתָּ בְּקוֹל יְהוָה | abounding_in_fruit_of_body_cattle_ground=וְהוֹתִֽירְךָ יְהוָה אֱלֹהֶיךָ בְּכֹל מַעֲשֵׂה יָדֶךָ | rejoiced_over_as_over_the_fathers=כִּי יָשׁוּב יְהוָה לָשׂוּשׂ עָלֶיךָ לְטוֹב | commandment_not_too_hard_nor_far=לֹֽא נִפְלֵאת הִוא מִמְּךָ וְלֹא רְחֹקָה הִֽוא | commandment_not_in_heaven_nor_beyond_the_sea=לֹא בַשָּׁמַיִם הִוא | commandment_in_mouth_and_heart_to_do=כִּֽי קָרוֹב אֵלֶיךָ הַדָּבָר מְאֹד בְּפִיךָ וּבִֽלְבָבְךָ לַעֲשֹׂתֽוֹ | life_and_death_set_before_israel=רְאֵה נָתַתִּי לְפָנֶיךָ הַיּוֹם אֶת הַֽחַיִּים וְאֶת הַטּוֹב וְאֶת הַמָּוֶת וְאֶת הָרָֽע | choose_life_commanded=וּבָֽחַרְתָּ בַּֽחַיִּים לְמַעַן תִּחְיֶה אַתָּה וְזַרְעֶֽךָ | living_and_multiplying_for_hearkening=וְחָיִיתָ וְרָבִיתָ וּבֵֽרַכְךָ יְהוָה אֱלֹהֶיךָ | perishing_for_turning_away=הִגַּדְתִּי לָכֶם הַיּוֹם כִּי אָבֹד תֹּאבֵדוּן | length_of_days_on_the_land_promised=כִּי הוּא חַיֶּיךָ וְאֹרֶךְ יָמֶיךָ | joshua_to_cross_before_israel=יְהוֹשֻׁעַ הוּא עֹבֵר לְפָנֶיךָ כַּאֲשֶׁר דִּבֶּר יְהוָֽה | nations_dispossessed_as_sihon_and_og_promised=וְעָשָׂה יְהוָה לָהֶם כַּאֲשֶׁר עָשָׂה לְסִיחוֹן וּלְעוֹג | be_strong_and_courageous_commanded=חִזְקוּ וְאִמְצוּ אַל תִּֽירְאוּ וְאַל תַּעַרְצוּ מִפְּנֵיהֶם | joshua_charged_to_bring_israel_in=כִּי אַתָּה תָּבוֹא אֶת הָעָם הַזֶּה אֶל הָאָרֶץ | law_written_and_given_to_priests_and_elders=וַיִּכְתֹּב מֹשֶׁה אֶת הַתּוֹרָה הַזֹּאת וַֽיִּתְּנָהּ אֶל הַכֹּהֲנִים בְּנֵי לֵוִי | hakhel_reading_commanded=תִּקְרָא אֶת הַתּוֹרָה הַזֹּאת נֶגֶד כָּל יִשְׂרָאֵל בְּאָזְנֵיהֶֽם | hakhel_assembly_of_all_commanded=הַקְהֵל אֶת הָעָם הָֽאֲנָשִׁים וְהַנָּשִׁים וְהַטַּף וְגֵרְךָ אֲשֶׁר בִּשְׁעָרֶיךָ | hakhel_children_hear_and_learn_commanded=וּבְנֵיהֶם אֲשֶׁר לֹֽא יָדְעוּ יִשְׁמְעוּ וְלָמְדוּ | moses_days_approach_to_die=הֵן קָרְבוּ יָמֶיךָ לָמוּת | joshua_commissioned_to_bring_israel_in=כִּי אַתָּה תָּבִיא אֶת בְּנֵי יִשְׂרָאֵל אֶל הָאָרֶץ אֲשֶׁר נִשְׁבַּעְתִּי לָהֶם | lord_with_joshua_promised=וְאָנֹכִי אֶֽהְיֶה עִמָּֽךְ | moses_to_sleep_with_the_fathers=הִנְּךָ שֹׁכֵב עִם אֲבֹתֶיךָ | future_whoring_after_foreign_gods_foretold=וְקָם הָעָם הַזֶּה וְזָנָה אַחֲרֵי אֱלֹהֵי נֵֽכַר הָאָרֶץ | covenant_breaking_foretold=וַעֲזָבַנִי וְהֵפֵר אֶת בְּרִיתִי אֲשֶׁר כָּרַתִּי אִתּֽוֹ | face_hidden_and_forsaken_foretold=וַעֲזַבְתִּים וְהִסְתַּרְתִּי פָנַי מֵהֶם | evils_and_troubles_befall_foretold=וּמְצָאֻהוּ רָעוֹת רַבּוֹת וְצָרוֹת | song_writing_commanded=וְעַתָּה כִּתְבוּ לָכֶם אֶת הַשִּׁירָה הַזֹּאת | song_taught_and_put_in_mouths_commanded=וְלַמְּדָהּ אֶת בְּנֵי יִשְׂרָאֵל שִׂימָהּ בְּפִיהֶם | song_a_witness_against_israel=לְמַעַן תִּהְיֶה לִּי הַשִּׁירָה הַזֹּאת לְעֵד בִּבְנֵי יִשְׂרָאֵֽל | song_written_and_taught_by_moses=וַיִּכְתֹּב מֹשֶׁה אֶת הַשִּׁירָה הַזֹּאת בַּיּוֹם הַהוּא וַֽיְלַמְּדָהּ אֶת בְּנֵי יִשְׂרָאֵֽל | book_of_the_law_beside_the_ark_commanded=לָקֹחַ אֵת סֵפֶר הַתּוֹרָה הַזֶּה וְשַׂמְתֶּם אֹתוֹ מִצַּד אֲרוֹן בְּרִית יְהוָה אֱלֹהֵיכֶם | book_a_witness_against_israel=וְהָֽיָה שָׁם בְּךָ לְעֵֽד | elders_and_officers_assembled_commanded=הַקְהִילוּ אֵלַי אֶת כָּל זִקְנֵי שִׁבְטֵיכֶם וְשֹׁטְרֵיכֶם | corruption_after_moses_death_foretold=כִּי יָדַעְתִּי אַחֲרֵי מוֹתִי כִּֽי הַשְׁחֵת תַּשְׁחִתוּן | song_spoken_to_the_assembly_to_its_end=וַיְדַבֵּר מֹשֶׁה בְּאָזְנֵי כָּל קְהַל יִשְׂרָאֵל אֶת דִּבְרֵי הַשִּׁירָה הַזֹּאת עַד תֻּמָּֽם
