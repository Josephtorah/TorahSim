THE PARAMETER ROWS: the_readback = 18 rows, 3 holes; not_by_bread_alone = {'the_teaching': "'not by bread alone does man live, but by everything that proceeds from the mouth of the LORD does man live' (8:3) — a TEACHING, not an act: no write", 'the_sifrei': "48:10 (read whole at the reading): 'not by bread alone' = the exposition; 'everything that proceeds from the mouth of the LORD' = the laws and the homilies (R. Shimon ben Menasya)", 'the_shelf': "Yoma 74b:14 — the affliction IN the manna (R. Ami / R. Asi: no bread in the basket for tomorrow / the food not seen as it tastes); 76a:2-3 — the daily manna's reason: the king's one son, 'everyone's heart to their Father in Heaven every day' (8:3's 'to humble you' and 8:16's 'to test you' in the shelf's words); Ketubot 47b 'onata' sustenance from 8:3", 'onkelos': "'not by bread alone is man SUSTAINED, but by everything that PROCEEDS FROM THE WORD (the Memra) OF THE LORD' — the Memra (the Word) at 8:3 and 8:20, the chapter's two", 'the_living': "'man shall live' 8:3 and Ecclesiastes 11:8; 'and live by them' Leviticus 18:5 (sanctions.frame('live_by_them') by CALL — 'live by them, not die by them')"}; the_garment_and_the_foot = {'the_state': "'your garment did not wear out upon you, nor did your foot swell, these forty years' (8:4) — a CONDITION over [40] years, told only here (29:4 'your clothes did not wear out … your shoe upon your foot' the plural, in Moses' last speech; Nehemiah 9:21 'their clothes did not wear out and their feet did not swell' the only other 'did not swell')", 'the_span': "the exodus (1, 1, 15) to the counter's day (40, 11, 1) — the forty years the parser's [40] at 8:2 and 8:4", 'the_scan': [], 'the_scan_words': '\\b(garment|garments|clothing|clothes|cloth|shoe|shoes|sandal|sandals|swell|swelled|swollen|wore out|wear out)\\b', 'the_grade': "SUPPLIED — the readback's FIFTH FORM: no line on the tape, no entry on any ledger, NO retrograde write (a state has no day)", 'the_shelf': "NO ROW on the shelf cites 8:4 (the docket's scan: the ten verses cited by no one — 1, 2, 4, 6, 12, 13, 17-20)", 'onkelos': "'your shoes did not go bare' — the Aramaic reads the shoe where the Hebrew reads the foot (8:4, 29:4)"}; honey_without_milk = {'the_verse': "'a land of olive oil and honey' (8:8) — 'flowing with milk and honey' twenty seats in the Bible, none in the chapter; the honey the FRUIT's (the date's — Berakhot 41b:3 the Day's measure a large date), not the herd's", 'onkelos': "'a land whose olives make oil and which makes honey' — the two supplements"}; the_seven_species_seat = {'the_one_verse': ['Deut 8:8'], 'three_or_more': [('Deut 8:8', 7), ('Hab 3:17', 3), ('Hag 2:19', 4), ('Jer 41:8', 3), ('Joel 1:12', 3), ('Num 20:5', 3)], 'the_two_lands': "'a land' twice in the verse (8:8) — Rav Hamnuna's two 'land's: the date second to the second, the pomegranate fifth to the first (Berakhot 41b:5)", 'the_paradigm': "8:8-10 read as one paradigm for every blessing (35a:15 — 'after the seven species: and you shall eat and be satisfied and bless'), refuted by the first fruits (35a:16); 'a land' (8:9) concluded the matter for the Rabbis — the grace on bread alone (44a:10)"}; the_measures_seat = {'rav_chanan': "the whole verse (8:8) stated for the Torah's MEASURES (Eruvin 4a:11; Sukkah 5b:14; Berakhot 41a:9) — wheat the leprous house's half-loaf, barley the corpse's bone, the vine the nazirite's quarter-log, the fig the Sabbath's carrying, the pomegranate the vessel's hole, 'a land of olive oil' most of whose measures are olives, honey the Day's date (41a:10-41b:3)", 'the_other_amora': 'the measures RABBINIC and the verse a mere support (41b:3)', 'the_rambam': "Introduction to the Mishnah 8:23 (a commentary's row that passed the export's filter, read and marked): 'a law of Moses from Sinai' — the verse a mnemonic, 'not the subject of the verse'"}; the_kings_law_tokens = {'silver_and_gold': "8:13 'and your silver and gold SHALL MULTIPLY' / 17:17 'silver and gold he SHALL NOT MULTIPLY' — the same three tokens (the pair's seven Torah seats)", 'the_heart': "8:14 'and your heart be lifted up' / 17:20 'that his heart be not lifted up' — the lifted heart's seats", 'owed': "the pair's CALL when chapter 17 compiles (the king's law) — OWED FORWARD (COMPILE_DEBT)"}; my_power_my_hand = {'the_boast': "'and you say in your heart: my power and the might of my hand have gotten me this wealth' (8:17 — the phrase's one seat; 'and you say in your heart' 8:17 and Isaiah 49:21; 7:17 'if you say', 9:4 'do not say')", 'the_answer': "'it is he who gives you power to get wealth' (8:18 — one seat; 'to get wealth' Numbers 24:18's and the Psalms' 'does valiantly')", 'the_shelf': "the Sifrei 48:10's reading of 8:3 beside it; Sotah 4b-5a the arrogance's rows", 'onkelos': "'he gives you COUNSEL to acquire possessions' — power made counsel (8:18 and 32:28 the counsel-word); 'wealth' made 'possessions' (8:17, 8:18, 32:15)"}; the_written_read_pair = {'deut_8_2': "'his commandments' (8:2) — WRITTEN without the yod (the DB's x-ketiv, the singular form), READ with it: the store's twenty-fourth token where the DB has twenty-three — the chapter's one mismatch, kept out of every check (the reading's measurement)", 'the_kin': "the same written form at 5:10, 7:9, 27:10 and Numbers 15:31 (the token's five Bible seats)", 'the_shelf': 'Yoma 75b:6 — the quail written with shin and read with samekh (Numbers 11:31): a written/read pair on the shelf; 75b:10 the 248 limbs counted from the defective spelling'}; the_interrogative_he = 'WHETHER you would keep his commandments or not' (8:2) — the interrogative he on a verb, the book's ONE; the two closing tokens 'or not' at seven Bible seats (8:2; Exodus 16:4 the manna's own test clause; Genesis 24:21, 27:21, 37:32; Numbers 11:23; Judges 2:22); the_two_rocks = {'exodus': "Exodus 17:6 'you shall strike THE ROCK (tzur)' — 8:15's word, with the flint (the lemma 6697 at both)", 'numbers': "Numbers 20:8-11 'speak to THE ROCK (sela) … he struck the rock twice' — another word (the lemma 5553); Meribah's six seats (chukat.meribah('meribah_seats') by CALL)", 'the_tape': 'rock_struck at Exod 17:6, rock_struck_twice at Num 20:10 — water_from_the_rock twice on Israel, unmoved', 'onkelos': "'the MIGHTY rock' — the flint made strength"}; the_serve_bow_order = {'the_seats': [('Deut 11:16', ['ועבדתם', 'והשתחויתם']), ('Deut 17:3', ['ויעבד', 'וישתחו']), ('Deut 29:25', ['ויעבדו', 'וישתחוו']), ('Deut 30:17', ['והשתחוית', 'ועבדתם']), ('Deut 4:19', ['והשתחוית', 'ועבדתם']), ('Deut 5:9', ['תשתחוה', 'תעבדם']), ('Deut 8:19', ['ועבדתם', 'והשתחוית']), ('Exod 20:5', ['תשתחוה', 'תעבדם']), ('Exod 23:24', ['תשתחוה', 'תעבדם']), ('Gen 27:29', ['יעבדוך', 'וישתחו', 'וישתחוו'])], 'serve_then_bow': ['Deut 11:16', 'Deut 17:3', 'Deut 29:25', 'Deut 8:19', 'Gen 27:29'], 'the_finding': "the pair's ten Torah seats — serve-then-bow at 8:19, 11:16, 17:3, 29:25; bow-then-serve at 4:19, 30:17, the ten words (5:9, 20:5), 23:24; Jacob's blessing both"}; the_ten_uncited = [1, 2, 4, 6, 12, 13, 17, 18, 19, 20]; the_credits = {'the_numbers_walk': "Yoma 74b-76a's manna rows credited from the Numbers 11 exam (the tastes, the forms, the dew, the daily manna's reason, the sixty cubits); Yoma 75b:14 from the Numbers 33 ledger; 76a:1 from the Numbers 27 ledger; Makkot 13b:12 from the Numbers 15 exam", 'the_chapters': 'Berakhot 20b:4-14 and 21a:8 from the chapter-6 docket; 20b:8-10 from the chapter-5 docket; Sotah 4b:10 and 5a:10 from the chapter-7 docket; Eruvin 96a whole from the chapter-4 docket; Berakhot 5a:1-4, 5a:7 from the chapter-6 docket', 'the_genesis_and_exodus': "Berakhot 42a:8 (Joseph), 43b:8 (Judah), Sotah 4b:14 (Genesis 14), 5a:5 (the 'all' verses), 5a:9 (the bush), 49a:1 (Genesis 17); the kin — the manna Exodus 16, the rock 17:1-7 and Numbers 20, the serpents Numbers 21, the decree 14:26-35, the craving 11 — credited by name at the reading", 'the_count': "101 addresses credited (link 9, topic 92) — the writer's computed count"}; the_grace_conditional = {'the_rule': "Berakhot 49b:3-4 (opened whole) — Shmuel: the New Moon forgotten in the PRAYER is returned for, in the GRACE not; Rav Nachman's reason: the prayer AN OBLIGATION; the grace NOT AN OBLIGATION — 'if he wants he eats, if not, not' — dependent on eating, which is optional", 'the_edge': "49b:5 — on Sabbaths and festivals, where eating is commanded, the omission IS returned for (R. Sheila's 'return to the beginning' after the fourth blessing was begun; Rav Huna's short blessing before it)", 'the_form': "the write bless_after_eating_commanded a STATUS whose trigger is the eating — 8:10's own order 'eat, be satisfied, bless' read by the shelf as a conditional command"}; the_four_blessings = {'the_baraita': "48b:5 — 'and you shall bless' the blessing Who feeds all; 'the LORD your God' the zimmun (the invitation, the Name invoked); 'for the land' the land's; 'good' Who builds Jerusalem (3:25 'this good mountain'); 'that he gave you' Who is good and does good", 'the_tosefta': "Tosefta Berakhot 6:1 — 'eat, be satisfied, bless' the zimmun; 'the LORD your God' the first blessing; 'for the land' the second; 'the good' Jerusalem; 'which he has given you' the fourth", 'rabbi': "48b:6 — 'eat, be satisfied, bless' the food's blessing; the zimmun from Psalm 34:3; 'for the land'; 'good' Jerusalem; the fourth at YAVNE with NO verse; the blessing before from 'that he gave you'", 'the_fourths_standing': "49a:5 — Abba Yosei ben Dostai and the Rabbis: by the Torah as a continuation (no sovereignty), or the Sages' with its own sovereignty; 49a:16-18 the sovereignty's count", 'the_history': "48b:2 — Moses instituted the first blessing WHEN THE MANNA DESCENDED, Joshua the land's at the entry, David and Solomon Jerusalem's, the good and beneficent at Yavne for Beitar's slain: the blessing before its verse — an install-order note for the table (beside THE INSTALL HYPOTHESIS)", 'the_order_and_formula': "48b:3 the order; 48b:13-49a:4 the requirements — the land 'desirable, good and spacious', the covenant, the Torah, David's house; 49a:19-49b:5 the errors' remedies"}; the_blessing_before = {'the_derivations': "the Sifra's 'praises' (Leviticus 19:24 — 35a:2); the a fortiori from the satiated to the hungry (35a:7, 35a:17, 21a:5, 48b:5); the seven species as the paradigm (35a:15); 'which he gave you' (Tosefta 6:2; 48b:6); Exodus 23:25 read 'and YOU shall bless' (48b:7 — ordinances.land('bread_water') by CALL); Saul's blessing of the sacrifice (I Samuel 9:13 — 48b:8)", 'refuted': '35a:3-18 — the clusters, the dough offering, the altar, the first fruits; meat, eggs and fish have no verse; 21a:6 — food gives bodily pleasure, the Torah eternal life; the mishna itself: the impure blesses after, not before', 'the_ground': "35a:18-19 — 'one may not benefit from this world without a blessing' — FOUNDED ON REASON, as misuse of consecrated property; rabbinic (20b:16; 21a:2, 21a:6)"}; the_heart_lifted = {'denial': "Sotah 4b:11 — R. Yochanan: the arrogant DENIES the core belief, from 8:14 'your heart be lifted up and you forget the LORD your God'", 'idolatry': "4b:10 — in R. Shimon ben Yochai's name: as an IDOL WORSHIPPER — 'everyone proud in heart is an ABOMINATION to the LORD' (Proverbs 16:5) with 7:26's 'abomination into your house' (seven_nations.the_images_and_the_devoted by CALL)", 'the_warning': "5a:2-3 — Rav Nachman bar Yitzchak: 8:14 with 8:11 'beware lest you forget' — R. Avin: 'beware, lest, not' nothing but a prohibition", 'the_asherah': "5a:10 — R. Elazar: the arrogant fit to be HEWN DOWN like an Asherah ('hewn down' Isaiah 10:33 / 'hew down' 7:5 — a verbal analogy)", 'the_measure': '5a:16-17 — Rav: a scholar an eighth of an eighth; Rav Nachman bar Yitzchak: none; Rava: excommunicate both', 'the_stomach': "Berakhot 32a:12 — 'filling his stomach is a sin': Rav Sheshet Hosea 13:6, Rav Nachman 8:14, the Rabbis 31:20 — the chain eat → sated → lifted → forgot; 43b:20 the upright posture pushes away the Presence", 'the_king': "17:20 'that his heart be not lifted up' — the king's law by CALL when chapter 17 compiles (OWED)"} (the other settings recorded in DATA)

