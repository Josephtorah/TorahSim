mishpatim_2.grade (fn, oracle, cells) | 8 lines | keys []
   HEAD: def grade(fn, oracle, cells): ok = 0 print('FUNCTION: %s (answer sheet: %s)' % (fn, oracle)) for name, v, want, prov, kind in cells: ok += v == want; TOTAL[kind] += 1 print(' %-36s %-9s [%s] <- %s' % (name, v, 'ok' if v == want else 'MISMATCH', prov)) print(' -> %d/%d\n' % (ok, len(cells))) return ok, len(cells) 
mishpatim.grade (fn, oracle_name, cells) | 10 lines | keys []
   HEAD: def grade(fn, oracle_name, cells): ok = 0 print('FUNCTION: %s (answer sheet: %s)' % (fn, oracle_name)) for name, verdict, want, prov, kind in cells: mark = 'ok' if verdict == want else 'MISMATCH' ok += verdict == want TOTAL[kind] += 1 print(' %-34s %-10s [%s] <- %s' % (name, verdict, mark, prov)) print(' -> %d/%d\n' % (ok, len(cells))) return ok, len(cells) 
mishpatim_3.cell (v, p, why, effects) | 3 lines | keys ['why']
   HEAD: def cell(v, p, why, effects): FX.validate(effects) return {'v': v, 'p': p, 'why': why, 'fx': effects} 
