==== E. THE CALENDAR (the year, the feasts, the third year — clock words as parameters) ====
 parameters 71 | keys naming year|shavuot|weeks|sukkot|booths|passover|pesach|third|seventh|tithe|remov|first|omer|chanukah|release|jubilee|count: ['new_years', 'solar_year_days', 'count_start_offset_years', 'jubilee_sanctified_from', 'jubilee_horn_day', 'sabbatical_years', 'cycle_years', 'jubilee_year', 'life_year_reading', 'the_removal_date', 'the_tithes_new_year', 'the_release_date', 'the_firstlings_year', 'omer_day', 'window_count_from', 'hidden_years', 'wage_changes_count', 'road_years', 'prison_two_years', 'covenant_pieces_year']
 a parameter row whole (the first naming release or tithe): [('the_tithes_new_year', {'era': 'exodus', 'idiom': 'the_tithes_new_year', 'value': {'tishri_1': "THE FIRST OF TISHRI for the tithes — Mishnah Rosh Hashanah 1:1's four new years; Rosh Hashanah 12a:6-9: 'tithes' in the plural — the animal's and the grain's; grain and legumes by the first third, vegetables by the picking (the Sifrei 109:8 — the vegetables' year)", 'the_first_third': "THE FIRST THIRD — produce that reached a third of its growth before Tishri 1 belongs to the year that closed (Rosh Hashanah 12b:9-11; 13a:3 — from 31:10's Sukkot and the festival of gathering; Joshua's omer (the sheaf) 13a:7-13): the tithe's year is the growth's, not the harvest's", 'shevat_15': "THE FIFTEENTH OF SHEVAT for the tree (Mishnah Rosh Hashanah 1:1 — the House of Hillel; the House of Shammai the first of Shevat): the fruit's year by its budding", 'year_by_year': "'year by year' (14:22) — no tithing from one year's produce for another's; THE LIABILITIES — what is food, guarded, grows from the ground (Mishnah Maasrot 1:1), the seasons of liability (1:3, 2:4, 4:5-6); the liability by the house or the courtyard from 14:29's 'in your gates' (Bava Metzia 88a:1-2 — korach.the_tithe('liable_produce') by CALL); no animal tithe now by decree (Bekhorot 53b:5)"}, 'boundary': "a clock datum — the tithes' new year the calendar's key rosh_hashanah; the first third beside it; the tree's the fifteenth of Shevat; the cell reads them, writes no date", 'channel': 'received', 'source': 'Deut 14:22, 14:28-29, 31:10; Mishnah Rosh Hashanah 1:1; Mishnah Maasrot 1:1, 1:3, 2:4, 4:5-6; Babylonian Talmud Rosh Hashanah 12a:6-9, 12b:9-11, 13a:3-13; Bava Metzia 88a:1-2; Bekhorot 53b:5; the Sifrei on Deuteronomy 109:8', 'teacher': 'Rosh Hashanah 12a-13a', 'exercised_by': ['food_tithe']}), ('the_release_date', {'era': 'exodus', 'idiom': 'the_release_date', 'value': {'the_end': "THE YEAR'S END, NOT ITS BEGINNING — the Sifrei 111:1: 'end' is said here and 'end' is said at 31:10's assembly (I2, checked in MIDDOT.md): as there at its end (the festival of Booths after the seventh year), so here; Sheviit 10:1 the seventh year releases at its end; Rosh Hashanah 8b:8-12 the first of Tishri the new year for the sabbatical, Arakhin 28b:7 the release at the year's end (against the jubilee's onset at its new year)", 'the_year': "THE YEAR WHOSE CLASS IS sabbath_of_the_land — yovel.cycle(year) by CALL (the seventh of the count; the jubilee's fiftieth counted to order the sabbaticals, Arakhin 32b:18); ONE CALENDAR FOR THE WHOLE WORLD, never for each debtor (111:3-7 — 'seven years'/'seven years' the analogy the row names in the Hebrew; R. Yose the Galilean's 'draws near' 111:8, 117:4)", 'the_onset': "AFTER THE CONQUEST AND THE DIVISION (111:9-11; 41:3 — fourteen years; Arakhin 32b:10 the count from Joshua's arrival, renewed at Ezra's return); on the bare world before the entry the count is not begun — the cell's verdict 'no count' (as the removal's date at 14:28)", 'the_territory': "IN THE LAND AND OUTSIDE IT — 'because the LORD's release has been proclaimed' (112:11; Kiddushin 38b:1-4 'in any case'); when the jubilee is not in force the money's release stands BY THE SAGES' DECREE in remembrance (Gittin 36a:13-36b:1; Moed Katan 2b:17) — two arms recorded"}, 'boundary': "a clock datum, not a marker — the release's moment the seventh year's last day by the calendar's own count, the year's class read by call; the loan released on the act (Rosh Hashanah 9b:2-3 'even though they did not release')", 'channel': 'received', 'source': 'Deut 15:1-2, 15:9, 31:10; Exodus 23:10-11; Leviticus 25:1-13; Mishnah Sheviit 10:1, 10:8; the Sifrei on Deuteronomy 111:1-11, 112:11; Babylonian Talmud Rosh Hashanah 8b:8-12, 9a:1, 9b:2-3; Arakhin 28b:7, 32b:10-18; Kiddushin 38b:1-4; Gittin 36a:13-36b:1; Moed Katan 2b:17', 'teacher': 'the Sifrei 111:1-11; Rosh Hashanah 8b-9a', 'exercised_by': ['release_firstborn']})]
