FACT PN.the_profane_slaughter_the_blood_and_the_gates(the_levites_scope) = ("the Levite's scope (12:19) — 'all your days' even in sabbaticals and jubilees (the Sifrei 74:8), 'on your land' not in the exile (74:9): the one who forsakes the Levite in the exile exempt", ['exempt'])
FACT PN.the_profane_slaughter_the_blood_and_the_gates(the_blemished_consecrated) = ("the blemished consecrated (12:15) — the consecration before the blemish 'only the permission of consumption' (Mishnah Bekhorot 2:2-3; Bekhorot 15b:9-12): 12:15's release read on the redeemed animal; the firstborn and the gifts excluded by 'as the gazelle and the hart' (15a:6-8): the one who slaughters the redeemed blemished consecrated accepted — consumption alone", ['accepted'])
FACT PN.the_nations_cut_off_and_the_abomination(lest_you_inquire_after_their_gods) = ("lest you inquire after their gods (12:30) — the inquiry itself barred, 'how did these nations serve?' (the Sifrei 81:2-4); 23:24's 'not after their deeds' (OR.land by CALL): THE WRITE foreign_rite_inquiry_barred — a BLOCK on Israel at the chapter's own day (THE LINE nations_cut_off_warned); the readback row SUPPLIED AS A LAW with its write", ['foreign_rite_inquiry_barred'])
FACT PN.the_nations_cut_off_and_the_abomination(their_sons_and_their_daughters) = ("their sons and their daughters (12:31) — 'even' includes the parents (the Sifrei 81:6); the children in the fire the Molech's kin; the persecution's edges (Sanhedrin 74b:1-9 — the limb of a living animal among the seven): the one who burns his son accepted against", ['accepted'])
FACT PN.the_nations_cut_off_and_the_abomination(no_molech_named) = ("no Molech named (12:31) — the children in the fire without the king-word; Leviticus 18:21 and 20:2-5's Molech the kin (SA.molech('seed_scope', 'family', 'predicate') by CALL — the seed's scope, the family's affliction, the passing liable); the homograph named, not counted: the one who passes his son to Molech accepted against by the kin's cell", ['accepted'])
FACT SN.the_images_and_the_devoted(abomination_to_the_lord) = ("an abomination to the LORD (7:25) — the book's phrase at its first seat; the idol an abomination from its making (Avodah Zarah 52a): a DATA row", ['accepted'])
FACT SN.the_images_and_the_devoted(utterly_detest) = ("utterly detest (7:26) — Leviticus 11:43's verb on the idol: the impurity of the idol's stones as a creeping animal's (Avodah Zarah 47b; SH by CALL); the Sifrei 61:7's renaming", ['accepted'])
FACT CH.the_voice_and_the_request(the_request) = ("the request (5:24-27) — SUPPLIED: the tape's second hole written once at its own time; the mediator asked for (Makkot 24a)", ['accepted'])
FACT CH.the_voice_and_the_request(hear_and_do) = ("hear and do (5:27) — TURNED against 24:7's 'do and hear' (Shabbat 88a); Onkelos 'accept and do'", ['accepted'])
FACT CH.the_voice_and_the_request(added_no_more) = ("added no more (5:22) — 2b's ten words and tablets FOUND (OH by CALL); 'did not cease' the Talmud's and Onkelos's reading", ['accepted'])
FACT CH.the_voice_and_the_request(you_came_near) = ("you came near (5:23) — 1:22's phrase at its second seat: the mob and the elders (OS by CALL; the Sifrei 20:1)", ['accepted'])
FACT CH.the_second_word(no_other_gods) = ("no other gods before me (5:7) — the second word's head, compiled here: the block other_gods_barred on Israel at the giving's line", ['accepted'])
