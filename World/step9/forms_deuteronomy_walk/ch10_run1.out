THE PARAMETER ROWS: the_readback = 25 rows, 1 holes, 1 open rows; the_clock_read_back = {'second_ascent': (1, 5, 29), 'second_tablets': (1, 7, 10), 'third_forty': 40, 'erected': (2, 1, 1), 'aaron_death': (40, 5, 1), 'hor_arrival': (40, 4, 1), 'hor_to_death': 29, 'counter': (40, 11, 1), 'av_days': 30, 'from_29_av_to_10_tishri': 40, 'seder_olam_6_2': (1, 5, 29)}; the_two_arks = {'the_bavli': "ONE — 'the ark of the covenant that Moses fashioned: its length two cubits and a half, its width a cubit and a half, its height a cubit and a half' (Bava Batra 14a:8 — Exodus 25:10's cubits given to the ark 'that Moses fashioned'); Yoma 3b:3 'make you an ark of wood' (10:1) / 'they shall make an ark' (25:10); 72b:8 'Bezalel made' — the command Moses', the hands Bezalel's", 'the_tosefta': "TWO — R. Yehuda ben Lakish: two arks went with Israel in the wilderness — the one with the Torah scroll went out to war ('the ark of the covenant of the LORD went before them', Numbers 10:33), the one with the fragments of the tablets rested in the camp ('the ark of the covenant of the LORD and Moses did not depart from the camp', 14:44) — Tosefta Sotah 7:9 (read whole; the Vilna division's fifteen rows of chapter 7)", 'the_decision': "decision (1) STANDS — the tape's the_ark one id, the Bavli's reading; the Tosefta's arm a DISPUTE row and the exam's row", 'the_registrys_homograph': "one id for the flood's tevah and the sanctuary's aron — rested_on_ararat on the_ark's ledger beside ark_spec and ark_built (the map 'the-ark' → the_ark): two Hebrew words on one English id; a split owed to a gate sitting on the owner's word, no change here"}; the_arks_contents_two_arms = {'r_meir': 'the cubit SIX handbreadths — the ark 15 × 9 × 9 inside; the two tablets 6 × 6 × 3 laid along the length twelve, three left: half a handbreadth for each wall, TWO HANDBREADTHS FOR THE TORAH SCROLL INSIDE (Bava Batra 14a:12-13)', 'r_yehuda': "the cubit FIVE — 12.5 × 7.5 × 7.5; the tablets twelve of the twelve and a half, the silver columns inside; THE SCROLL BESIDE the ark on the Philistines' chest (1 Samuel 6:8 — 14a:14-14b:1); 31:26's 'beside the ark' the ink's own", 'the_agreed': "the tablets AND the fragments of the tablets rest in the ark — Rav Yosef's baraita on 10:1-2 'them' (14b:6; Menachot 99a:12), Rav Huna's 2 Samuel 6:2 (14b:4), R. Yehuda's 1 Kings 8:9 (E4, 14a:10)", 'the_tablets': "6 × 6 × 3 handbreadths (Nedarim 38a:8 — 7b's DATA row); SB.ark('dimensions') = (2.5, 1.5, 1.5)"}; the_stations_reversed = {'numbers': "33:30-34 — Moseroth, Bene-jaakan, Hor-haggidgad, Jotbathah (then Abronah, Ezion-geber, Kadesh, Mount Hor: Moseroth SEVEN camps before Hor — JO.the_stations('moseroth_seven'))", 'deuteronomy': "10:6-7 — Beeroth-bene-jaakan, Moserah (the death), Gudgodah, Jotbathah 'a land of brooks of water'", 'the_diff': "one token shared with 33:31; Gudgod for Hor-haggidgad (no token shared); the brooks added (8:7's phrase — the two seats); the station's three tokens one lemma on the DB (the store's split name)", 'the_reconciliation': 'the retreat of seven stations (Seder Olam Rabbah 9:2) — the parameter on file at journeys and chukat'}; the_place_of_the_death = {'name': 'the place of the death', 'verses': 'Deut 10:6; Num 20:22-29, 33:30-39', 'the_tape': "Mount Hor — journeyed_to_mount_hor (Num 20:22, M['hor_arrival'] (40, 4, 1)), garments_transferred_and_aaron_died (20:28, M['aaron_death'] (40, 5, 1) from 33:38's ordinals), aaron_mourned_thirty_days (20:29)", 'the_shelf': "Moserah — 'there Aaron died' (10:6) after Beeroth-bene-jaakan (the stations reversed against 33:30-31); Seder Olam Rabbah 9:2 (READ WHOLE at the docket): after the king of Arad came they RETREATED SEVEN STATIONS until Moserah and mourned him there as if he had died there — journeys.DATA['the_deuteronomy_order'] = the_retreat_of_seven_stations, chukat.DATA['moserah'] = the_retreat_of_seven_stations (the parameter already on file)", 'the_decision': "OPEN — a disagreement is an OPEN row, never a second act (the