        ask = case['ask']
        if ask == 'with_joy':
            ink('18:8', '"and the LORD spoke to Aaron: and I, behold, I have given you" — the LORD to Aaron; 17:5\'s "to him" the frame 

  korach.the_gifts({ask:ass_redeem_or_break})                ('redeem with a lamb, else break the neck', ['redeem_or_break'])
  korach.the_gifts({ask:betrothed_eats})                     ('the a-fortiori: she eats (R. Yochanan b. Bag Bag); THE DECREE: not until the canopy (Mishnah Ketubot 5:3 — the later court; Ketubot 57b-58a: the cup and the simpon) — the decree over the a-fortiori', ['stranger_barred'])
  korach.the_gifts({ask:bikkurim})                           ('the first fruits of all — holy while attached (18:13; Sifrei 117:2); partners liable, outside the land exempt (Chullin 136a); roofs and ships (Menachot 84b); the household eats (84b:10)', ['due_to_priest'])
  korach.the_gifts({ask:bikkurim_eaters})                    ('the household eats the first fruits — the verse read as two (Menachot 84b:10)', ['terumah_fed'])
  korach.the_gifts({ask:bikkurim_partners})                  ('first fruits from land in partnership — liable; outside the land exempt (Chullin 136a)', ['due_to_priest'])
  korach.the_gifts({ask:bikkurim_scope})                     ('the first fruits of all — roofs, ruins, flowerpots and ships; the two loaves precede (Menachot 84b)', ['due_to_priest'])
  korach.the_gifts({ask:blemish_expert})                     ("the court's expert exempt, a non-expert pays (Mishnah Bekhorot 4:4); a paid examiner disqualified unless like Ila (4:5); shown after slaughter — R. Yehuda / R. Meir (4:3)", ['—'])
  korach.the_gifts({ask:blemished_firstborn})                ('to the priest — it shall be yours repeated (Zevachim 37b); raised thirty or fifty days (Mishnah Bekhorot 4:1); kept the year (4:2); the expert (4:4-5)', ['due_to_priest'])
  korach.the_gifts({ask:blemished_keeping})                  ('a blemish within the year — kept the twelve months; after the year — thirty days (Mishnah Bekhorot 4:2)', ['—'])
  korach.the_gifts({ask:breast_and_thigh})                   ('breast and thigh to the priests after the smoking (tzav CALLED); the terumah of their gift, all the wave offerings (18:11)', ['due_to_priest'])
  korach.the_gifts({ask:clean_firstborn})                    ('the firstborn of an ox, a sheep, a goat you shall not redeem — they are holy (18:17); an ox and its firstborn an ox (Bekhorot 5b); no hybrid (Sifrei 118:1)', ['consecrated'])
  korach.the_gifts({ask:covenant_of_salt})                   ("a covenant of salt — Aaron's (18:19) and David's (2 Chr 13:5) alone; salting indispensable (Menachot 19b-20a); from communal supplies (Menachot 21b); Aaron's greater than David's (Sifrei 119:5)", ['covenant_of_salt'])
  korach.the_gifts({ask:covenant_reason})                    ("the covenant written because Korach contested — the king's retainer (Sifrei 117:2); for Aaron's good did Korach come (119:2)", ['—'])
  korach.the_gifts({ask:devote_firstborn})                   ("the firstborn, whole or blemished, may be devoted — assessed by the daughter's son (Mishnah Arakhin 8:7; temurah CALLED: may_be_devoted)", ['—'])
  korach.the_gifts({ask:devoted})                            ("every devoted thing in Israel — gentiles', women's, bondsmen's too (Sifrei 117:3); unspecified: priests_Sages_upkeep_R._Yehuda_b._Beteira (temurah CALLED) — the four-way dispute: R. Yossi HaGelili the priests, R. Yehudah b. Beteira Temple
  korach.the_gifts({ask:devoted_status})                     ("in the owner's house consecrated; given to the priest common (Arakhin 29a; Bekhorot 32a); to the priest of the watch serving (Arakhin 28b)", ['due_to_priest'])
  korach.the_gifts({ask:devoted_to_whom})                    ('to the priest of the watch serving in the Temple — to the priest / to the priest with 5:8 (Arakhin 28b)', ['due_to_priest'])
  korach.the_gifts({ask:devotion_by_priests})                ('R. Yehuda: priests and Levites may not; R. Shimon: priests not, Levites may (Mishnah Arakhin 8:5)', ['—'])
  korach.the_gifts({ask:donkey_doubt})                       ('the burden of proof on the priest — a male and a female, the owner keeps the lamb; two males, one lamb (Mishnah Bekhorot 1:3)', ['—'])
  korach.the_gifts({ask:doubtful_terumah_watch})             ('R. Yehoshua: safeguard only the pure; R. Eliezer: the doubtful too (Bekhorot 34a)', ['—'])
  korach.the_gifts({ask:eaten_in_greatness})                 ('for anointing = for greatness — eaten as kings eat, roasted with mustard, any manner (Onkelos cited at Zevachim 91a; Chullin 132b; Sotah 15a)', ['due_to_priest'])
  korach.the_gifts({ask:every_male})                         ("every male — communal peace offerings eaten by the priests' males (Menachot 83a; Zevachim 97b)", ['—'])
  korach.the_gifts({ask:firstborn_blood_mixed})              ("they are holy — the blood mixed with others' still sacrificed (Zevachim 81a; Temurah 5b)", ['—'])
  korach.the_gifts({ask:firstborn_blood_placement})          ("one placement on the base — their blood, their fat: the tithe and the Passover too (R. Yosei HaGelili; Zevachim 56b; Mishnah Zevachim 5:8; Sifrei 118:1's one spilling)", ['consecrated'])
  korach.the_gifts({ask:firstborn_eaters})                   ('Beit Shammai: priests only, not menstruating women; Beit Hillel: the blemished to any (Bekhorot 32b-33a)', ['—'])
  korach.the_gifts({ask:firstborn_eating_window})            ("two days and a night — as the wave-breast and the right thigh (18:18; Bekhorot 27b; Zevachim 57a; Mishnah Zevachim 5:8) — the peace offering's row CALLED", ['due_to_priest'])
  korach.the_gifts({ask:firstborn_for_redemption})           ("opens a Jewish mother's womb (Mishnah Bekhorot 8:1); the caesarean — neither (8:2; pesach CALLED: not consecrated)", ['—'])
  korach.the_gifts({ask:firstborn_portions})                 ('their blood, their fat — the tithe and the Passover placed like the firstborn (R. Yosei HaGelili; Zevachim 37a, 56b; Pesachim 64b); R. Yishmael from Deut 12:27; the portions burned (Keritot 4a)', ['consecrated'])
  korach.the_gifts({ask:firstborn_resembles})                ('the head and the majority of the body like the mother (Bekhorot 7a); resembling another species — no firstborn (Bekhorot 12a; Bava Kamma 78a)', ['—'])
  korach.the_gifts({ask:firstborn_sale})                     ('not redeemed, but sold — alive unblemished, blemished alive or slaughtered; the tithe neither (Bava Kamma 13a; Bekhorot 31b; Temurah 5b, 8a)', ['—'])
  korach.the_gifts({ask:firstborn_substitute})               ('they are holy — they, not their substitutes (Temurah 21a; Zevachim 37b)', ['—'])
  korach.the_gifts({ask:firstborn_without_altar})            ('the flesh as the blood — eaten only while the altar stands (Makkot 19a; Temurah 21a; Zevachim 60b)', ['—'])
  korach.the_gifts({ask:five_sela_coinage})                  ('the five sela in the Tyrian maneh (Mishnah Bekhorot 8:7; Bekhorot 49b)', ['pays'])
  korach.the_gifts({ask:from_the_fire})                      ("the olah's hide — the most holy from the fire (Sifrei 117:2)", ['due_to_priest'])
  korach.the_gifts({ask:gentile_consecrations})              ("of all the hallowed things of the children of Israel — not gentiles': no misuse (Temurah 3a)", ['—'])
  korach.the_gifts({ask:household})                          ('every clean one in your house — the household (priesthood CALLED); to your daughters', ['terumah_fed'])
  korach.the_gifts({ask:impure_terumah_benefit})             ('My terumot — two: the impure burned with benefit beneath the dish, from the separation onward (Shabbat 25a-26a; Yevamot 74a)', ['—'])
  korach.the_gifts({ask:levite_donkey})                      ('exempt — a priest or a Levite (the son and the donkey)', ['exempt'])
  korach.the_gifts({ask:most_holy_eating_place})             ('in the most holy place — the courtyard; inside the Sanctuary when gentiles surround it (Zevachim 63a; Menachot 9a)', ['—'])
  korach.the_gifts({ask:most_holy_list})                     ("every offering, every meal offering, every sin offering, every guilt offering (18:9) — the four everys include the omer's, the suspected wife's, the bird olah's meat, the leper's log (Menachot 73a; Zevachim 44b)", ['due_to_priest'])
  korach.the_gifts({ask:most_holy_portion_use})              ('R. Yehuda: betrothed with it; R. Yosei: consumption alone (Kiddushin 52b)', ['—'])
  korach.the_gifts({ask:opens_the_womb})                     ("all that opens the womb — which they offer excludes the unclean animal, and in beast re-includes the blemished (Sifrei 118:1); the Levites' ass exempt", ['consecrated_firstborn'])
  korach.the_gifts({ask:raise_before_giving})                ("30 days a small animal, 50 a large (Mishnah Bekhorot 4:1; Bekhorot 26b — Exod 22:29 juxtaposed to 18:16's month)", ['—'])
  korach.the_gifts({ask:redeeming_lamb})                     ('any lamb — sheep or goat, any age, blemished; not a calf, a hybrid or a koy (Mishnah Bekhorot 1:4-5); the designated lamb died — R. Eliezer / the Rabbis (1:6)', ['—'])
  korach.the_gifts({ask:redemption_before_thirty})           ('after thirty days — from a month old (18:16 / 3:40; Bekhorot 49a; Bamidbar CALLED: after thirty days); mauled within thirty — no redemption (Bava Kamma 11b); the thirtieth day like the day before (Mishnah Bekhorot 8:6)', ['pays'])
  korach.the_gifts({ask:redemption_means})                   ("redeemed when in the priest's hand (Bamidbar CALLED); not with slaves, notes, land or consecrated items (Mishnah Bekhorot 8:8); movable, not writs (Sifrei 118:1 — Rebbi: writs only)", ['pays'])
  korach.the_gifts({ask:redemption_money_lost})              ('the father liable — shall be yours before you shall redeem (Mishnah Bekhorot 8:8; Bekhorot 51a)', ['pays'])
  korach.the_gifts({ask:redemption_rate})                    ("five shekels per skull; twenty gerah the shekel (the sela of twenty ma'ah)", ['pays'])
  korach.the_gifts({ask:redemption_timing})                  ('thirty days the son, at once the ass (Bekhorot 12b-13a; Sifrei 118:1 — immediately or after a month)', ['pays'])
  korach.the_gifts({ask:returned})                           ("which they return to Me — the proselyte's theft (5:8; Sifrei 117:2; Bava Kamma 110a)", ['due_to_priest'])
  korach.the_gifts({ask:salt_source})                        ('the salt from communal supplies — everlasting covenant / everlasting covenant with the showbread (Menachot 21b)', ['—'])
  korach.the_gifts({ask:self_redemption})                    ('redeem, you shall redeem — the son redeems himself if the father did not (Kiddushin 29a; Sifrei 118:1 Kerem Beyavneh)', ['pays'])
  korach.the_gifts({ask:suspect_firstborn})                  ('no meat nor untanned hides from one suspect on firstborns (Mishnah Bekhorot 4:7); may neither judge nor testify on it (4:10)', ['—'])
  korach.the_gifts({ask:suspect_principle})                  ('suspect on the sabbatical year not on tithes, nor the reverse; suspect on either — on purities; neither judge nor witness on that matter (Mishnah Bekhorot 4:10)', ['—'])
  korach.the_gifts({ask:the_best_triad})                     ("the best of the oil, the wine and the grain (18:12) — Izhar's word; the triad reversed against eleven seats (computed); kind for kind: each type its first (Bekhorot 53b, 54b)", ['—'])
  korach.the_gifts({ask:three_crowns})                       ('three crowns — Torah, priesthood, kingdom; the good name above them (Avot 4:13; Sifrei 119:4)', ['—'])
  korach.the_gifts({ask:twenty_four})                        ('24 — twelve in the sanctuary, twelve in the borders (Sifrei 119:1-2; Chullin 133b; Bava Kamma 110b); a generalization, a detail and a covenant of salt', ['priestly_dues_granted'])
  korach.the_gifts({ask:twenty_gerah_floor})                 ("twenty gerah — more, not less (Sifrei 118:1; Bekhorot 50a); the seat among the shekel engine's five: Num 18:16", ['pays'])
  korach.the_gifts({ask:twins})                              ('twins — five sela after thirty days; one died — exempt; two wives — ten; the intermingled by certainty (Mishnah Bekhorot 8:3-5)', ['pays'])
  korach.the_gifts({ask:unclean_firstborn_scope})            ('the ass alone (Sifrei 118:1; Bekhorot 5b) — redeem with a lamb, else break the neck (pesach CALLED)', ['redeem_or_break'])
  korach.the_gifts({ask:with_joy})                           ("and I, behold — with joy (Sifrei 117:1); through Moses by 17:5's to him", ['—'])
==== cold_run_korach.the_tithe sig ('case', 'data') (18916 chars) asks-in-source ['agent', 'agent_gentile', 'as_wages', 'bought_from_gentile', 'confession', 'estimate', 'every_place', 'exclusion_table', 'from_it', 'gentile_tithe', 'household_deputes', 'impure_for_pure', 'inferior_for_superior', 'israelite_benefit_from_terumah', 'kind_for_kind', 'levite_he', 'levite_preceded', 'liable_produce', 'mourner', 'no_inheritance', 'one_in_a_hundred', 'partners', 'pointer_paid', 'recipients', 'removal', 'so_you_too', 'terumah_measure', 'terumah_status', 'the_best', 'third_year', 'thresholds', 'tithe_of_the_tithe', 'tithe_recipient', 'tithe_terumah_betrothal', 'tithe_to_foreigners', 'tithe_to_levites', 'wage', 'what_remains_common', 'who_separates', 'who_separates_tithe_terumah', 'wrong_order', 'you_shall_not_die']
def the_tithe(case, data):
        del P[:]
        ask = case['ask']
        if ask == 'no_inheritance':
            ink('18:20', '"in their land you shall not inherit, and you shall have no portion among them; I am your portion and yo

  korach.the_tithe({ask:agent})                              ("you also — an agent, with the owner's knowledge; by the owner's mind, else 1/50; not partners, sharecroppers, stewards; a gentile no (Bava Metzia 22a, 71b; Kiddushin 41b; Gittin 23b, 52a; Mishnah Terumot 4:4)", ['—'])
  korach.the_tithe({ask:agent_gentile})                      ('a gentile cannot separate terumah even as an agent — members of the covenant (Bava Metzia 71b; Gittin 23b)', ['—'])
  korach.the_tithe({ask:as_wages})                           ('forbidden, desecrated — that you shall not die (Bekhorot 26b)', ['—'])
  korach.the_tithe({ask:bought_from_gentile})                ("bought from a gentile in smoothed piles — exempt from the tithe's terumah (Bekhorot 11b)", ['—'])
  korach.the_tithe({ask:confession})                         ("given to the Levite = the first tithe; also given = terumah and the tithe's terumah (Mishnah Ma'aser Sheni 5:10-11); Deut 26's run", ['—'])
  korach.the_tithe({ask:estimate})                           ("by estimate and by thought — your terumah plural, two terumot (Abba Elazar ben Gomel: Beitzah 13b; Bekhorot 58b-59a; Sifrei 121:1); never by measure (Mishnah Terumot 1:7); the tithes too (18:24's terumah)", ['—'])
  korach.the_tithe({ask:every_place})                        ("in every place — even a cemetery (Sifrei 122:1; Yevamot 86b — R. Akiva: excludes the priest); Deut 12:13's ban the Torah twin", ['—'])
  korach.the_tithe({ask:exclusion_table})                    ("priests (18:20), Levites (18:23), bondsmen and proselytes (26:55), the two of uncertain sex (26:54) — Sifrei 119:1; R. Meir: priests and Levites do not confess (Mishnah Ma'aser Sheni 5:14)", ['inheritance_barred'])
  korach.the_tithe({ask:from_it})                            ('from it — kind for its kind, rooted for rooted, new for new, not across the border (Sifrei 120:1; Mishnah Terumot 1:5); not the tithed tithe, not the exempt for the liable', ['—'])
  korach.the_tithe({ask:gentile_tithe})                      ("the tithe of the children of Israel — not gentiles' (Temurah 3a; Zevachim 45a); bought from a gentile in piles — exempt from the tithe's terumah (Bekhorot 11b)", ['—'])
  korach.the_tithe({ask:household_deputes})                  ('you and your household — the Israelite wife of a Levite may depute the separation (18:31; Yevamot 86a; Sifrei 122:1)', ['—'])
  korach.the_tithe({ask:impure_for_pure})                    ('not impure for pure — unwitting valid, intentional nothing (Mishnah Terumot 2:2); terumah by Torah law, the Sages penalized (Yevamot 89b)', ['—'])
  korach.the_tithe({ask:inferior_for_superior})              ('valid terumah, a transgression that takes effect — you shall bear no sin (18:32; R. Ilai: Bava Batra 84b, 143a; Bava Metzia 56a; Kiddushin 46b; Temurah 5a); the impure for the pure likewise, penalized (Yevamot 89b; Terumot 2:2)', ['due_to
  korach.the_tithe({ask:israelite_benefit_from_terumah})     ('your terumah — an Israelite may benefit (Pesachim 23a)', ['—'])
  korach.the_tithe({ask:kind_for_kind})                      ('not one kind for another — not terumah (Mishnah Terumot 2:4; Bekhorot 53b); the first part of them — each type its own (Bekhorot 54b; Temurah 5a)', ['—'])
  korach.the_tithe({ask:levite_he})                          ('the Levite — he: perforce, in sabbatical and jubilee years, no priest in his stead (Sifrei 119:5)', ['—'])
  korach.the_tithe({ask:levite_preceded})                    ("on the stalks — the tithe's terumah only; after the pile — the great terumah too (Berakhot 47a-b; Beitzah 13b; Eruvin 31b; Pesachim 35b; Shabbat 127b)", ['due_to_priest'])
  korach.the_tithe({ask:liable_produce})                     ("food, guarded, grown from the land (Mishnah Ma'aserot 1:1); the ripening signs (1:2-4)", ['—'])
  korach.the_tithe({ask:mourner})                            ("from it free for the mourner — the tithe and the paschal lamb (Sifrei 120:1; Pesachim 36a; Yevamot 73b); Mishnah Ma'aser Sheni 5:12", ['—'])
  korach.the_tithe({ask:no_inheritance})                     ('in their land you shall not inherit — I am your portion (18:20; Onkelos: the gifts I have given you); the Levites no inheritance (18:23-24); Deut 10:9, 18:2, Josh 13:14, Ezek 44:28', ['inheritance_barred'])
  korach.the_tithe({ask:one_in_a_hundred})                   ('neutralized in a hundred and one (Sifrei 121:1; Mishnah Terumot 4:7; Challah 1:9) — holiness_b CALLED: 101', ['—'])
  korach.the_tithe({ask:partners})                           ('partners liable — all your tithes (Chullin 136a); with a gentile exempt', ['—'])
  korach.the_tithe({ask:pointer_paid})                       ("15:20's as the terumah of the threshing floor is paid at 18:27's reckoned as the grain of the threshing floor (computed on the floor-word); the challah cell's as_terumah CALLS this cell", ['—'])
  korach.the_tithe({ask:recipients})                         ("the Levite, the priest (the tithe's terumah), the poor — Rabban Gamliel's ship (Mishnah Ma'aser Sheni 5:9)", ['—'])
  korach.the_tithe({ask:removal})                            ("the removal on Passover eve of the fourth and seventh years — the first tithe to the Levite (Mishnah Ma'aser Sheni 5:6); the recipients by office: Joshua the Levite, Elazar ben Azariah the priest (5:9)", ['—'])
  korach.the_tithe({ask:so_you_too})                         ('so you too — the priests separate too (Sifrei 121:1); the three a-fortioris', ['—'])
  korach.the_tithe({ask:terumah_measure})                    ("1/40, 1/50, 1/60 (Beit Shammai 1/30 — Mishnah Terumot 4:3); the floor: some must remain common (4:5 — naso's cell CALLED)", ['due_to_priest'])
  korach.the_tithe({ask:terumah_status})                     ("death and a fifth, forbidden to non-priests, the priest's property, nullified in a hundred and one, the hands, sunset, from the near and finished (Mishnah Challah 1:9)", ['due_to_priest'])
  korach.the_tithe({ask:the_best})                           ('from all its best (18:29-30, 18:32) — where a priest is, the best; where none, what lasts; the superior for the inferior, not the reverse (Mishnah Terumot 2:4, 2:6); a warning to take the choicest (Sifrei 122:1)', ['—'])
  korach.the_tithe({ask:third_year})                         ('the first tithe every year — juxtaposed to an inheritance (Rosh Hashanah 12b; Sifrei 119:5)', ['—'])
