  korach.the_tithe({ask:tithe_of_the_tithe})                 ('1/100 — a tenth of the tenth (18:26; Menachot 54b; Neh 10:39)', ['terumah_of_the_tithe_owed'])
  korach.the_tithe({ask:tithe_recipient})                    ("the Levite (18:21, 18:26 — R. Akiva); the priest too — Ezra's penalty / the priests called Levites (R. Eliezer; Yevamot 86a-b)", ['tithe_granted'])
  korach.the_tithe({ask:tithe_terumah_betrothal})            ("betrothal with the tithe's terumah valid — no to the LORD written of it (Kiddushin 53a)", ['—'])
  korach.the_tithe({ask:tithe_to_foreigners})                ('R. Meir: forbidden to non-Levites as terumah; the Rabbis permit (Yevamot 86a)', ['—'])
  korach.the_tithe({ask:tithe_to_levites})                   ('all the tithe in Israel — in exchange for their service (18:21): the Levite serves, the Levite takes; a Levite who refused one service has no portion (Sifrei 119:5, 122:1)', ['tithe_granted'])
  korach.the_tithe({ask:wage})                               ('it is your wage in exchange for your service (18:31); terumah or tithe not given as wages to the assisting priests, Levites or poor (Bekhorot 26b)', ['tithe_granted'])
  korach.the_tithe({ask:what_remains_common})                ("what remains is common, as the floor's grain after terumah (18:30; Sifrei 122:1)", ['—'])
  korach.the_tithe({ask:who_separates})                      ('not the deaf-mute, the imbecile, the minor, from what is not his, a gentile (Mishnah Terumot 1:1); the mute, the drunk, the naked, the blind — valid after the fact (1:6)', ['—'])
  korach.the_tithe({ask:who_separates_tithe_terumah})        ('the Levite, and the owner too (Gittin 30b)', ['—'])
