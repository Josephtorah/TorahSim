  sanctions.frame('nomoi')                                   {'v': 'their_civil_customs_not_their_buildings', 'p': 'MOVE', 'why': '18:3 "in their STATUTES you shall not walk" — Onkelos: their NOMOI; Sifra, Acharei Mot, Section 8 8 / Chapter 13 8: theaters, circuses, the Amorite ways; NOT their buildi
  sanctions.frame('sanctify_yourselves')                     {'v': 'the_idolatry_separation', 'p': 'MOVE', 'why': 'Sifra, Kedoshim, Chapter 10 2 — 20:7 read of idolatry specifically (19:2 carries the all-commandments reading)', 'fx': ['—']}
  sanctions.frame('separate_species')                        {'v': 'impure', 'p': 'IMPORT', 'why': '20:25 "SEPARATE between the pure beast and the impure" — CALLED cold_run_shemini.classify (the Lev 11 signs) -> \'impure\'', 'fx': ['—']}
  sanctions.frame('sit_and_abstain')                         {'v': 'rewarded_as_one_who_did_a_commandment', 'p': 'INK', 'why': 'Makkot 3:15 — R. Shimon FROM ITS OWN PLACE: "the souls that DO shall be cut off" (18:29) and "which a man shall DO and live" (18:5) — the two DO tokens censused ((True, True
  sanctions.frame('two_classes')                             {'v': {'judgments': 'reason_would_have_written', 'statutes': 'decreed_no_permission_to_object'}, 'p': 'MOVE', 'why': 'Sifra, Acharei Mot, Chapter 13 9 — 18:4-5: theft, the unions, idolatry, blasphemy, bloodshed vs pig, mixed cloth, the levi
==== cold_run_korach.the_gifts sig ('case', 'data') (28049 chars) asks-in-source ['ass_redeem_or_break', 'betrothed_eats', 'bikkurim', 'bikkurim_eaters', 'bikkurim_partners', 'bikkurim_scope', 'blemish_expert', 'blemished_firstborn', 'blemished_keeping', 'breast_and_thigh', 'clean_firstborn', 'covenant_of_salt', 'covenant_reason', 'devote_firstborn', 'devoted', 'devoted_status', 'devoted_to_whom', 'devotion_by_priests', 'donkey_doubt', 'doubtful_terumah_watch', 'eaten_in_greatness', 'every_male', 'firstborn_blood_mixed', 'firstborn_blood_placement', 'firstborn_eaters', 'firstborn_eating_window', 'firstborn_for_redemption', 'firstborn_portions', 'firstborn_resembles', 'firstborn_sale', 'firstborn_substitute', 'firstborn_without_altar', 'five_sela_coinage', 'from_the_fire', 'gentile_consecrations', 'household', 'impure_terumah_benefit', 'levite_donkey', 'most_holy_eating_place', 'most_holy_list', 'most_holy_portion_use', 'opens_the_womb', 'raise_before_giving', 'redeeming_lamb', 'redemption_before_thirty', 'redemption_means', 'redemption_money_lost', 'redemption_rate', 'redemption_timing', 'returned', 'salt_source', 'self_redemption', 'suspect_firstborn', 'suspect_principle', 'the_best_triad', 'three_crowns', 'twenty_four', 'twenty_gerah_floor', 'twins', 'unclean_firstborn_scope', 'with_joy']
