  korach.the_tithe({ask:you_shall_not_die})                  ("you shall not profane... and you shall not die (18:32) — the warning to Levites and Israelites both (Sifrei 122:1); the priests' words (Lev 8:35, 10:6-9)", ['—'])
==== cold_run_seven_nations.the_seven_nations sig ('case', 'data') (14789 chars) asks-in-source ['no_covenant', 'no_favor', 'no_marriage', 'no_other_way', 'praise_of_the_creator', 'the_asherah_shade', 'the_asherah_wood', 'the_ban', 'the_bans_condition', 'the_child_follows_the_mother', 'the_four_objects', 'the_seven', 'the_write']
def the_seven_nations(case, data):
        """F1 — Deut 7:1-5: the seven counted, THE BAN (the code's hole — the debit open to Joshua), no covenant, NO FAVOR (the hole), no marriage both ways, the four objects; the writes"""

  seven_nations.the_seven_nations({ask:no_covenant})         ("no covenant (7:2) — 23:32's clause verbatim in kind (OR and ER by CALL): covenant_barred written here for the first time on the tape, the border block standing from the Moab giving", ['accepted'])
  seven_nations.the_seven_nations({ask:no_favor})            ("no favor (7:2) — the code's hole compiled: no land, no praise, no gift (Avodah Zarah 20a; Mishnah 1:8): the renter of a house to a gentile in the Land barred — favor_barred on Israel", ['accepted'])
  seven_nations.the_seven_nations({ask:no_marriage})         ("no marriage (7:3) — both directions barred where 34:16 barred one (ER by CALL); the betrothal with a gentile woman ineffective (Kiddushin 68b): the gentile woman's betrothed holds no betrothal — intermarriage_barred on Israel", ['accepted
  seven_nations.the_seven_nations({ask:no_other_way})        ('no other way (7:5) — one with no other way may pass beneath the Asherah ab initio (Avodah Zarah 48b:8): EXEMPT; an important person runs', ['exempt'])
  seven_nations.the_seven_nations({ask:praise_of_the_creator}) ('the praise of the Creator (7:2) — thanks to God for his creatures is not favor to the creature (Avodah Zarah 20a:11): the praiser who thanks the Creator EXEMPT', ['exempt'])
  seven_nations.the_seven_nations({ask:the_asherah_shade})   ("the Asherah's shade (7:5) — not sat in, even the shade of its shade (Mishnah 3:8; Avodah Zarah 48b): the sitter in the Asherah's shade barred", ['accepted'])
  seven_nations.the_seven_nations({ask:the_asherah_wood})    ("the Asherah's wood (7:5, 7:26) — used, its user is FLOGGED (Makkot 22a; Pesachim 48a): the wood-burner lashed; the redemption R. Eliezer's (Avodah Zarah 49b)", ['lashes'])
  seven_nations.the_seven_nations({ask:the_ban})             ("the ban (7:2) — 'you shall utterly devote them': the code's hole compiled — a DEBIT on Israel open to Joshua; the east's devotings runs before the spec; the dispossession's debit referenced (JO by CALL), not doubled", ['accepted'])
  seven_nations.the_seven_nations({ask:the_bans_condition})  ("the ban's condition (7:2) — the Canaanite outside the Land, or who repents, is not devoted (Sotah 35b-36a; 20:16-18 and 21:10 forward): EXEMPT from the ban's debit", ['exempt'])
  seven_nations.the_seven_nations({ask:the_child_follows_the_mother}) ("the child follows the mother (7:3-4) — the gentile woman's son is hers, not yours (Kiddushin 68b; Yevamot 23a; Mishnah Kiddushin 3:12; ER by CALL): the gentile mother's son not his father's", ['accepted'])
  seven_nations.the_seven_nations({ask:the_four_objects})    ("the four objects (7:5) — four verbs where 34:13 had three, the images burned (ER and JO by CALL); the demolition a reference row against the dispossession's open debit; the shelf's order: fell, conquer, eradicate", ['accepted'])
  seven_nations.the_seven_nations({ask:the_seven})           ('the seven (7:1) — the list counted by its own verse: seven where every Exodus list has six, the Girgashite the seventh (ER by CALL); the readback row EXPANDED', ['accepted'])
  seven_nations.the_seven_nations({ask:the_write})           ("the write (7:1-5) — the ban's debit open to the run and the three border blocks on Israel at the chapter's first line", ['commanded', 'covenant_barred', 'favor_barred', 'intermarriage_barred'])
==== cold_run_seven_nations.the_images_and_the_devoted sig ('case', 'data') (12048 chars) asks-in-source ['abomination_to_the_lord', 'burn_the_images', 'devoted_like_it', 'into_your_house', 'lest_snared', 'not_covet_silver_gold', 'the_gentile_revokes', 'the_jew_bent_it', 'the_money_at_the_head', 'the_readback_table', 'the_write', 'utterly_detest']
def the_images_and_the_devoted(case, data):
        """F6 — Deut 7:25-26: the images burned, YOU SHALL NOT COVET the silver and gold (the tenth word's verb turned), lest snared, an abomination to the LORD, THE ABOMINATION IN

  seven_nations.the_images_and_the_devoted({ask:abomination_to_the_lord}) ("an abomination to the LORD (7:25) — the book's phrase at its first seat; the idol an abomination from its making (Avodah Zarah 52a): a DATA row", ['accepted'])
  seven_nations.the_images_and_the_devoted({ask:burn_the_images}) ("the images burned (7:25) — 'the graven images of their gods': a gentile's idol forbidden from its making (Avodah Zarah 52a; Mishnah 4:4 — ER by CALL); 7:5's clause said again with 12:3 forward", ['accepted'])
  seven_nations.the_images_and_the_devoted({ask:devoted_like_it}) ("devoted like it (7:26) — whatever you generate from the idol is like it: the exchange forbidden, the exchange's exchange disputed (Avodah Zarah 54b; Kiddushin 58a): the idol's exchanger holds nothing; the two lemmas a DATA row", ['accepte
  seven_nations.the_images_and_the_devoted({ask:into_your_house}) ("the abomination into the house (7:26) — the code's hole compiled: the renter for a residence barred, the wall withdrawn, a house bowed to forbidden (Mishnah 1:9, 3:6; Avodah Zarah 47b): house_abomination_barred on Israel", ['accepted'])
  seven_nations.the_images_and_the_devoted({ask:lest_snared}) ("lest snared (7:25) — 23:33's snare (OR by CALL); 'lest' a prohibition on the shelf (Avodah Zarah 51b:3): a DATA note", ['accepted'])
  seven_nations.the_images_and_the_devoted({ask:not_covet_silver_gold}) ("you shall not covet (7:25) — the tenth word's verb turned to the idols' silver and gold (CH by CALL; coveting_barred stands): the readback row TURNED; the decorative item the shelf's rule (Avodah Zarah 51b)", ['accepted'])
  seven_nations.the_images_and_the_devoted({ask:the_gentile_revokes}) ("the gentile revokes his idol (7:25) — 'the graven images of their gods' read 'the revoked of' (Avodah Zarah 52a; Mishnah 4:4-5): the gentile who cut its ear's tip holds; the Joshua-war idols stay forbidden", ['accepted'])
  seven_nations.the_images_and_the_devoted({ask:the_jew_bent_it}) ("the Jew who bent the idol (7:25) — not revoked, by Rava's decree lest he acquire it (Avodah Zarah 42a:12); a Jew's idol interred (52a:12): the rule holds against him", ['accepted'])
  seven_nations.the_images_and_the_devoted({ask:the_money_at_the_head}) ("the money at the idol's head (7:25) — permitted, not an ornament (Mishnah Avodah Zarah 4:2; 51b:13-14): the finder EXEMPT from the coveting's bar", ['exempt'])
  seven_nations.the_images_and_the_devoted({ask:the_readback_table}) ("the readback table — twenty-one rows graded (VERBATIM 4, VARIANT 5, EXPANDED 8, TURNED 3, SHORTENED 1); six on the tape, fifteen in the kin's cells by CALL; four holes compiled; no row open", ['accepted'])
  seven_nations.the_images_and_the_devoted({ask:the_write})  ("the write (7:25-26) — the abomination's block on Israel at the chapter's third line; the coveting's block stands unmoved", ['house_abomination_barred'])
  seven_nations.the_images_and_the_devoted({ask:utterly_detest}) ("utterly detest (7:26) — Leviticus 11:43's verb on the idol: the impurity of the idol's stones as a creeping animal's (Avodah Zarah 47b; SH by CALL); the Sifrei 61:7's renaming", ['accepted'])
