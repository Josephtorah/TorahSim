  sanctions.frame('lashes_discharge_karet')                  {'v': ['discharged_R._Chananya_b._Gamliel'], 'p': 'ANSWER-SHEET', 'why': 'Makkot 3:15 — "your brother shall be degraded... once lashed he is your brother" (Deut 25:3 [IMPORT])', 'fx': ['lashes']}
