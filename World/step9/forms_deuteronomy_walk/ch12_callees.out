==== cold_run_journeys.the_command sig ('case', 'data') (8728 chars) asks-in-source ['drive_out', 'figured_stones', 'high_places', 'molten_images', 'negative_arm', 'possess_and_dwell', 'private_altar_eras', 'the_frame', 'the_lot_arms', 'the_lot_restated', 'three_objects_own', 'when_you_pass']
def the_command(case, data):
        del P[:]
        ask = case['ask']
        if ask == 'the_frame':
            ink('33:50', '"and the LORD spoke to Moses in the plains of Moab by the Jordan at Jericho, saying" — %s (35:1 the frame\'

  journeys.the_command({ask:drive_out})                      ("drive out all the inhabitants of the land (33:52-53) — a DEBIT on Israel OPEN BY DESIGN: its runs Joshua's; the crossing's purpose at the Jordan (Sotah 34a:5)", ['commanded'])
  journeys.the_command({ask:figured_stones})                 ("their figured stones (33:52) — Leviticus 26:1's word at its ban's seat, uncompiled: the edge owed, Megillah 22b:11-13's rows filed to the debt", ['commanded'])
  journeys.the_command({ask:high_places})                    ("their high places (33:52) — Leviticus 26:30's curse in the same verb on the same object: the spec/curse pair; the private altar's eras (Mishnah Zevachim 14:4-8) another sense", ['commanded'])
  journeys.the_command({ask:molten_images})                  ("their molten images (33:52) — the calf's word; the ban on making at Exodus 34:17 and Leviticus 19:4 by CALL (the erection and holiness runners)", ['commanded'])
  journeys.the_command({ask:negative_arm})                   ("the negative arm (33:55-56) — thorns in your eyes and pricks in your sides, run back reversed by Joshua 23:13 and Judges 2:3; Saul's Amalek and Haman on the shelf (Megillah 11a); a data row, no verdict on the tape", ['accepted'])
  journeys.the_command({ask:possess_and_dwell})              ("possess the land and dwell in it, for to you I have given it (33:53) — the promise's gift read in the perfect; held before assignment by CALL; no second entry", ['accepted'])
