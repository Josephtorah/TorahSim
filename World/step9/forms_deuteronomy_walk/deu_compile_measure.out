   ordinances.courts(bribe) -> {'v': 'the_bribed_judges_eyes_dim', 'p': 'IMPORT', 'why': "23:8 'and a BRIBE you shall not take, for the bribe blinds the OPEN-EYED (פקחים) and twists the words of the righteous' — 'open-eyed' at [('Exod', 23, 8)] alone, the bribe noun's Torah seats [('Deut', 10, 17), ('Deut', 16, 19), ('Deut', 27, 25), ('Exod', 23, 8)]; Mishnah Peah 8:9 quotes this verse (the bribed judge's eyes dim): CALLED cold_run_holiness.conduct(bribe) -> 'the_bribed_judges_eyes_dim' [IMPORT, live call]", 'fx': ['bribe_barred', 'judgment_perverted']}
   ordinances.courts(asymmetry) -> {'v': 'acquit_by_one_convict_by_two', 'p': 'MOVE', 'why': "Mekhilta on Exod 23:2: 'you are not with them for evil but you ARE with them for good' — twelve acquit against eleven, acquitted; thirteen convict against ten, convicted; eleven against twelve does not convict: 'execute by witnesses, execute by tilters — as witnesses are two, the tilters are two'", 'fx': ['majority_decides']}
   ordinances.courts(one_vs_two) -> {'v': 'merit_by_one_liability_by_two', 'p': 'ANSWER-SHEET', 'why': 'Mishnah Sanhedrin 4:1: money cases tilt by one either way; capital cases tilt by ONE for merit and by TWO for liability; reversed for merit, not for liability', 'fx': ['majority_decides']}
   ordinances.courts(twenty_three) -> {'v': 23, 'p': 'ANSWER-SHEET', 'why': "Mishnah Sanhedrin 1:6: the small court is twenty-three — a judging and a delivering congregation (Num 35:24-25), ten each; and three more from 'DO NOT FOLLOW THE MANY FOR EVIL': not for evil as for good — for good by one, for evil by two; no even court, so one added — THIS VERSE the arithmetic's last term", 'fx': ['majority_decides']}
   ordinances.courts(poor_not_glorified) -> {'v': 'each_verse_its_referent', 'p': 'MOVE', 'why': "23:3 'and the POOR you shall not GLORIFY in his cause' — 'you shall not glorify' (תהדר) at [('Exod', 23, 3), ('Lev', 19, 15)]: this and Lev 19:15's 'you shall not glorify the great'; Mekhilta on Exod 23:3: paired against Lev 19's 'you shall not favor the poor' — each verse takes a referent; the holiness engine's equal-treatment cell by call -> ['not_one_at_length_and_one_cut_short', 'not_one_standing_and_one_sitting'] [IMPORT, live call]", 'fx': ['judgment_perverted']}
   ordinances.courts(needy_in_his_cause) -> {'v': 'hapax_the_wicked_and_worthy_pair', 'p': 'INK', 'why': "23:6 'you shall not pervert the judgment of YOUR NEEDY in his cause' — 'your needy' (אבינך) at [('Exod', 23, 6)] alone; 'pervert judgment' at [('Deut', 16, 19), ('Deut', 24, 17), ('Exod', 23, 6)] (Deut 16:19, 24:17); Mekhilta on Exod 23:6-8: do not say 'he is wicked, I will tilt against him' — he is needy IN COMMANDMENTS, the judgment stays straight", 'fx': ['judgment_perverted']}
   ordinances.courts(keep_far) -> {'v': 'hapax', 'p': 'INK', 'why': "23:7 'from a FALSE MATTER keep far' — the phrase at [('Exod', 23, 7)] alone; Mekhilta on Exod : no ignorant colleague on the bench, no advocates beside the judge, R. Natan: the warning against heresy", 'fx': ['false_report_barred']}
   ordinances.courts(majority_hapax) -> {'v': 'hapax', 'p': 'INK', 'why': "23:2 'you shall not follow AFTER THE MANY for evil... to tilt after the many' — 'after the many' at [('Exod', 23, 2)] alone, 'for evil' (לרעת) at [('Exod', 23, 2)] alone, 'to tilt' (להטת) at [('Exod', 23, 2)] alone: the verse's three rare tokens", 'fx': ['majority_decides']}
   ordinances.courts(measure) -> {'v': 'a_load_it_can_bear', 'p': 'ANSWER-SHEET', 'why': "Mishnah Bava Metzia 2:10 (R. Yosei HaGelili): more than its load — not liable, 'UNDER its burden' = a load it can bear; Mekhilta on Exod : 'lying' — not a habitual lier-down", 'fx': ['unloading_owed']}
   ordinances.courts(onkelos_teaching) -> {'v': 'teach_what_you_see', 'p': 'MOVE', 'why': "Onkelos Exod 23:2 expands the verse into three rulings: 'do not refrain from TEACHING what you see about the judgment; after the many the judgment is completed'", 'fx': ['majority_decides']}
   ordinances.land(angel) -> {'v': 'hapax_the_Name_in_him', 'p': 'INK', 'why': "23:20 'behold I SEND AN ANGEL before you' — the phrase at [('Exod', 23, 20)] alone; 23:21 'for My NAME IS IN HIM' at [('Exod', 23, 21)] alone; Onkelos 23:21: 'for his WORD is in My name' — the verse re-seated on the Memra layer", 'fx': ['—']}
   ordinances.land(borders) -> {'v': ['sea_of_reeds', 'sea_of_the_philistines', 'the_wilderness', 'the_river'], 'p': 'DATA', 'why': "23:31 'I will set your border from the Sea of Reeds to the SEA OF THE PHILISTINES, and from the wilderness to the river' — 'sea of the Philistines' at [('Exod', 23, 31)] alone; the four terms are the data channel (the geography)", 'fx': ['—']}
   ordinances.land(little_by_little) -> {'v': 'not_in_one_year', 'p': 'INK', 'why': "23:29-30 'I will not drive him out before you IN ONE YEAR, lest the land be desolate... LITTLE BY LITTLE I will drive him out' — 'little by little' at [('Deut', 7, 22), ('Exod', 23, 30)] (Deut 7:22 restates), 'in one year' at [('1Kgs', 10, 14), ('2Chr', 9, 13), ('Exod', 23, 29)] (Solomon's gold the other two)", 'fx': ['land_desolate']}
   ordinances.land(hornet) -> {'v': 3, 'p': 'INK', 'why': "23:28 'and I will send THE HORNET before you' — the token at [('Deut', 7, 20), ('Exod', 23, 28), ('Josh', 24, 12)]: this, Deut 7:20, Joshua 24:12 ('and I sent the hornet before you' — the run of this promise in the Prophets)", 'fx': ['—']}
