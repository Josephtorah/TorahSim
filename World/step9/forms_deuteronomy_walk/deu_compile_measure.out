   exodus_story.jethro(denominations) -> {'v': 4, 'p': 'INK', 'why': "'rulers of THOUSANDS, rulers of HUNDREDS, rulers of FIFTIES and rulers of TENS' (18:21, 18:25) — four denominations (the numeral parser reads the singulars; the plurals 'thousands' and 'tens' are read here as the ink's tokens)", 'fx': ['courts_established']}
   exodus_story.jethro(hard_cases) -> {'v': 'to_moses', 'p': 'INK', 'why': "'the hard matter they brought to Moses, and every small matter they judged themselves' (18:26; 18:22) — the court's status", 'fx': ['hard_cases_to_moses']}
   exodus_story.jethro(judges) -> {'v': 78600, 'p': 'INK', 'why': "the four denominations of 18:21 (['אלפים', 'מאות', 'חמשים', 'עשרת'] — thousands, hundreds, fifties, tens) over 12:37's 'about six hundred thousand on foot': 600 + 6,000 + 12,000 + 60,000 = 78,600 — Sanhedrin 18a:3's own total ('the judges of Israel seventy-eight thousand six hundred'); the sequence runner CS6", 'fx': ['courts_established']}
   exodus_story.jethro(sanhedrin_sizes) -> {'v': (71, 23), 'p': 'ANSWER-SHEET', 'why': "Mishnah Sanhedrin 1:6 — the great Sanhedrin seventy-one (Num 11:16's seventy and Moses over them), the small twenty-three — the courts' institution by name; the denominations of 18:21 are the wilderness's own grid", 'fx': ['courts_established']}
   exodus_story.jethro(timing) -> {'v': ('before', 'after'), 'p': 'MOVE', 'why': "Zevachim 116a:20 — the sons of Rabbi Chiya and Rabbi Yehoshua ben Levi: one said Jethro came BEFORE the giving of the Torah, one said AFTER; the row jethro_timing runs the ink's order (before); the after-arm would move 18's acts past the covenant — OPEN-9, recorded not run", 'fx': ['offered_burnt_and_sacrifices']}
   exodus_story.manna(forty_years) -> {'v': 40, 'p': 'INK', 'why': "'and the sons of Israel ate the manna FORTY YEARS until they came to an inhabited land' (16:35) — the provision's stated span, past the three books", 'fx': ['manna_provided']}
   exodus_story.trials(ten_list) -> {'v': ('two_at_the_sea', 'two_at_the_water', 'two_at_the_manna', 'two_at_the_quail', 'one_at_the_calf', 'one_at_paran'), 'p': 'MOVE', 'why': 'Arakhin 15a:14 — Rabbi Yehuda: ten trials our fathers tried the Holy One: two at the sea, two at the water, two at the manna, two at the quail, one at the calf, one in the wilderness of Paran', 'fx': ['tested_the_lord']}
   exodus_story.trials(count_by_exodus) -> {'v': 6, 'p': 'MOVE', 'why': "Arakhin 15a:14-15b:2 restricted to the span — the trials the ink narrates by Exodus 19: the sea's descent (14:11 'were there no graves in Egypt'), Marah (15:24), the fleshpot (16:3 — the first quail, 15b:2), the manna twice (16:20 left till morning; 16:27 went out on the seventh), Rephidim (17:2-3): SIX on the ledger (CS7)", 'fx': ['tested_the_lord']}
   exodus_story.sinai(names_count) -> {'v': 6, 'p': 'INK', 'why': "the naming clauses of Exodus 1-19 (a call-verb with 'name' within four words): [(2, 10), (2, 22), (15, 23), (16, 31), (17, 7), (17, 15)] — six: Moses, Gershom, Marah, the manna, Massah and Meribah, the altar", 'fx': ['name_given']}
   exodus_story.amalek(weakened_seat) -> {'v': 1, 'p': 'INK', 'why': "'and Joshua WEAKENED Amalek' (17:13 vayachalosh) — the verb's only seat in the Torah (measured; Job 14:10 the Tanakh's second)", 'fx': ['amalek_weakened']}
   exodus_story.amalek(blotting) -> {'v': 'open_to_deuteronomy_and_samuel', 'p': 'INK', 'why': "'for I will surely BLOT OUT the memory of Amalek from under the heavens' (17:14) — a HEAVEN entry on Amalek OPEN at the three books' end: Deut 25:19's command and 1 Sam 15's run are book-bound; 17:16 'a war for the LORD against Amalek from generation to generation'", 'fx': ['amalek_to_be_blotted']}
