   erection.presence(horev_plene) -> {'v': 1, 'p': 'INK', 'why': "33:6 'from Mount HOREB' — the name written plene (חורב) at this seat alone in the Tanakh (17:6 'in Horeb' with a prefix; the bare form is 'sword')", 'fx': ['—']}
