   erection.covenant(nations_seven_orders) -> {'v': 7, 'p': 'INK', 'why': "the nations' list at seven seats of Exodus and Deuteronomy in SEVEN DIFFERENT ORDERS: {'Exod 3:8': ['כנעני', 'חתי', 'אמרי', 'פרזי', 'חוי', 'יבוסי'], 'Exod 13:5': ['כנעני', 'חתי', 'אמרי', 'חוי', 'יבוסי'], 'Exod 23:23': ['אמרי', 'חתי', 'פרזי', 'כנעני', 'חוי', 'יבוסי'], 'Exod 23:28': ['חוי', 'כנעני', 'חתי'], 'Exod 33:2': ['כנעני', 'אמרי', 'חתי', 'פרזי', 'חוי', 'יבוסי'], 'Exod 34:11': ['אמרי', 'כנעני', 'חתי', 'פרזי', 'חוי', 'יבוסי'], 'Deut 7:1': ['חתי', 'גרגשי', 'אמרי', 'כנעני', 'פרזי', 'חוי', 'יבוסי']} — 34:11 names six (Amorite first), 33:2 six (Canaanite first), 23:23 six (Amorite first but the Canaanite fourth), 13:5 five, 23:28 three, Deut 7:1 seven with the Girgashite: no two seats agree on the order and only Deuteronomy has the seventh", 'fx': ['nations_driven_out']}
   erection.ascent(forty) -> {'v': 9, 'p': 'INK', 'why': "24:18 'Moses was on the mountain FORTY DAYS AND FORTY NIGHTS' — the phrase at 9 seats: Noah's rain twice, Moses' three ascents (24:18, 34:28; Deut 9:9, 9:11, 9:18, 10:10), Elijah's walk (1 Kgs 19:8)", 'fx': ['—']}
