  gad_reuben.DATA[caleb_the_kenizzite] = {'value': 'genesis_15_19s_nation_as_a_gentilic', 'settings': {'genesis_15_19s_nation_as_a_gentilic': "'the Kenizzite' at Genesis 15:19 (the ten nations), Numbers 32:12 and Joshua 14:6, 14 — Caleb's gentilic the nation's name; Othniel 'son of Kenaz' (Joshua 15:17; Judges 1:13, 3:9, 3:11) — the ink's four seats", 'the_stepfather_kenaz': "the shelf's reading elsewhere (Sotah 11b; Temurah 16a) — Kenaz Caleb's stepfather: NO ROW of this docket carries it; the ink's arm alone here"}, 'source': "32:12 'Caleb son of Jephunneh the Kenizzite' — the gentilic's four Bible seats computed"}
  gad_reuben.DATA[count_from] = {'value': 'the exodus', 'settings': {'the exodus': "Deut 2:14's thirty-eight from Kadesh-barnea to Zered — the forty includes the two years elapsed (40 − 38 = 2 = the era's year at the decree)", 'the decree': "the plain forty from 14:34's own day — (42, 5, 9)"}, 'source': "32:13 'forty years' — SL's row READ by CALL: the forty from the exodus (Deuteronomy 2:14's thirty-eight from Kadesh — the parser's [38])"}
