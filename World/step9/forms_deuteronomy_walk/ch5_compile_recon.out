    220: wr = [(eid, e['effect'], e['op']) for eid, e in ledger if contains(e.get('case_source'), k)]
    221: ev = [e['kind'] for e in EV if contains(e.get('case_source'), k)]
    223: cls = 'CLOSE' if cl else ('ACT' if wr else ('EVENT' if ev else ('CHAPTER' if ch else 'NONE')))
    224: out[ref(k)] = {'class': cls, 'evidence': {'CLOSE': cl[:3], 'ACT': wr[:3], 'EVENT': ev[:3], 'CHAPTER': ch[:3], 'NONE': []}[cls]}
    244: out[ref(k)] = {'class': 'DAEMONS' if inside else 'EMPTY', 'kind': d['kind'], 'noun': d['noun'], 'stamp': d['stamp'], 'block': block, 'daemons': len(inside),
    258: d['class'] = 'ROWS' if rows else 'NONE'; d['rows'] = len(rows); d['nouns'] = dict(d['nouns'])
    297: computed = {'counts': class_counts(ink, w), 'receipts': class_receipts(ink, w), 'footers': class_footers(ink), 'registers': class_registers(ink, w)}
