FACT food_tithe.the_second_tithe(the_liabilities) = ("the liabilities (14:22) — the yield of your seed, the field, year by year: food, guarded, grown from the ground (the Sifrei 105:1-19; Mishnah Maasrot 1:1 — KO.the_tithe by CALL), the thresholds the pile smoothed (KO 'thresholds'): the one who eats a casual snack before the pile is smoothed exempt", ['exempt'], [('INK', 'Deut 14:22 — "all the yield of your SEED that comes out of THE FIELD year by year" — "the yield of your seed" [\'Deut 14:22\']; "that comes out" the participle [(\'היצא\', \'HTd/Vqrmsa\')]; "year by year" [\'Deut 14:22\']'), ('MOVE', "the Sifrei 105:1-19 (read whole at the reading); Mishnah Maasrot 1:1, 1:3, 2:4, 4:5-6 (read whole at the docket); cold_run_korach (CALL) — KO.the_tithe(liable_produce) = food, guarded, grown from the land (Mishnah Ma'aserot 1:1); the ripeni; KO.the_tithe(thresholds) = the pile evened, the wine skimmed, the oil dripped (Sifrei 121:1; Mish — THE LIABILITIES FROM THE VERSE'S CLAUSES — 'the yield of your seed' what grows from seed (not mushrooms), 'the field' what goes out to the field, 'year by year' (105:1-19): food, guarded, grown from the ground (Mishnah Maasrot 1:1 — KO by CALL), the seasons of liability (1:3, 2:4), the casual meal before the work is finished exempt (1:5-8; 4:5-6 — the thresholds: the pile smoothed, the wine skimmed, the oil dripped, KO 'thresholds' by CALL)"), ('DATA', "the liabilities a DATA row (the_liabilities — Mishnah Maasrot 1:1, 1:3, 2:4, 4:5-6; korach.the_tithe by CALL); the exam's person the one who eats a casual snack before the pile is smoothed — EXEMPT (Maasrot 1:5)")])
FACT food_tithe.the_second_tithe(year_by_year) = ("year by year (14:22) — no tithing from one year's produce for another's (the Sifrei 105:16-19); the tithes' new year Tishri 1 with the first third (Rosh Hashanah 12a:6-9, 12b:9-11 — THE PARAMETER the_tithes_new_year): the one who tithes from the new for the old barred from it", ['barred_from_it'], [('INK', 'Deut 14:22 — "year by year" — the doubled noun [\'Deut 14:22\']; the tithes\' new year the parameter: [\'shevat_15\', \'the_first_third\', \'tishri_1\', \'year_by_year\']'), ('MOVE', "the Sifrei 105:16-19 (read whole at the reading); Rosh Hashanah 12a:6-9, 12b:9-11 (read whole at the docket); the parameter the_tithes_new_year = ['shevat_15', 'the_first_third', 'tishri_1', 'year_by_year'] — 'YEAR BY YEAR' — no tithing from one year's produce for another's (105:16-19; Mishnah Terumot 1:5's rule for the tithe); THE TITHES' NEW YEAR Tishri 1 (Rosh Hashanah 12a:6-9 — 'tithes' plural), the first third the year's mark (12b:9-11), the tree's the fifteenth of Shevat: the parameter the_tithes_new_year"), ('DATA', "year by year a DATA row (year_by_year — the parameter's keys ['shevat_15', 'the_first_third', 'tishri_1', 'year_by_year']); the exam's person the one who tithes from the new for the old — barred_from_it (no tithe across the years)")])
