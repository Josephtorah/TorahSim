FACT obey_horeb.no_image(image_of_the_host) = ("an image of the host (Rosh Hashanah 24b:8) — forming the sun and the moon prohibited: the second word's row holds (its engine OWED)", ['accepted'], [('INK', 'Deut 4:19 — "the sun, the moon and the stars, all the host of heaven" — forming their images: "you shall not make with Me" (Exodus 20:20) My attendants'), ('MOVE', "Rosh Hashanah 24b:8; Mishnah Avodah Zarah 3:3 — the sun, the moon, the stars, the constellations — forming them prohibited (Abaye's answer rejected); the sun and the moon on vessels cast into the Dead Sea")])
FACT obey_horeb.no_image(the_host_apportioned) = ("the host apportioned (4:19) — with 29:25 by the Sifrei 148:8's pair; Rav's reading (Avodah Zarah 55a): a DATA note, no link of our own", ['accepted'], [('INK', 'Deut 4:19 — "and lest you lift your eyes to heaven and see the sun, the moon and the stars, all the host of heaven, and be drawn away and bow to them and serve them — which the LORD your God APPORTIONED to all the peoples under the whole heaven" — "the sun, the moon and the stars" [\'Deut 4:19\']; "all the host of heaven" [\'Deut 4:19\', \'Isa 34:4\']; "apportioned" the qal perfect at [\'2Chr 23:18\', \'2Chr 28:21\', \'Deut 4:19\', \'Deut 29:25\', \'Job 39:17\']; "to all the peoples under the whole heaven" [\'Deut 4:19\']'), ('MOVE', "Sifrei Devarim 148:8 (the reading); Avodah Zarah 55a:9-10; Megillah 9b:1 — 4:19 with 29:25 — not given to the nations for worship; Rav: He let them slip into their delusion; the Septuagint's 'to give light'"), ('DATA', 'the row the_host_apportioned: a DATA note, no link of our own (Onkelos "prepared")')])
FACT obey_horeb.no_image(the_iron_furnace) = ('the iron furnace (4:20) — the exodus READ BACK, EXPANDED: the furnace told only here in the Torah (1 Kings 8:51 outside; PR by CALL)', ['accepted'], [('INK', 'Deut 4:20 — "but you the LORD took and brought out of the iron furnace, out of Egypt, to be a people of inheritance to him as this day" — the furnace-word\'s seats [\'1Kgs 8:51\', \'Deut 4:20\', \'Ezek 22:18\', \'Ezek 22:20\', \'Ezek 22:22\', \'Jer 11:4\'] (1 Kings 8:51 and Jeremiah 11:4 the kin); "a people of inheritance" [\'Deut 4:20\']; "the LORD took you" [\'Deut 4:20\']'), ('MOVE', "cold_run_primeval (CALL) — PR.pieces(furnace) = ('michael', 'the_holy_one_himself') — Genesis 15:17's smoking furnace another word; Bereshit Rabbah 44:13's furnace of fire at 15:7 — the furnace's first seat in the fathers' story"), ('DATA', 'the readback row 4:20 EXPANDED — brought_out (Exod 12:51) found')])
FACT obey_horeb.no_image(the_bar_third_telling) = ("the bar's third telling (4:21-22) — 'on your account' and an oath against Numbers 20:12's 'because you did not believe': DISAGREES, the 1b row widened, an OPEN row; no oath written", ['accepted'], [('INK', 'Deut 4:21-22 — "and the LORD was angry with me on your account, and swore that I should not cross the Jordan nor come into the good land … for I die in this land" — "was angry with me" [\'Deut 4:21\']; the anger-root\'s four Torah seats [\'Deut 1:37\', \'Deut 4:21\', \'Deut 9:20\', \'Deut 9:8\']; "on your account" [\'Deut 4:21\']; "and swore that I should not cross" [\'Deut 4:21\']; "for I die" [\'Deut 4:22\']'), ('MOVE', "cold_run_opening_speech (CALL) — OS.the_spies_read_back(the_bars_ground) = the bar's ground (1:37) — 'for your sakes' against 20:12's 'because yo; OS.the_plea(the_refusal) = the refusal (3:26) — 'let it suffice you' the singular's one — 1:37's 'for your sakes' and 3:26's 'was wroth for your sakes' — the 1b DISAGREES row; the refusal 'let it suffice you'"), ('DATA', "the row the_bars_third_telling: ['Deut 1:37', 'Deut 3:26', 'Deut 4:21'] — the OATH the tape never wrote; the 1b row WIDENED, OPEN; barred_from_the_land on Moses unmoved")])
FACT obey_horeb.no_image(the_covenant_not_forgotten) = ("the covenant not forgotten (4:23) — the guard's second seat: the covenant cut at Horeb (the tape's covenant_blood_thrown) and the image", ['accepted'], [('INK', 'Deut 4:23 — "take heed to yourselves lest you forget the covenant of the LORD your God which he cut with you, and make a graven image" — [\'Deut 4:23\']; "which he cut with you" [\'Deut 4:23\']; the second word\'s kin')])
FACT obey_horeb.no_image(consuming_fire_jealous_god) = ("a consuming fire, a jealous God (4:24) — the second word's 'jealous' (Exodus 20:5 by reference); jealousy at the worshipper, not the idol (Avodah Zarah 54b-55a)", ['accepted'], [('INK', 'Deut 4:24 — "for the LORD your God is a consuming fire, a jealous God" — "a consuming fire" [\'Deut 4:24\', \'Deut 9:3\', \'Joel 1:19\', \'Joel 2:5\']; "a jealous God" [\'Deut 4:24\', \'Deut 5:9\', \'Deut 6:15\', \'Exod 20:5\', \'Exod 34:14\'] (Exodus 20:5\'s word); the verse 8 tokens'), ('MOVE', 'Sifrei Devarim 49:2 (the reading); Ketubot 111b:6; Sotah 14a:3 — how cleave to a consuming fire? — the sages; walk after His attributes'), ('MOVE', "Avodah Zarah 54b:18, 55a:2-3; Nedarim 62b:3 — the philosopher's and Agrippas's questions to Rabban Gamliel — jealousy at the worshipper, not the idol (the dog named after the king; the second wife)")])
