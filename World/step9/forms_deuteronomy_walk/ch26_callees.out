FACT food_tithe.the_far_place_the_money_the_rejoicing_and_the_levite(the_moneys_form) = ("the money's form (14:25) — the blank (R. Yishmael) / the imprint (R. Akiva) at Bava Metzia 47b:5; Mishnah Eduyot 3:2: THE PARAMETER the_moneys_form, the coined arm the answer sheet's; the one who redeems with a blank coin barred from it, R. Yishmael's arm recorded", ['barred_from_it'], [('INK', 'Deut 14:25 — "then you shall turn it into MONEY, and BIND UP the money in your hand" — "turn it into money" [\'Deut 14:25\']; "bind up the money in your hand" [\'Deut 14:25\']; the binding verb\'s kin Genesis 42:35, 2 Kings 5:23 True'), ('MOVE', "Bava Metzia 47b:5 (read whole at the docket); Mishnah Eduyot 3:2; the Sifrei 107:4 (read whole at the reading — I1); the parameter the_moneys_form = ['r_akiva', 'r_yishmael', 'the_possession', 'the_three_moneys'] — THE MONEY'S FORM A PARAMETER — R. Yishmael: THE BLANK bound in the hand redeems (a coin without an imprint — Bava Metzia 47b:5); R. Akiva: THE IMPRINT — 'money' with a form, coined (47b:5; Mishnah Eduyot 3:2 — R. Dosa permits the blank, the Sages do not); the coined arm THE ANSWER SHEET'S (Maaser Sheni 1:2), applied five times outside the chapter (Berakhot 47b:10, Eruvin 31b:12, Pesachim 35b:15, Shabbat 128a:3, Bekhorot 51a:6)"), ('DATA', "THE PARAMETER the_moneys_form on file (DF6 — ['r_akiva', 'r_yishmael', 'the_possession', 'the_three_moneys']); the readback row 14:25 SUPPLIED (the money's first seat); the exam's person the one who redeems the second tithe with a blank coin — barred_from_it (the answer sheet's arm; R. Yishmael's recorded)")])
FACT food_tithe.the_far_place_the_money_the_rejoicing_and_the_levite(the_possession) = ("the possession (14:25) — 'in your hand': coined, current, in one's possession (Mishnah Maaser Sheni 1:2); not the money in the sea (Bava Kamma 98a:4): the one who redeems with money fallen into the sea barred from it", ['barred_from_it'], [('INK', 'Deut 14:25 — "and bind up the money IN YOUR HAND" — "in your hand" [\'בידך\']'), ('MOVE', "Mishnah Maaser Sheni 1:2; Bava Kamma 98a:4; Bekhorot 50b:5; Kiddushin 11b:3 (read whole at the docket); the Sifrei 107:5 — THE POSSESSION CLAUSE — 'in your hand': the second tithe is redeemed with money that is coined, current and IN ONE'S POSSESSION (Mishnah Maaser Sheni 1:2); not with money fallen into the sea (Bava Kamma 98a:4); any coinage (Bekhorot 50b:5; Kiddushin 11b:3) — the parameter's third clause (departure (c))"), ('DATA', "the possession a DATA row (the_possession — Maaser Sheni 1:2; Bava Kamma 98a:4); the exam's person the one who redeems with money fallen into the sea — barred_from_it")])
FACT food_tithe.the_far_place_the_money_the_rejoicing_and_the_levite(the_three_moneys) = ("the three moneys (14:25-26) — the tithe's, the doubtful's, the redemption's (the Sifrei 107:7; Mishnah Maaser Sheni 3:10): the scholar who counts the three moneys accepted", ['accepted'], [('INK', 'Deut 14:25-26 — "the money" three times 3 in 14:25-26'), ('MOVE', "the Sifrei 107:7 (read whole at the reading — I1, checked in MIDDOT.md); Mishnah Maaser Sheni 3:10 (read whole at the docket) — THREE MONEYS THE LAW'S TABLE — the second tithe's money, the doubtfully-tithed's, the redemption's (107:7 — a fortiori from the tithe itself; Mishnah Maaser Sheni 3:10: what is bought with the tithe's money holds the tithe's sanctity)"), ('DATA', "the three moneys a DATA row (the_three_moneys — 107:7; Maaser Sheni 3:10); the exam's person the scholar who counts the three moneys — accepted")])
FACT food_tithe.the_far_place_the_money_the_rejoicing_and_the_levite(the_class_from_the_four) = ("the class from the four (14:26) — general, particular, general: fruit from fruit, growing from the ground, kept by the land (the Sifrei 107:8-11; Bava Kamma 54b:20; NAZIR 35b:3 — the chapter's verse the source of the method): water and salt out (Eruvin 26b:18; Maaser Sheni 1:5); the one who buys water and salt with the tithe's money barred from it", ['barred_from_it'], [('INK', 'Deut 14:26 — "and you shall spend the money FOR WHATEVER YOUR SOUL DESIRES, for cattle or sheep, for wine or strong drink, OR WHATEVER YOUR SOUL ASKS OF YOU" — the general, the four named, the general; "for cattle or sheep, for wine or strong drink" [\'Deut 14:26\']; "strong drink" in the Torah [(\'Deut 14:26\', \'ובשכר\'), (\'Deut 29:5\', \'ושכר\'), (\'Lev 10:9\', \'ושכר\'), (\'Num 6:3\', \'ושכר\'), (\'Num 6:3\', \'שכר\'), (\'Num 28:7\', \'שכר\')]'), ('MOVE', "the Sifrei 107:8-11 (read whole at the reading — I6, checked in MIDDOT.md); Bava Kamma 54b:20, 63a:6; NAZIR 35b:3; Eruvin 26b:18, 27b:14; Mishnah Eruvin 3:1; Mishnah Maaser Sheni 1:5, 1:7, 2:1 (read whole at the docket) — THE CLASS FROM THE FOUR NAMED BY GENERAL-PARTICULAR-GENERAL — 'whatever your soul desires' the general, 'cattle, sheep, wine, strong drink' the particulars, 'whatever your soul asks' the general: only what is like the particulars — fruit from fruit, growing from the ground, whose keeping is by the land (107:8-11; Bava Kamma 54b:20; NAZIR 35b:3 — THE CHAPTER'S VERSE THE SOURCE OF THE METHOD: where the Torah teaches general-particular-general, this is it; the rival amplification-restriction at Eruvin 27b:14); WATER AND SALT OUT (Eruvin 26b:18; Mishnah Eruvin 3:1; Maaser Sheni 1:5, 1:7, 2:1 — not bought with the tithe's money): departure (a) — I6, not the paradigm"), ('DATA', "the class from the four a DATA row (the_class_from_the_four — I6 at Nazir 35b:3, the chapter's verse the source of the method; water and salt out); the readback row 14:26 EXPANDED (the reuse; PN by CALL); the exam's person the one who buys water and salt with the tithe's money — barred_from_it")])
