FACT festivals_judges.the_three_pilgrimages(the_three_times) = ("the three times (16:16) — all the males appear three times at the place (the Sifrei 143:1-2; calendar.pilgrimage('able_male') owes the three appearings by CALL): THE WRITE three_pilgrimages_commanded, a STATUS on Israel at the chapter's own day; the able man who ascends thrice accepted", ['three_pilgrimages_commanded'], [('INK', 'Deut 16:16 — "THREE TIMES A YEAR all your males shall appear before the LORD your God in the place which He will choose" — the parser\'s [3] [3] ("three" spelled full — the diff with Exodus 34:23 (\'replace\', [\'שלוש\'], [\'שלש\'])); Exodus 34:23\'s eight in order, 23:17\'s seven (8, 7); 2 Chronicles 8:13 the one other verse with the three names in order (asserted at the reading)'), ('MOVE', "the Sifrei 143:1-2 (read whole at the reading); cold_run_calendar (CALL) — CA.pilgrimage(able_male) = owes the three appearings; the one database — appearance_owed on [] — THE THREE TIMES — 'times' the seasons (143:1 — Onkelos 'three times in the year'), the appearing (143:2 — as He comes to see, He comes to be seen: the two eyes); the able male owes the three appearings by CALL (appearance_owed the calendar's heaven entry on its case world, NONE on the tape UNMOVED): THE STATUS three_pilgrimages_commanded the chapter's addition — the place"), ('DATA', "THE WRITE three_pilgrimages_commanded — a STATUS on israel_people at the counter's day (DH2); the exam's person the able man who ascends three times to the place — accepted")])
FACT festivals_judges.the_three_pilgrimages(who_appears) = ("who appears (16:16) — all obligated except the twelve exempt, the minor by the father's shoulders (Shammai) or hand (Hillel) — Mishnah Chagigah 1:1 read whole (the Sifrei 143:3-5; calendar.pilgrimage by CALL: the woman exempt): THE PARAMETER the_exempt_from_appearing; the woman at the feast exempt", ['exempt'], [('INK', 'Deut 16:16 — "ALL YOUR MALES" — "your males" [\'זכורך\']; the phrase "all your males shall appear" three in the Bible (Exodus 23:17, 34:23, here — asserted at the reading)'), ('MOVE', "the Sifrei 143:3-5 (read whole at the reading — the Mishnah's minor inside the spine); MISHNAH CHAGIGAH 1:1 (read whole at the design — THE EXAM ROW); cold_run_calendar (CALL) — woman exempt, lame exempt, one-eyed exempt — WHO APPEARS — all are obligated in the appearance except the deaf-mute, the imbecile, the minor, the tumtum, the hermaphrodite, women, unfreed slaves, the lame, the blind, the sick, the old and one who cannot ascend on foot; THE MINOR — the House of Shammai: one who cannot ride on his father's shoulders; the House of Hillel: one who cannot hold his father's hand and ascend, 'three regalim' read at the feet: A PARAMETER with the list and the minor's two arms; the calendar's exempt arms by CALL"), ('DATA', "THE PARAMETER the_exempt_from_appearing (the twelve exempt, the minor two arms); the exam's person the woman at the feast — exempt; the child who can hold his father's hand — obligated by Hillel's arm")])
FACT festivals_judges.the_three_pilgrimages(the_order_of_the_names) = ("the order of the names (16:16) — the delay's clock three feasts in order (the Sifrei 143:7; 2 Chronicles 8:13 the run's case): the vower whose two feasts passed out of order accepted, not yet in delay", ['accepted'], [('INK', 'Deut 16:16 — "at the feast of unleavened bread, at the feast of weeks and at the feast of booths" — the three names in order; "and at the feast of booths" [\'2Chr 8:13\', \'Deut 16:16\']'), ('MOVE', "the Sifrei 143:7 (read whole at the reading) — THE ORDER OF THE THREE NAMES READ AS A CLOCK — R. Simeon: no need to say booths, the verse's own subject; why weeks and booths? one does not transgress 'do not delay' (23:22 ahead) until the whole year's pilgrimages have passed in order: THE DELAY'S CLOCK a DATA row (Mishnah Rosh Hashanah 1:1, 4a owed); 2 Chronicles 8:13 the run's case"), ('DATA', "the delay's clock a DATA row (the_delays_clock — three feasts in order from the vow); the exam's person the vower whose two feasts passed out of order — accepted, not yet in delay")])
FACT festivals_judges.the_three_pilgrimages(not_empty) = ("not empty (16:16) — the appearance offering owed at the appearing (the Sifrei 143:8; erection.repeats standing_liability_like_the_appearance_offering by CALL): THE WRITE empty_appearance_barred, a BLOCK on Israel at the chapter's own day; the pilgrim without an offering barred from it", ['empty_appearance_barred'], [('INK', 'Deut 16:16 — "AND NONE SHALL APPEAR BEFORE THE LORD EMPTY" — the one seat of the form (Exodus 23:15 and 34:20 "they shall not appear before Me empty" the plural twins [(\'Exod\', 23, 15), (\'Exod\', 34, 20)]); Onkelos "empty" one seat'), ('MOVE', "the Sifrei 143:8 (read whole at the reading); cold_run_erection (CALL) — ER.repeats(empty_where_it_stands) = standing_liability_like_the_appearance_offering; the one database — appearance_gift_owed on [] — NOT EMPTY — the appearance burnt offering (143:8); 'empty'/'empty' from the appearance offering the standing liability (Bekhorot 51b — the erection's cell by CALL; appearance_gift_owed the erection's debit on its case world, NONE on the tape UNMOVED): THE BLOCK empty_appearance_barred the chapter's third seat of the clause"), ('DATA', "THE WRITE empty_appearance_barred — a BLOCK on israel_people at the counter's day (DH2); the exam's person the pilgrim who appears without an offering — barred from it")])
FACT festivals_judges.the_three_pilgrimages(the_two_amounts) = ("the two amounts (16:16-17) — the appearance two silver and the festival offering a ma'ah (Shammai), the reverse (Hillel) — Mishnah Chagigah 1:2 read whole (erection's ('two_silver', 'maah') by CALL): THE PARAMETER the_two_amounts; the ma'ah appearance accepted by Hillel's arm", ['accepted'], [('INK', 'Deut 16:16-17 — "none shall appear … empty; each man as the gift of his hand" — the measure the answer sheet\'s'), ('MOVE', "the Sifrei 143:8 (read whole at the reading); MISHNAH CHAGIGAH 1:2 (read whole at the design — THE EXAM ROW); cold_run_erection (CALL) — ER.repeats(appearance_amounts) = ('two_silver', 'maah') — THE TWO AMOUNTS — the House of Shammai: the appearance two silver and the festival offering a ma'ah; the House of Hillel: the appearance a ma'ah and the festival offering two silver: A PARAMETER with both arms (the erection's DATA row the same pair by CALL)"), ('DATA', "THE PARAMETER the_two_amounts (Shammai / Hillel); the exam's person the pilgrim whose appearance offering is worth a ma'ah — accepted by Hillel's arm")])
FACT festivals_judges.the_three_pilgrimages(the_gift_of_the_hand) = ('the gift of the hand (16:17) — many eaters and little property: many peace offerings and few burnt; the reverse reversed; both few the minimums; both many as his hand — Mishnah Chagigah 1:5 read whole (the Sifrei 143:9): THE PARAMETER the_gift_of_the_hand; the man of many eaters accepted', ['accepted'], [('INK', 'Deut 16:17 — "EACH MAN AS THE GIFT OF HIS HAND, according to the blessing of the LORD your God which He has given you" — the verse [\'איש\', \'כמתנת\', \'ידו\']; 12:15\'s six tokens shared in order 6'), ('MOVE', "the Sifrei 143:9 (read whole at the reading — the Mishnah cited in the spine's Hebrew); MISHNAH CHAGIGAH 1:5 (read whole at the design — THE EXAM ROW) — THE GIFT OF THE HAND — one with many eaters and little property brings many peace offerings and few burnt offerings; much property and few eaters — many burnt and few peace; both few — the ma'ah and the two silver; both many — 'each man as the gift of his hand, according to the blessing': A PARAMETER with the four cases"), ('DATA', "THE PARAMETER the_gift_of_the_hand (the four cases); the exam's person the man of many eaters and little property who brings many peace offerings — accepted")])
FACT festivals_judges.the_three_pilgrimages(the_guard_of_the_land) = ("the guard of the land (16:16) — 'no man shall covet your land when you go up' (the Sifrei 52:4; erection.repeats cow_grazes_unharmed by CALL): the householder who leaves his field to appear accepted", ['accepted'], [('INK', 'Deut 16:16 — "all your males shall appear" — while every male goes up, who guards the land? (the Sifrei 52:4 on 11:25, citing 16:16 — the outside row reread whole)'), ('MOVE', "the Sifrei 52:4 (reread whole at the reading); cold_run_erection (CALL) — ER.repeats(warranty_read) = cow_grazes_unharmed — THE GUARD OF THE LAND — 'no man shall covet your land when you go up' (Exodus 34:24 — pilgrim_land_guarded the erection's heaven entry; 'your cow grazes in the meadow and no beast harms it' — Pesachim 8b by the erection's cell): the warranty of the pilgrimage, a DATA row"), ('DATA', "the guard of the land a DATA row (the_guard_of_the_land — Exodus 34:24 by CALL); the exam's person the householder who leaves his field to appear — accepted, the land guarded")])
