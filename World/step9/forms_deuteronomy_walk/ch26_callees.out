FACT food_tithe.the_sons_and_the_cuttings(for_the_dead) = ('for the dead (14:1) — the condition: the one who cuts himself or makes a bald spot for his fallen house exempt (Makkot 20b:10); the cutting for idolatry a bar beside it (21a:3)', ['exempt'], [('INK', 'Deut 14:1 — "for the dead" (למת) [\'Deut 14:1\', \'Deut 26:14\'] — 14:1 and 26:14\'s "I have not given of it for the dead" in the book'), ('MOVE', "Makkot 20b:10 and 21a:3 (read whole at the docket); the Sifrei 96:11 — 'FOR THE DEAD' THE CONDITION — one who makes a bald spot for his fallen house or his sunk ship is exempt (Makkot 20b:10); THE CUTTING FOR IDOLATRY BESIDE IT (21a:3 — 'they cut themselves after their manner', Baal's priests: R. Yosei — with an instrument liable, with the hand not; the Sages the reverse for idolatry); the gash 'for a soul' (Leviticus 19:28 — holiness_b by CALL: the fallen house excluded)"), ('DATA', '"for the dead" the condition a DATA row (for_the_dead — Makkot 20b:10; the idolatry cut beside it 21a:3); the exam\'s person the one who cuts himself for his fallen house — EXEMPT')])
FACT food_tithe.the_sons_and_the_cuttings(the_holy_people) = ("the holy people (14:2) — 7:6 said again (eighteen of nineteen tokens; SN.the_holy_people by CALL; treasured_people at Exod 19:5 unmoved): the ground of the cutting's bar, not a law — no write; the people chosen from all the peoples accepted", ['accepted'], [('INK', 'Deut 14:2 — "FOR YOU ARE A HOLY PEOPLE to the LORD your God, and the LORD has chosen you to be His treasured people" — the clause [\'Deut 14:2\', \'Deut 14:21\', \'Deut 7:6\'] (14:2, 14:21, 7:6); the shared run with 7:6 18 of 19 tokens; "treasure" in the Bible [\'1Chr 29:3\', \'Deut 7:6\', \'Deut 14:2\', \'Deut 26:18\', \'Eccl 2:8\', \'Exod 19:5\', \'Mal 3:17\', \'Ps 135:4\'] (Exodus 19:5 the first)'), ('MOVE', "cold_run_seven_nations (CALL) — SN.the_holy_people(holy_people) = a holy people (7:6) — 19:5-6's treasure and holy nation read back with; the tape (the recon): nations_devoted at Deut 7:1 (israel — FOUND by kind and first verse), covenant_offered at Exod 19:5; the Sifrei 97:1-3 — THE GROUND, NOT A LAW — 14:2 is 7:6 VERBATIM in kind (eighteen of nineteen tokens): the holiness the reason clause of the cutting's bar and of the carcass's (14:21 says it again, 104:7); treasured_people ON FILE ONCE at Exodus 19:5 (a heaven entry) UNMOVED — no write here; 'sanctify yourself' and 'the holiness that is upon you caused it' (97:1)"), ('DATA', "the holy people a DATA row (the_holy_people — 14:2 = 7:6 eighteen of nineteen; the three seats of the clause); treasured_people ONE UNMOVED (DF5); the readback row 14:2 VERBATIM in kind (nations_devoted Deut 7:1; SN by CALL); the exam's person the people chosen from all the peoples — accepted")])
FACT food_tithe.the_sons_and_the_cuttings(the_mourner_who_cuts) = ('the mourner who cuts himself (14:1) — flogged (Mishnah Makkot 3:5; one cut for five dead, five cuts for one dead — each liable, Makkot 21a:1): lashes', ['lashes'], [('INK', 'Deut 14:1 — "you shall not cut yourselves" — the negation pair in the verse [\'לא\', \'ולא\']; the reflexive stem [(\'תתגדדו\', \'HVri2mp\')]'), ('MOVE', "Mishnah Makkot 3:5 (read whole at the docket); Makkot 20b:11, 21a:1 (read whole at the docket); cold_run_holiness_b (CALL) — HB.body(gash_for_dead) = for_the_dead_only — THE MOURNER WHO CUTS HIMSELF IS FLOGGED — Mishnah Makkot 3:5: one who makes a cut for the dead; ONE CUT FOR FIVE DEAD, FIVE CUTS FOR ONE DEAD — liable for each (21a:1; 20b:11 the count per soul and per cut); the gash 'for a soul' (Leviticus 19:28 by CALL — for the dead only)"), ('DATA', "the exam's person the mourner who cuts himself for the dead — LASHES (Mishnah Makkot 3:5); the count per cut and per soul a DATA row")])
