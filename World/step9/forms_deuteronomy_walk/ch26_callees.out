FACT food_tithe.the_third_year(the_resident_alien_at_the_gate) = ("the resident alien at the gate (14:21, 14:29) — 14:21's person, sustained with the carcass, not among the four in want (SA.carcass 'who', HO.gifts 'recipients' by CALL): the resident alien at the gate exempt from the poor man's tithe", ['exempt'], [('INK', 'Deut 14:21, 14:29 — "to the sojourner in your gates you may give it" (14:21) against "the sojourner … who are in your gates" (14:29) — "in your gates" at both [21, 27, 28, 29]'), ('MOVE', "Pesachim 21b:9 (the resident alien sustained); cold_run_sanctions (CALL) — SA.carcass(who) = citizen_and_convert_not_the_resident_alien; cold_run_holiness (CALL) — HO.gifts(recipients) = the_poor_and_the_convert_not_the_resident_alien — THE RESIDENT ALIEN AT THE GATE — 14:21's person eats the carcass (sustained — Pesachim 21b:9), not the poor man's tithe: outside 'the citizen and the convert' (SA.carcass 'who' by CALL) and outside the gifts' recipients (HO.gifts by CALL — not the resident alien): the two persons by their seats"), ('DATA', "the exam's person the resident alien at the gate — EXEMPT from the poor man's tithe (14:21's person, not 14:29's)")])
