FACT second_tablets.the_god_of_gods_and_the_stranger(the_orphan_and_the_widow) = ("the orphan and the widow (10:18) — Exodus 22:21's pair in the other order (OR.stranger('widow_orphan_scope') by CALL — all persons or the named): a declaration about God, the readback row VARIANT; no write", ['accepted'], [('INK', 'Deut 10:18 — "HE EXECUTES THE JUDGMENT OF THE ORPHAN AND THE WIDOW, AND LOVES THE STRANGER, GIVING HIM BREAD AND CLOTHING" — "executes the judgment of the orphan and the widow" the one seat [\'Deut 10:18\']; "orphan and widow" this order [\'Deut 10:18\', \'Deut 27:19\'], "widow and orphan" Exodus 22:21\'s [\'Exod 22:21\']; "and loves the stranger" [\'Deut 10:18\']; "bread and clothing" [\'Deut 10:18\'] (Jacob\'s vow Genesis 28:20 the kin); the shared run with Exodus 22:20-22 NOTHING [0, 0, 0]; the participles at 10:18 [\'עשה\', \'ואהב\']'), ('MOVE', "cold_run_ordinances (CALL) — OR.stranger(widow_orphan_scope) = R_Yishmael_all_persons_R_Akiva_the_named — Exodus 22:21's 'every widow and orphan you shall not afflict' — R. Yishmael: all persons (the widow and the orphan named for their weakness); R. Akiva: the named alone — the pair's other order here, God the executor"), ('DATA', 'the readback row 10:18 VARIANT by CALL — a declaration about God (the participles), no write; Onkelos "עבד דין יתם וארמלא" (executes the judgment of the orphan and the widow)')])
