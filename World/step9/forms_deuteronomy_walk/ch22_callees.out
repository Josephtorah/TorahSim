CELL courts_prophet.the_blemished_sacrifice: asks 6 ['the_south_and_the_blemish', 'the_three_true_prohibitions', 'born_blemished_and_any_evil_thing', 'outside_its_time_and_place', 'the_mounter_and_the_harlots_hire', 'the_sacrifice_not_the_sacrificer'] | keys 0 []
FACT courts_prophet.the_blemished_sacrifice(the_mounter_and_the_harlots_hire) = ("the mounter and the harlot's hire (17:1) — nine disqualified by 'abomination' (the Sifrei 147:6; 14:3 and 23:19 the shared word — 99:2, 261:2), the offspring not (R. Judah): the one who offers the dog's price barred from it", ['barred_from_it'])
FACT courts_prophet.the_blemished_sacrifice(the_sacrifice_not_the_sacrificer) = ("the sacrifice, not the sacrificer (17:1) — 'it' limits the abomination to the animal (the Sifrei 147:7): the transgressor who brings a whole beast accepted under this verse", ['accepted'])
