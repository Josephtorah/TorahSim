FACT place_name.the_nations_cut_off_and_the_abomination(lest_you_inquire_after_their_gods) = ("lest you inquire after their gods (12:30) — the inquiry itself barred, 'how did these nations serve?' (the Sifrei 81:2-4); 23:24's 'not after their deeds' (OR.land by CALL): THE WRITE foreign_rite_inquiry_barred — a BLOCK on Israel at the chapter's own day (THE LINE nations_cut_off_warned); the readback row SUPPLIED AS A LAW with its write", ['foreign_rite_inquiry_barred'])
FACT place_name.the_nations_cut_off_and_the_abomination(their_sons_and_their_daughters) = ("their sons and their daughters (12:31) — 'even' includes the parents (the Sifrei 81:6); the children in the fire the Molech's kin; the persecution's edges (Sanhedrin 74b:1-9 — the limb of a living animal among the seven): the one who burns his son accepted against", ['accepted'])
