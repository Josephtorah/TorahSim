  Deut 6:25 (15) vs Deut 24:13 (16): [replace: 'וצדקה' -> 'השב תשיב לו את העבוט כבא השמש ושכב בשלמתו וברכך ולך'] =תהיה [replace: 'לנו כי נשמר לעשות את כל המצוה הזאת' -> 'צדקה'] =לפני יהוה [replace: 'אלהינו כאשר צונו' -> 'אלהיך']
  Deut 6:25 (15) vs Deut 5:32 (11): [replace: 'וצדקה תהיה לנו כי נשמר' -> 'ושמרתם'] =לעשות [replace: 'את כל המצוה הזאת לפני' -> 'כאשר צוה'] =יהוה [replace: 'אלהינו כאשר צונו' -> 'אלהיכם אתכם לא תסרו ימין ושמאל']
