blessing_and_curse : CH33_RAIN = ('the_lord_came_from_sinai_seir_paran_declared',)   # THE DEUTERONOMY WALK 21b (2026-09-29; LEAN): chapter 33's name whose letters spell the rain — mount PARAN (33:2 'He shone from mount Paran', the theophany
    _rs = ledger_scan('israel_people', RAIN_WORDS); RAIN_SCAN = None if _rs is None else [e for e in _rs if e not in OWN5 and e not in CH28_RAIN and e not in CH32_RAIN and e not in CH33_RAIN]   # this sitting's own five excluded once the fold carries them   # THE DEUTERONOMY WALK 18b (2026-09-26; LEAN):
SCANS WIDENED 1
