            move('Mishnah Sotah 7:6; Mishnah Tamid 7:2; Sotah 38a; Sifrei 39:1', 'in the Temple one blessing, the Name as written, the hands above the head (the High Priest not above the frontplate; R. Yehuda 

  naso.blessing({ask:counts})                                    ('3, 5, 7 words; 15, 20, 25 letters; the Name thrice', ['blessed_by_the_priests'])
  naso.blessing({ask:face_lifted})                               ('when they do His will (the Sifrei) / beyond the letter (Berakhot 20b) / before the sentence (Niddah 70b) — three reconciliations', ['blessed_by_the_priests'])
