FACT musafim.sukkot(stay) = ('an assembly — withheld overnight after the festival', ['exempt'], [('INK', 'Num 29:35 — "an assembly (atzeret)" — the word\'s Torah seats: Lev 23:36, here, Deut 16:8 (Pesach\'s seventh)'), ('MOVE', 'Sifrei 151:1; Chagigah 17a:9, 17b:1; Pesachim 95b:6-8 — "withheld" — the overnight stay after the festival: Pesach\'s "you shall turn in the morning" carried to Sukkot by Deut 16:16; Chagigah 18a:9 "atzeret = pause" at Deut 16:8'), ('DATA', 'the row atzeret_stay = lodging_required')])
