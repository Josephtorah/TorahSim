CELL refuge_war_family.the_priests_speech: asks 6 ['when_you_go_out_to_war', 'the_priest_anointed_for_war', 'hear_israel_the_fourth', 'the_four_exemptions', 'the_fearful_and_the_faint_of_heart', 'the_captains_and_the_guards'] | keys 0 []
FACT refuge_war_family.the_priests_speech(when_you_go_out_to_war) = ("when you go out to war (20:1) — against your enemies, not your brothers; horse and chariot as one; more in your eyes; fear them not — 7:18's rule paid to the war chapter (the Sifrei 190:16-21; Mishnah Sotah 8:1; seven_nations' accepted by CALL): THE WRITE war_fear_barred, a BLOCK on Israel at the chapters' own day; the soldier of Judah at war with Simeon barred from it", ['war_fear_barred'], [('INK', 'Deut 20:1 — "WHEN YOU GO OUT TO WAR AGAINST YOUR ENEMIES, and see horse and chariot, a people more than you, YOU SHALL NOT FEAR THEM, for the LORD your God is with you, WHO BROUGHT YOU UP FROM THE LAND OF EGYPT" — "when you go out to war against your enemies" at 20:1 and 21:10 alone (the reading\'s formula assert); "you shall not fear them" 20:1 and 7:18 alone — 6 tokens in order shared; "a people more than you" the Bible\'s one seat; the negation [\'לא\']; fear_not_promised FOUR (isaac, jacob, moses, yehoshua) THE TAPE\'S REFERENCES — heaven entries'), ('MOVE', "the Sifrei 190:16-21 (read whole at the reading — the piska running past its chapter's end); MISHNAH SOTAH 8:1 (the exam row, read whole); cold_run_seven_nations (CALL) — SN.do_not_fear(the_doubt) = ['accepted'], (remember_pharaoh) = ['accepted'] — 'WHEN YOU GO OUT TO WAR' — the whole soldier, not the blemished (190:16); the commanded war against the obligatory (190:17); 'AGAINST YOUR ENEMIES' — not your brothers: Judah not against Simeon, Simeon not against Benjamin, that if they fall into your hand you have mercy on them (Sotah 8:1 — 2 Chronicles 28:15's clothing of the captives, the Prophets' run citation); 'HORSE AND CHARIOT' — as one; 'A PEOPLE MORE THAN YOU' — in your eyes; 'FEAR THEM NOT' — 7:18's twin (seven_nations by CALL: the fear rule owed to the war chapter — PAID HERE); 'WHO BROUGHT YOU UP FROM EGYPT' — Onkelos 'HIS MEMRA (His Word) IS YOUR HELP' a DATA row"), ('DATA', "THE WRITE war_fear_barred — a BLOCK on israel_people at the chapters' own day (DJ2); the war's scope a DATA row (against your enemies, not your brothers; the whole soldier); Onkelos's Memra a DATA row; the exam's person the soldier of Judah in a war against Simeon who takes a captive of his brothers — barred from it")])
FACT refuge_war_family.the_priests_speech(the_priest_anointed_for_war) = ("the priest anointed for war (20:2) — the one appointed, not the high priest; in the holy tongue; Phinehas at Numbers 31:6 (the Sifrei 191:1; Mishnah Sotah 8:1; midian's accepted by CALL): THE WRITE priest_war_speech_commanded, a STATUS on Israel at the chapters' own day; the high priest speaking in the anointed's place barred from it", ['priest_war_speech_commanded'], [('INK', 'Deut 20:2 — "AND IT SHALL BE, when you draw near to the battle, THE PRIEST SHALL APPROACH and speak to the people" — "the priest shall approach" the priest anointed for war (the Sifrei 191:1); Numbers 10:9\'s trumpets share no token with the priest\'s speech (0 — the reading\'s find: a new form)'), ('MOVE', "the Sifrei 191:1 (read whole at the reading); MISHNAH SOTAH 8:1 (the exam row); cold_run_midian (CALL) — MD.the_vengeance(phinehas_anointed_for_war) = ['accepted'], (the_trumpets) = ['accepted'] — 'THE PRIEST SHALL APPROACH' — might it be any priest? 'and speak to the people' — the one appointed for this: THE PRIEST ANOINTED FOR WAR, not the high priest (191:1); he speaks in the holy tongue (Sotah 8:1 — 'and he shall say' with 'and Moses said' at Exodus 19:19); Phinehas anointed for war at Numbers 31:6 with the trumpets in his hand (midian by CALL — the tape's own priest anointed for war)"), ('DATA', "THE WRITE priest_war_speech_commanded — a STATUS on israel_people at the chapters' own day (DJ2); THE PARAMETER the_priest_anointed_for_war (Sotah 8:1 — not the high priest; the holy tongue; Phinehas the tape's instance); the exam's person the high priest who speaks the war speech in place of the anointed — barred from it (not his office)")])
FACT refuge_war_family.the_priests_speech(hear_israel_the_fourth) = ("hear, Israel — the fourth (20:3-4) — the four fears against the four terrors; the Presence goes with you (the Sifrei 192:1-3, 193:1-6; Mishnah Sotah 8:1; the shema's line the reference): the soldier who stands at the horses' neighing accepted", ['accepted'], [('INK', 'Deut 20:3-4 — "HEAR, ISRAEL: you draw near this day to battle against your enemies; LET NOT YOUR HEART FAINT, FEAR NOT, NOR TREMBLE, NOR BE TERRIFIED before them, for the LORD your God goes with you to fight for you against your enemies, to save you" — "Hear, Israel" FOUR seats in the Bible, all in this book (5:1, 6:4, 9:1, 20:3 — the reading\'s find); 20:3 shares 2 with 6:4 (the shema — the tape\'s shema_declared the readback\'s REFERENCE) and 5 with 31:6\'s "fear not nor tremble"; 20:4 shares 5 with 1:30\'s "the LORD your God who goes before you"'), ('MOVE', "the Sifrei 192:1-3, 193:1-6 (read whole at the reading — 192 the variant piska heading on 20:8 out of verse order); MISHNAH SOTAH 8:1 (the exam row, read whole) — 'HEAR, ISRAEL' — even if you have fulfilled only the Shema you are worthy of His saving (Sotah 8:1 the English's note); THE FOUR FEARS AGAINST THE FOUR TERRORS: 'let not your heart faint' at the neighing of the horses and the whetting of the swords, 'fear not' at the clash of the shields and the tramp of the boots, 'nor tremble' at the sound of the trumpets, 'nor be terrified' at the shouts (Sotah 8:1 = 193:1-4); 'FOR THE LORD YOUR GOD GOES WITH YOU' — they come with flesh and blood, you with the Presence: the ark's camp (193:5); Goliath and Shobach fell by the sword (the Prophets' run citations — 1 Samuel 17, 2 Samuel 10; 193:6)"), ('DATA', "THE PARAMETER the_four_terrors (Sotah 8:1 — the four fears against the four sounds); the shema's fourth seat a DATA row (6:4's line the reference); the exam's person the soldier who hears the horses neigh and stands — accepted")])
FACT refuge_war_family.the_priests_speech(the_four_exemptions) = ("the four exemptions (20:5-7) — the house, the vineyard, the betrothed: who return (Sotah 8:2 — the straw house, the five trees, the widow) and who do not (Sotah 8:3 — the gatehouse, four trees, the remarried divorcee; R. Judah's and R. Eliezer's houses); the fourth year's redemption (the Sifrei 193:6-197:4): THE WRITE officers_exemptions_commanded, a STATUS on Israel at the chapters' own day; the builder of a gatehouse barred from the return", ['officers_exemptions_commanded'], [('INK', 'Deut 20:5-7 — "AND THE OFFICERS SHALL SPEAK to the people, saying: WHAT MAN has built a new house and not dedicated it? … planted a vineyard and not redeemed it? … betrothed a wife and not taken her? let him go and return to his house, LEST HE DIE IN THE BATTLE and another man dedicate it / redeem it / take her" — "the officers" at 20:5, 20:8, 20:9 in the Torah (the reading\'s formula assert); "lest he die in the battle" the three verses\' shared tail: 20:5 shares 11 tokens in order with 20:6 and 11 with 20:7 (the eight-word tail shared verbatim — the reading\'s find); "a new house" 20:5 and 22:8 alone'), ('MOVE', "the Sifrei 193:6, 194:1-2, 195:1-7, 196:1-3, 197:1-4 (read whole at the reading); MISHNAH SOTAH 8:2 and 8:3 (the exam rows, read whole) — SOTAH 8:2 — WHO RETURN: 'a new house' — the straw house, the cattle shed, the wood shed, the storehouse; the builder, the buyer, the heir, the gifted alike; 'a vineyard' — five fruit trees even of five kinds; the planter, the layerer, the grafter, the buyer, the heir, the gifted; 'betrothed a wife' — a virgin, a widow, even the levirate widow, even one who heard his brother died in the war; ALL THESE HEAR THE PRIEST'S WORDS AND RETURN, and supply water and food and repair the roads. SOTAH 8:3 — WHO DO NOT RETURN: the gatehouse, the veranda, the balcony; four fruit trees or five barren; the remarried divorcee; the widow to a high priest, the divorcee or the released levirate widow to a common priest, a mamzeret (a woman born of a forbidden union) or a Gibeonite to an Israelite, an Israelite's daughter to the same — these do not return; R. Judah the house rebuilt on its site does not return, R. Eliezer the brick house in the Sharon does not return; 'AND NOT REDEEMED IT' — the vineyard's fourth year, Leviticus 19:24's redemption (196:1 — holiness by name in the ledger's row, the seat's cell not called: a DATA row)"), ('DATA', "THE WRITE officers_exemptions_commanded — a STATUS on israel_people at the chapters' own day (DJ2); THE PARAMETERS the_houses_kinds, the_vineyards_kinds, the_betrotheds_kinds (Sotah 8:2) and the_non_returners (Sotah 8:3); the exam's person the man who built a gatehouse — does not return (Sotah 8:3): barred from the return; the builder of a straw house returns")])
FACT refuge_war_family.the_priests_speech(the_fearful_and_the_faint_of_heart) = ("the fearful and the faint of heart (20:8) — as it sounds (R. Akiva), the sinner hidden among the others (R. Yose the Galilean), the forbidden unions' betrothed (R. Yose): three arms (the Sifrei 197:2-4; Mishnah Sotah 8:5): THE WRITE fearful_exemption_commanded, a STATUS on Israel at the chapters' own day; the soldier who cannot see a drawn sword accepted for the return", ['fearful_exemption_commanded'], [('INK', 'Deut 20:8 — "AND THE OFFICERS SHALL SPEAK FURTHER to the people and say: WHAT MAN IS FEARFUL AND FAINT OF HEART? let him go and return to his house, lest his brothers\' heart melt as his heart" — "the fearful and faint of heart" the Bible\'s one seat (the reading\'s formula assert); the negation [\'ולא\']'), ('MOVE', "the Sifrei 197:2-4 (read whole at the reading); MISHNAH SOTAH 8:5 (the exam row, read whole) — MISHNAH SOTAH 8:5 — R. AKIVA: 'fearful and faint of heart' as it sounds, he cannot stand in the battle's ranks and see a drawn sword; R. YOSE THE GALILEAN: the fearful of the transgressions in his hand — and therefore the Torah hung all these others on him, that he return among them; R. YOSE: the widow to a high priest, the divorcee to a common priest, the mamzeret (a woman born of a forbidden union) to an Israelite — this is the fearful and faint of heart: THREE ARMS on the Mishnah's own row (197:2-4); 'lest his brothers' heart melt' — the fear contagious (197:4)"), ('DATA', "THE WRITE fearful_exemption_commanded — a STATUS on israel_people at the chapters' own day (DJ2); THE PARAMETER the_fearful (Sotah 8:5 — three arms: as it sounds; the sinner; the forbidden unions' betrothed); the exam's person the soldier who cannot see a drawn sword — returns by R. Akiva's arm: accepted for the return")])
FACT refuge_war_family.the_priests_speech(the_captains_and_the_guards) = ("the captains and the guards (20:9) — captains at the head and the rear, guards with iron mallets before and behind, the flight's beginning a fall; the optional war against the commanded (the Sifrei 198:1; Mishnah Sotah 8:6): THE WRITE captains_appointed_commanded, a STATUS on Israel at the chapters' own day; the guard who breaks the deserter's legs accepted", ['captains_appointed_commanded'], [('INK', 'Deut 20:9 — "AND IT SHALL BE, when the officers have finished speaking to the people, that THEY SHALL APPOINT CAPTAINS OF HOSTS at the head of the people" — "captains of hosts" at 20:9 and 1 Kings 2:5 alone (the reading\'s formula assert — Joab\'s title the Prophets\' run citation)'), ('MOVE', "the Sifrei 198:1 (read whole at the reading); MISHNAH SOTAH 8:6 (the exam row, read whole) — MISHNAH SOTAH 8:6 — 'captains of hosts at the head of the people' AND AT THE REAR: they station guards before them and behind them WITH IRON MALLETS in their hands, and whoever seeks to turn back, the guard is licensed to break his legs — for the beginning of flight is a fall (1 Samuel 4:17, 31:1 — the Prophets' run citations); TO WHAT DOES ALL THIS APPLY? to an optional war; but in a commanded war all go out, even the bridegroom from his chamber and the bride from her canopy (198:1 — against 190:17's 'commanded against the obligatory': the vocabulary's dispute inside one spine a DATA row)"), ('DATA', "THE WRITE captains_appointed_commanded — a STATUS on israel_people at the chapters' own day (DJ2); THE PARAMETER the_guards (Sotah 8:6 — before and behind, the iron mallets, the legs broken); THE PARAMETER the_wars_kinds (the optional against the commanded — the bridegroom and the bride); the exam's person the soldier who turns back in an optional war — his legs broken by the guard: the guard accepted")])
DATA KEYS refuge_war_family ~ fear|priest|speech: ['the_priest_anointed_for_war', 'the_fearful', 'the_hear_and_fear_seats', 'the_priests_saying']
