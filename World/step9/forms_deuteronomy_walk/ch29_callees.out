FACT blessing_and_curse.the_blessing_and_the_curse(the_blessing_if) = ("the blessing if (11:27) — 'the blessing, if you hearken' the pair's first arm: 7:12's conditional by CALL (SN.because_you_hear('covenant_kept')): the readback row VARIANT; the crossroads (the Sifrei 53:1); one commandment tilts the world to merit (Kiddushin 40b:2)", ['accepted'], [('INK', 'Deut 11:27 — "THE BLESSING, IF YOU HEARKEN to the commandments of the LORD your God which I command you this day" — the clause the one seat [\'Deut 11:27\']; "to the commandments of the LORD your God" the two seats [\'Deut 11:27\', \'Deut 11:28\'] (11:27, 11:28); "which I command you this day" plural the book\'s seats [\'Deut 11:13\', \'Deut 11:27\', \'Deut 11:28\', \'Deut 27:1\', \'Deut 27:4\', \'Deut 28:14\']; the shared run with 11:28 10'), ('MOVE', "cold_run_seven_nations (CALL) — SN.because_you_hear(covenant_kept) = the covenant kept (7:12) — 19:5's condition read back as 'be; the Sifrei 53:1 (read whole at the reading) — 19:5's condition read back at 7:12 'because you hear', the covenant kept by God; the Sifrei 53:1 — the crossroads: the one who sits at the parting of the ways and warns of the thorns; 'the blessing if you hearken' the pair's first arm; the mishna's scale — one commandment tilts the world to merit (Kiddushin 40b:1-2, read whole at the docket)"), ('DATA', 'the readback row 11:27 — VARIANT by CALL (SN.because_you_hear); the pair\'s first arm; Onkelos "ית ברכן אם תקבלון" (the blessings, if you accept)')])
FACT blessing_and_curse.the_blessing_and_the_curse(the_curse_if) = ("the curse if (11:28) — 'turn aside from the way' 9:12's calf (NR by CALL), 'not hearken' 8:20's (GL.the_testimony by CALL), 'other gods whom you have not known' 13:3's phrase: the readback row VARIANT; idolatry the whole Torah's denial (the Sifrei 54:4; the ceremony's first curse) — the idolater who says he keeps the rest accepted against", ['accepted'], [('INK', 'Deut 11:28 — "AND THE CURSE, IF YOU DO NOT HEARKEN to the commandments of the LORD your God, and TURN ASIDE FROM THE WAY which I command you this day, TO GO AFTER OTHER GODS whom you have not known" — the clause [\'Deut 11:28\']; "turn aside from the way" the seats [\'Deut 11:28\', \'Deut 31:29\'] (9:12, 9:16 the calf\'s); "to go after other gods" the three seats [\'Deut 11:28\', \'Deut 28:14\', \'Judg 2:19\'] (28:14, Judges 2:19); "other gods whom you have not known" the four seats [\'Deut 11:28\', \'Deut 13:14\', \'Deut 13:3\', \'Jer 7:9\'] (13:3, 13:14 the seducer\'s and the seduced city\'s; Jeremiah 7:9); the shared run with 28:14 9, 13:3 7'), ('MOVE', "cold_run_good_land (CALL) — GL.the_testimony(hearken_plural) = hearken, plural (8:20) — 'the voice of the LORD your God' pl; cold_run_not_righteousness (CALL) — NR.the_frame(nations_greater) = nations greater and mightier than you (9 — 8:20's 'not hearken to the voice' the frame's close and 9:12's 'they have turned aside quickly from the way' the calf's own clause: the readback row 11:28 VARIANT by CALL; the Sifrei 54:4 (read whole at the reading) — whoever serves idols denies the whole Torah, IDOLATRY THE WHOLE TORAH'S DENIAL; the ceremony's first curse on the graven image (Sotah 37a:11; Mishnah Sotah 7:5)"), ('DATA', 'the readback row 11:28 — VARIANT by CALL (GL.the_testimony, NR.the_frame); the exam\'s person the idolater who says he keeps the rest — the whole Torah denied (54:4): accepted against; Onkelos "ותסטון מן אורחא" (and you turn aside from the way)')])
FACT blessing_and_curse.the_blessing_and_the_curse(keep_to_do) = ("keep to do (11:32) — 'keep to do all the statutes and the judgments which I set before you today' the one seat: 4:8's pair (OH.the_exhortation('righteous_statutes') by CALL — the cell names 11:32): the readback row VARIANT; 12:1 reopens the statutes; the portion's edge inside the chapter", ['accepted'], [('INK', 'Deut 11:32 — "and you shall KEEP TO DO all the statutes and the judgments which I set before you today" — the clause the one seat [\'Deut 11:32\']; "the statutes and the judgments" with the article [\'1Chr 22:13\', \'2Kgs 17:37\', \'Deut 11:32\', \'Deut 5:1\', \'Deut 7:11\', \'Neh 1:7\'] (5:1, 7:11 the book\'s; 1 Chronicles 22:13 David\'s charge); "which I set before you today" — 4:8\'s pair, 12:1\'s "these are the statutes" reopens; the shared run with 5:1 7, 7:11 7'), ('MOVE', "cold_run_obey_horeb (CALL) — OH.the_exhortation(righteous_statutes) = righteous statutes (4:8) — the exhortation's close: the Torah set before them th — 4:8's 'righteous statutes and judgments as all this Torah which I set before you today' — the exhortation's close (the cell names 11:32 its pair): the readback row 11:32 VARIANT by CALL; the portion edge inside the chapter (Re'eh begins at 11:26 — the chapter the unit, per the ruling CHAPTER NUMBERS)"), ('DATA', 'the readback row 11:32 — VARIANT by CALL (OH.the_exhortation); 12:1 reopens the statutes — a DATA row; Onkelos "ותטרון למעבד" (and you shall keep to do)')])
FACT blessing_and_curse.the_blessing_and_the_curse(study_and_deed) = ("study and deed (11:13) — the loft at Lod: study is greater, for it leads to deed (Kiddushin 40b:8 — the Sifrei 41:12 at its Bavli seat); the Torah's precedence over the land laws counted on the clock (40b:9); the judgment and the reward begin with Torah (40b:11-12): the scholar who says study is greater accepted", ['accepted'], [('INK', 'Deut 11:13 — "to love the LORD your God and to serve Him" — the Sifrei 41:12 reads the study before the deed from the paragraph\'s "to love" (the love the study\'s fruit); "which I command you" the book\'s form'), ('MOVE', "Kiddushin 40b:8, 40b:9, 40b:11-12 (read whole at the docket) — STUDY IS GREATER, FOR IT LEADS TO DEED — in the loft of Nit'za at Lod: R. Tarfon said the deed is greater, R. Akiva the study; all answered: THE STUDY IS GREATER, FOR IT LEADS TO THE DEED (40b:8 — the Sifrei 41:12's ruling at its Bavli seat); R. Yosei: the Torah preceded the dough-portion by forty years, the tithes by fifty-four, the sabbatical by sixty-one, the jubilee by a hundred and three (40b:9 — the land laws after the conquest and the division, counted on the clock); the judgment and the reward begin with Torah (40b:11-12)"), ('DATA', "the exam's row the loft at Lod — the scholar who says study is greater: accepted (the ruling); the Torah's precedence counted a DATA row (borders.the_land_and_its_fall by CALL for the division)")])
