FACT second_tablets.the_levites_separated(at_that_time_separated) = ("at that time the LORD separated the tribe of Levi (10:8) — the tape's levites_gathered (Exod 32:26-29, invested_office on the Levites at (1, 4, 17) — the calf's day) by kind: the readback row VERBATIM in kind; 'separated' the hiphil perfect at 10:8 and Numbers 16:9 alone; 'ark of the covenant' the book's form (a DATA row)", ['accepted'], [('INK', 'Deut 10:8 — "AT THAT TIME THE LORD SEPARATED THE TRIBE OF LEVI to carry the ark of the covenant of the LORD, to stand before the LORD to minister to Him and to bless in His name, TO THIS DAY" — "separated" the hiphil PERFECT at 10:8 and Numbers 16:9 ALONE [(\'Deut 10:8\', \'הבדיל\'), (\'Num 16:9\', \'הבדיל\')] (the lemma\'s twenty-two Torah seats); "the tribe of Levi" [\'1Chr 23:14\', \'Deut 10:8\'] (the seven seats of the tribe\'s two nouns); "to this day" the book\'s six 6; the shared run with 1 Chronicles 15:2 6, 23:13 6; "at that time" the chapter\'s second head'), ('DATA', 'THE TAPE\'S OWN ANSWER TO "AT THAT TIME" — levites_gathered (Exodus 32:26-29 + Yoma 66b:15 "fill your hand", subject the-levites, slain the-three-thousand) at day 894419 = (1, 4, 17), the breaking\'s day, with the WRITE invested_office on the-levites (value (1, 2)) and slain_by_sword on the three thousand: the erection\'s compile put the Levites\' investiture AT THE CALF (decision 5); the readback row 10:8 VERBATIM in kind by kind and first verse Exod 32:26; the-levites\' ledger 27 entries standing (DB6: no second write of the separation)'), ('MOVE', 'Numbers 16:9 (levites_rebuked on the tape — Num 16:8) — "is it a small thing to you that the God of Israel has SEPARATED you from the congregation of Israel" — the verb\'s other seat Moses\' rebuke of Korach — the separation read back at 10:8 as God\'s act \'at that time\'; Horayot 13a:18 (a priest precedes a Levite — 1 Chronicles 23:13\'s \'Aaron was separated\')'), ('DATA', 'the book\'s "ARK OF THE COVENANT of the LORD" (10:8, 31:9, 31:25-26; Joshua\'s four) against Exodus\'s "ark of the TESTIMONY" (26:33-34, 30:26, 40:3-5, 40:21) — a DATA row; Onkelos "אפריש יי ית שבטא דלוי" (the LORD set apart the tribe of Levi)')])
FACT second_tablets.the_levites_separated(to_carry_the_ark) = ("to carry the ark (10:8) — the Kohathites' charge (BM.kohath('order') by CALL — the priests cover, then the Kohathites carry) and the ark's bearers on the march (BH.march('ark_bearers') by CALL): the first office by CALL; levites_given (Num 3:5) the tape's seat", ['accepted'], [('INK', 'Deut 10:8 — "TO CARRY THE ARK OF THE COVENANT OF THE LORD" — "to carry the ark of the covenant of the LORD" [\'Deut 10:8\'] (31:25\'s Levites, Joshua\'s priests, David\'s Levites the run); the ark-lemma\'s book seats 10:1, 2, 3, 5, 8 and 31:9, 25, 26'), ('MOVE', "cold_run_bamidbar (CALL) — BM.kohath(order) = the priests cover, then the Kohathites carry; cold_run_beha (CALL) — BH.march(ark_bearers) = four bearers (two plurals) — THE FIRST OFFICE — the Kohathites carry the most holy things on the shoulder after the priests cover (Numbers 4:4-15; 3:31 the ark among the charges); the ark's bearers on the march (10:33 — 'the ark of the covenant of the LORD went before them', the Tosefta's war ark); charge_kept the cells' effect"), ('DATA', 'the readback row\'s first office by CALL — the tape\'s levites_given (Numbers 3:5-13 at (2, 2, 1): given_to_aaron, substituted_for_the_firstborn) the Numbers seat of the separation; Onkelos "למטל ית ארון קימא דיי" (to carry the ark of the covenant of the LORD)')])
FACT second_tablets.the_levites_separated(to_stand_and_minister) = ("to stand before the LORD to minister to Him (10:8) — the watch (KR.the_watch by CALL — the Levites' twenty-one places; given to the LORD, 18:6) and the rite (BH.levites_rite('given') by CALL): the second office by CALL; the song the service, sitting invalidates (Arakhin 11a:10; Zevachim 16a:13)", ['accepted'], [('INK', 'Deut 10:8 — "TO STAND BEFORE THE LORD TO MINISTER TO HIM" — "to minister to Him" [\'1Chr 15:2\', \'1Chr 23:13\', \'2Chr 29:11\', \'Deut 10:8\', \'Deut 21:5\', \'Ezek 40:46\', \'Isa 56:6\'] (the lemma\'s book seats [(\'Deut 10:8\', \'לשרתו\'), (\'Deut 17:12\', \'לשרת\'), (\'Deut 18:5\', \'לשרת\'), (\'Deut 18:7\', \'ושרת\'), (\'Deut 21:5\', \'לשרתו\')]: 10:8, 17:12, 18:5, 18:7, 21:5 — the priest\'s and the Levite\'s); "to stand" the standing the shelf reads (18:5 "to stand to minister")'), ('MOVE', "cold_run_korach (CALL) — KR.the_watch(watch_places) = 3 and 21 — the priests in three places, the Levites in twent; KR.the_watch(given_to_the_lord) = a gift, given to the LORD (18:6) — to the LORD, not to the priests (Si — THE SECOND OFFICE — the watch (Numbers 18:1-7: watch_owed on the Levites; the priests in three places, the Levites in twenty-one — Mishnah Middot 1:1); 'a gift, given to the LORD' (18:6) — the Levites given to the LORD, not to the priests"), ('MOVE', "cold_run_beha (CALL) — BH.levites_rite(given) = 'given, given' doubled at 3:9 and 8:16 — the Levites' rite (8:5-22 — levites_purified_and_given at (2, 2, 1): waved and given_to_aaron again) and their service from twenty-five (8:24-26)"), ('MOVE', "Arakhin 11a:10; Zevachim 16a:13; Pesachim 104a:10 (read whole at the docket) — 'TO STAND BEFORE THE LORD TO MINISTER TO HIM AND TO BLESS IN HIS NAME' — the service WITH the blessing: Arakhin 11a:10 reads the Levites' song as the service ('to minister' the song, since the blessing is beside it and is not itself 'service'); Zevachim 16a:13 — sitting invalidates ('to stand'); Pesachim 104a:10 — the three distinctions (priests, Levites, Israelites)"), ('DATA', 'the readback row\'s second office by CALL — the Levites\' 27 entries (charge_kept ×4, watch_owed, appointed_to_serve …) standing; Onkelos "למקם קדם יי לשמשותיה" (to stand before the LORD to minister to Him)')])
FACT second_tablets.the_levites_separated(to_bless_in_his_name) = ("to bless in His name (10:8) — the priestly blessing's cell (NS.blessing('name', 'counts') by CALL — the Name in the Temple, the substitute in the provinces): the third office by CALL; the standing and the lifted hands derived FROM THIS VERSE (Sotah 38a:5, 38a:8 — the juxtaposition named); the priest who blesses seated accepted against", ['accepted'], [('INK', 'Deut 10:8 — "AND TO BLESS IN HIS NAME" — "and to bless in His name" [\'1Chr 23:13\', \'Deut 10:8\'] (10:8 and 1 Chronicles 23:13 alone); "to bless in the name of the LORD" 21:5 [\'Deut 21:5\']; the blessing\'s form Numbers 6:23-27 (the three commands, the Name thrice)'), ('MOVE', "cold_run_naso (CALL) — NS.blessing(name) = the Name in the Temple, the substitute in the province; NS.blessing(counts) = 3, 5, 7 words; 15, 20, 25 letters; the Name thrice — the Name in the Temple, the substitute in the provinces (Mishnah Sotah 7:6 — the cell's DATA blessing_name_by_place); the three blessings' words and letters (3, 5, 7; 15, 20, 25), the Name thrice"), ('MOVE', "Sotah 38a:5, 38a:8 (read whole at the docket); Mishnah Sotah 7:6; Tosefta Sotah 7:5 — THE LEVITES' SEPARATION READ FOR THE BLESSING — R. Natan (38a:5): 'to minister to Him and to bless in His name' — as the service is STANDING, so the blessing is standing; 38a:8: the lifted hands from 'and Aaron lifted his hands toward the people and blessed them' (Leviticus 9:22) — 18:5's 'to stand to minister' juxtaposed through 10:8 to the blessing: THE JUXTAPOSITION NAMED, no code; the blessing's four times a day (Ta'anit 26b:17)"), ('DATA', 'the readback row\'s third office by CALL — blessed_the_people written twice on the tape (Exodus 39:42-43 by moses, Leviticus 9:22 by aaron); the exam\'s person the priest who blesses SEATED — the rule holds against him (standing like the service); Onkelos "ולברכא בשמיה" (and to bless in His name)')])
FACT second_tablets.the_levites_separated(which_time) = ("which time — 'at that time' at 10:8: the tape's own (1, 4, 17), the calf's day (Exodus 32:26-29 by Yoma 66b:15); the four shelf rows citing 10:8 (Horayot 13a:18; Zevachim 16a:13; Pesachim 104a:10; Ta'anit 26b:17) ask nothing of the time: a DATA row", ['accepted'], [('INK', 'Deut 10:8 — "AT THAT TIME" (10:8) after "at that time" (10:1 — the second ascent) — the retelling\'s dating word twice, no number; the book\'s fifteen seats; the Levites\' seats between the two tellings: Exodus 32:26-29 (the calf), Numbers 3:5-13 (the sanctuary\'s month), 8:5-22 (the rite), 18:1-7 (the watch after Korach)'), ('MOVE', "Horayot 13a:18; Zevachim 16a:13; Pesachim 104a:10; Ta'anit 26b:17 (the link rows, read whole at the docket) — the four rows citing 10:8 — a priest precedes a Levite (1 Chronicles 23:13's 'separated'), sitting invalidates, the three distinctions, the blessing's four times: NOT ONE ASKS WHICH TIME — the docket's question, asked by no row on the shelf"), ('DATA', 'THE TAPE\'S ANSWER STANDS UNASKED — invested_office on the Levites at the calf\'s day (1, 4, 17), the erection\'s reading of Yoma 66b:15 ("fill your hand", Exodus 32:29); the rows 10:8 VERBATIM in kind; "at that time" twice (10:1 the second ascent, 10:8 the calf\'s morrow — the tape\'s two days) a DATA row; the exam\'s person the one who asks which time — outside every row (a DATA row, not a verdict)')])
FACT second_tablets.the_levites_separated(levi_has_no_portion) = ("Levi has no portion (10:9) — the tape's portion_declared (Num 18:20-24: inheritance_barred on the Levites and on aaron, tithe_granted — KR.the_tithe by CALL) by kind: the readback row VERBATIM in kind ('the LORD is his inheritance' 10:9 and 18:2 the two seats; eight tokens shared); Onkelos the gifts", ['accepted'], [('INK', 'Deut 10:9 — "THEREFORE LEVI HAS NO PORTION NOR INHERITANCE WITH HIS BROTHERS; THE LORD IS HIS INHERITANCE" — "the LORD is his inheritance" [\'Deut 10:9\', \'Deut 18:2\'] (10:9 and 18:2 the two seats); "portion and inheritance" [\'Deut 10:9\', \'Deut 12:12\', \'Deut 14:27\', \'Deut 14:29\', \'Deut 18:1\', \'Gen 31:14\']; "with his brothers" the book\'s one [\'Deut 10:9\']; the portion-lemma\'s book seats [\'Deut 10:9\', \'Deut 12:12\', \'Deut 14:27\', \'Deut 14:29\', \'Deut 18:1\', \'Deut 18:8\', \'Deut 18:8\', \'Deut 32:9\']; the shared run with 18:2 8 [\'אחיו\', \'יהוה\', \'הוא\', \'נחלתו\', \'כאשר\', \'דבר\'], 18:1 5, Joshua 13:14 7'), ('MOVE', "cold_run_korach (CALL) — KR.the_tithe(confession) = given to the Levite = the first tithe; also given = terumah and the ti — the tithe the portion's substitute (18:21-24 — 'in exchange for their service'; the confession's seat 26:13); the tape's portion_declared (Numbers 18:20-24 at day 894824: inheritance_barred on aaron AND on the Levites, tithe_granted on the Levites) by kind and first verse Num 18:20"), ('DATA', 'the readback row 10:9 VERBATIM in kind — inheritance_barred ONE on the Levites and ONE on aaron, tithe_granted ONE UNMOVED (DB6); Onkelos supplies the gifts: "מתנן דיהב ליה יי אנון אחסנתיה" (the gifts the LORD gave him are his inheritance) at 10:9 as at 18:2')])
FACT second_tablets.the_levites_separated(as_the_lord_spoke_to_him) = ("as the LORD your God spoke to him (10:9) — the receipt's THIRD FORM ('spoke' — the finder scans two forms with 'commanded'; 4b's owed item stands): a run citation of portion_declared (Num 18:20), a pointer if the census demands it; the chapter's three receipt forms a DATA row", ['accepted'], [('INK', 'Deut 10:9 — "AS THE LORD YOUR GOD SPOKE TO HIM" — [\'Deut 10:9\'] (the one seat of the full form); "as He spoke to him" [\'1Kgs 5:26\', \'Deut 18:2\', \'Josh 13:14\'] (18:2, Joshua 13:14, 1 Kings 5:26); the receipt forms the finder scans: "as the LORD commanded" (10:5 — the two forms with the Name) — "SPOKE" the THIRD FORM the finder does not see (4b\'s owed item)'), ('DATA', 'the receipt\'s pointer — a RUN_CITATION of portion_declared (Numbers 18:20 "I am your portion and your inheritance") at Deut 10:9 IF the token census demands the AS_WHEN form (the design\'s prediction; the census decides — 4b\'s to 7b\'s lesson); the register\'s finder sees ONE receipt in the chapter (10:5), this one not: the third form OWED still to a gate sitting'), ('DATA', 'THE THREE RECEIPT FORMS OF THE CHAPTER a DATA row — 10:5 "as the LORD commanded me" (ACT), 10:9 "as the LORD your God spoke to him" (the finder\'s third form), 10:11 "which I swore to their fathers" (the oath\'s line by kind)')])
