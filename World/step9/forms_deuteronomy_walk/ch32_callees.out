FACT not_righteousness.the_four_provocations(taberah) = ("Taberah (9:22) — the tape's fire_of_the_lord_burned (Num 11:1; BH by CALL — fire_sank stands): the readback row VERBATIM in kind; NOT AMONG THE TEN TRIALS (Arakhin 15a:14) — a DATA row", ['accepted'], [('INK', 'Deut 9:22 — "and at TABERAH, and at Massah, and at Kibroth-hattaavah, you provoked the LORD" — Taberah\'s two Bible seats [\'Deut 9:22\', \'Num 11:3\'] (Numbers 11:3 the naming, here the retelling); "provoking" the participle [\'מקצפים\'] — the hiphil\'s third chapter seat'), ('MOVE', "cold_run_beha (CALL) — BH.taberah_and_quail(fire_at_edge) = the proselytes at the edge (Sifrei); the officers (R. Shimon; BH.taberah_and_quail(fire_sank) = sank at Moses' prayer — Numbers 11:1-3 — the fire at the edge of the camp (the proselytes / the officers), sunk at Moses' prayer: fire_sank a STATUS on Israel; the tape's fire_of_the_lord_burned (name Taberah, prayer 'Moses prayed') at Num 11:1, its marker M['taberah'] = the march + 3 (Ta'anit 29a:3)"), ('MOVE', "Arakhin 15a:14; Berakhot 32a:5 — THE TEN TRIALS WITH TABERAH NOT AMONG THEM — R. Yehuda's list (two at the sea, two with water, two with the manna, two with the quail, the calf, Paran): 9:22's first name is NOT counted — the retelling names a provocation the answer sheet's list does not (a DATA row the design did not predict); 32a:5's al-tikrei ('do not read') on Taberah's prayer — 'to' [el] read 'onto' [al]: Moses spoke impertinently"), ('DATA', 'the readback row 9:22 (Taberah) VERBATIM in kind — the tape\'s line by kind and first verse; fire_sank ONE on Israel UNMOVED; Onkelos "ובדלקתא" (and at the Burning) — the name TRANSLATED (9:22 and 28:22 the Aramaic token\'s two seats)')])
FACT not_righteousness.the_four_provocations(massah) = ("Massah (9:22) — the tape's named line at Exod 17:7 (HI by CALL — 6:16's seat): the readback row VERBATIM in kind; the fourth of the ten trials (Arakhin 15a:20)", ['accepted'], [('INK', 'Deut 9:22 — "and at MASSAH" — the name\'s five Bible seats [\'Deut 33:8\', \'Deut 6:16\', \'Deut 9:22\', \'Exod 17:7\', \'Ps 95:8\'] (Exodus 17:7 the naming; 6:16 "as you tested at Massah"; 33:8 the Levites\' blessing; Psalm 95:8); the tape\'s named line at Exodus 17:7 ("Massah and Meribah — testing and quarrel")'), ('MOVE', "cold_run_hear_o_israel (CALL) — HI.the_test_and_the_right(you_shall_not_test) = you shall not test (6:16) — Massah the tape's named line (Exodus 17:7), a run ci — 6:16's 'as you tested Him at Massah' — the tape's named line the seat both chapters reference (a run citation by name there; test_barred on Israel stands)"), ('MOVE', "Arakhin 15a:20 (credited) — the water's second — REPHIDIM: 'and there was no water for the people to drink' (Exodus 17:1), 'why do you test the LORD?' (17:2): the fourth of the ten trials, the chapter's second name"), ('DATA', 'the readback row 9:22 (Massah) VERBATIM in kind — the tape\'s named (Exod 17:7, by moses) by kind and first verse; rock_struck at 17:6 beside it; Onkelos "ובנסתא" (and at the Testing) — translated; the three names out of the tape\'s order (Massah first on the tape, second here)')])
FACT not_righteousness.the_four_provocations(kibroth_hattaavah) = ("Kibroth-hattaavah (9:22) — the tape's quail_and_plague (Num 11:31; BH by CALL — the graves): the readback row VERBATIM in kind; the second quail among the ten trials", ['accepted'], [('INK', 'Deut 9:22 — "and at KIBROTH-HATTAAVAH" — the name defective here and at Numbers 33:16-17 [\'Deut 9:22\', \'Num 33:17\', \'Num 33:16\'], plene at 11:34-35 [\'Num 11:34\', \'Num 11:35\'] (the naming\'s own verses); the lemma [\'6914+\']'), ('MOVE', "cold_run_beha (CALL) — BH.taberah_and_quail(graves) = Kibroth-hattaavah — the graves of lust — Numbers 11:34 — 'the graves of lust': the tape's quail_and_plague (11:31-35, graves Kibroth-hattaavah, the lusters buried) found by kind and first verse; the marker M['hazeroth'] after it (Ta'anit 29a:4)"), ('MOVE', "Arakhin 15a:14 — the quail's second — Kibroth-hattaavah the second quail among the ten trials (the fleshpot of Exodus 16:3 the first, 15b:2)"), ('DATA', 'the readback row 9:22 (Kibroth) VERBATIM in kind; Onkelos "ובקברי דמשאלי" (and at the graves of those who asked) — the name translated, the lust made an asking')])
FACT not_righteousness.the_four_provocations(kadesh_barnea) = ("Kadesh-barnea (9:23) — 1:26's 'you rebelled against the commandment' (OS by CALL); the tape's congregation_wept (Num 14:1) by kind: the readback row VARIANT; the tenth trial that sealed the sentence (Arakhin 15a:10)", ['accepted'], [('INK', 'Deut 9:23 — "and when the LORD sent you from KADESH-BARNEA, saying: go up and possess the land which I have given you — you rebelled against the commandment of the LORD your God, and you did not believe Him, nor hearkened to His voice" — Kadesh-barnea\'s eight seats 8; "go up and possess" (plural) one seat [\'Deut 9:23\'] against 1:21\'s singular [\'Deut 1:21\']; "you rebelled against the commandment" [\'Deut 1:26\', \'Deut 1:43\', \'Deut 9:23\'] (1:26, 1:43, 9:23 — the chapter\'s one plural "the LORD your God" [23]); "you did not believe Him" one seat [\'Deut 9:23\'] against 1:32\'s participle [\'Deut 1:32\']; "nor hearkened to His voice" [\'Deut 9:23\']; the shared runs — 1:26 5, Joshua 14:7 5'), ('MOVE', "cold_run_opening_speech (CALL) — OS.the_spies_read_back(the_murmuring) = the murmuring (1:27-28) — two words (Shevuot 47b:5; (the_presumption) = the presumption (1:41-44) — presumed_to_go_up and  — 1:26-28's rebellion and 1:41-44's presumption — the first form's rows on the same acts; 9:23 says 'you rebelled against the commandment' with 1:26's five tokens"), ('MOVE', "Arakhin 15a:6, 15a:10 (credited — the spies' docket) — 'they have tried Me NOW [zeh] ten times' (Numbers 14:22) — Reish Lakish: the sentence sealed FOR THIS sin, the spies' speech (the evil report, not the blasphemy — 15a:13): Kadesh = Paran, THE TENTH TRIAL that sealed the sentence"), ('DATA', 'the readback row 9:23 VARIANT — the tape\'s congregation_wept (Num 14:1-4, the night) by kind and first verse; decree_declared (14:26-35) the sentence UNMOVED; the marker M[\'spies_return\'] = (2, 5, 9) the Ninth of Av (Ta\'anit 29a:5-7); Onkelos "וסרבתון על גזרת מימרא דיי" (you rebelled against the decree of the Word of the LORD) at 1:43 and 9:23, "ולא הימנתון ליה" (you did not believe Him), "ולא קבלתון למימריה" (you did not accept His Word); "רקם גיאה" (Rekem Ge\'ah) for Kadesh-barnea')])
FACT not_righteousness.the_four_provocations(the_ten_trials) = ('the ten trials (Avot 5:4; Arakhin 15a:14; ES.trials by CALL) — four of the ten in the chapter (Massah, Kibroth, the calf, Kadesh); Taberah outside the list — the retelling names a provocation the answer sheet does not', ['accepted'], [('INK', 'Deut 9:7, 9:22-24 — "you provoked the LORD" (9:22) — the four names against the answer sheet\'s ten: Massah = the second water (Rephidim), Kibroth-hattaavah = the second quail, Horeb\'s calf (9:8), Kadesh = Paran — FOUR OF THE TEN in the chapter; Taberah OUTSIDE; the count\'s verse Numbers 14:22 ("these ten times")'), ('MOVE', "cold_run_exodus_story (CALL) — ES.trials(ten_list) = ('two_at_the_sea', 'two_at_the_water', 'two_at_the_manna', 'two_at_the_quail', 'one_at_the_calf', 'one_at_paran'); ES.trials(count_by_exodus) = 6 — Avot 5:4 ('with ten trials did our ancestors try God in the wilderness') and Arakhin 15a:14's list: two at the sea, two with water, two with the manna, two with the quail, one with the calf, one in Paran — six of them narrated by Exodus 19"), ('DATA', 'TABERAH OUTSIDE THE TEN — a DATA row the design did not predict: the retelling counts a provocation the list does not; Arakhin 15a:15-20 the trials\' seats (the sea\'s two, Marah, Rephidim); 9:7\'s "from the day you came out of Egypt" the span the list fills')])
