FACT seven_nations.DATA[the_name_from_under_heaven] = {'value': '{\'the_phrase\': [\'2Kgs 14:27\', \'Deut 25:19\', \'Deut 29:19\', \'Deut 7:24\', \'Deut 9:14\', \'Exod 17:14\', \'Gen 1:9\', \'Gen 6:17\'], \'amalek\': "Exodus 17:14 \'I will surely blot out the memory of Amalek from under heaven\' — blotting_sworn on the tape (exodus_story.amalek(\'blotting\') by CALL: open to Deuteronomy and Samuel); 25:19 forward", \'the_kings\': "7:24 \'he will give their kings into your hand\' — the eas', 'settings': {'the_cell': "F5 the_kings_and_the_name — the readback row 7:23-24 EXPANDED against 23:27 and 23:31 (ordinances.land('borders') by CALL); a DATA row"}}
