CELL seducers.the_inciter: asks 9 ['the_inciters_kin', 'entice_two_senses', 'the_entrapment', 'the_fifteen_utterances', 'the_five_prohibitions', 'the_courts_rule_inverted', 'the_hand_first', 'the_stoning_rite', 'the_execution_timing'] | keys 0 []
FACT seducers.the_inciter(the_inciters_kin) = ("the inciter's kin (13:7) — the brother by the father, the mother's son, the son and the daughter of any kind, the betrothed and the married, the convert, THE FATHER in 'as your own soul' (the Sifrei 87:4-11): THE LINE inciter_law_declared at the counter's day; the son who strikes his inciting father accepted (Sanhedrin 85b:2)", ['accepted'], [('INK', 'Deut 13:7 — "WHEN YOUR BROTHER, THE SON OF YOUR MOTHER, or your son or your daughter or THE WIFE OF YOUR BOSOM or YOUR FRIEND WHO IS AS YOUR OWN SOUL entices you" — "your brother the son of your mother" [\'Deut 13:7\']; "the wife of your bosom" [\'Deut 13:7\']; "your friend as your own soul" [\'Deut 13:7\']; "as your own soul" in the Bible [\'1Sam 18:1\', \'1Sam 18:3\', \'Deut 13:7\', \'Deut 23:25\']; 13:7\'s tokens 27, the register singular (0, 11)'), ('MOVE', "the Sifrei 87:4-11 (read whole at the reading); Sanhedrin 85b:2 (read whole at the docket) — THE INCITER'S KIN AN INCLUSION TABLE — 'your brother' by the father, 'the son of your mother' the mother's; 'your son' and 'your daughter' of any kind; 'the wife of your bosom' the betrothed and the married; 'your friend' the convert; 'as your own soul' — THE FATHER (87:4-11: the closest kin named so that the farthest is included); the son as the court's agent against his inciting father — 'neither spare nor conceal him' (85b:2 — Rabba bar Rav Huna and R. Yishmael's school)"), ('DATA', "THE LINE inciter_law_declared — STATUTE by form at the counter's day (40, 11, 1), NO marker; the readback row 13:7 SUPPLIED AS A LAW (the first seat — the line's own; the second word by CALL); the inclusion table a DATA row (the_inciters_kin); the exam's person the son who strikes his inciting father — the agent permitted: accepted (85b:2)")])
FACT seducers.the_inciter(gods_you_have_not_known) = ('no verdict in span', ['—'], [])
FACT seducers.the_inciter(near_or_far) = ('no verdict in span', ['—'], [])
CELL seducers.the_whole_offering_the_heap_and_the_mercy: asks 9 ['the_whole_offering', 'heavens_spoil', 'the_heap_forever', 'nothing_shall_cleave', 'the_citron_of_a_condemned_city', 'the_devoted_things_lashes', 'the_anger_keyed_to_idolatry', 'the_mercy_two_armed', 'as_he_swore_to_your_fathers'] | keys 0 []
FACT seducers.the_whole_offering_the_heap_and_the_mercy(the_anger_keyed_to_idolatry) = ("the anger keyed to idolatry (13:18) — 'as long as idolatry is in the world, fierce anger is in the world' (the Sifrei 96:3; Mishnah Sanhedrin 10:6; Sanhedrin 113b:2-3); Peor's hanging_commanded on the tape by kind (BK.peor by CALL), Achan's valley the run's: the one who keeps the devoted thing while the anger stands accepted against", ['accepted'], [('INK', 'Deut 13:18 — "that the LORD may TURN FROM THE FIERCENESS OF HIS ANGER" — the clause [\'Deut 13:18\']; "from the fierceness of His anger" the Bible\'s four [\'2Kgs 23:26\', \'Deut 13:18\', \'Jonah 3:9\', \'Josh 7:26\'] (Joshua 7:26 Achan\'s valley says the words back [\'וישב\', \'יהוה\', \'מחרון\', \'אפו\']); Numbers 25:4\'s "the fierce anger of the LORD turned from Israel" [\'וישב\', \'חרון\', \'אף\', \'יהוה\', \'מישראל\']; Exodus 32:12\'s "turn from Your fierce anger" the calf\'s'), ('MOVE', "the Sifrei 96:3 (read whole at the reading); Mishnah Sanhedrin 10:6 at 111b:13; Sanhedrin 113b:2-3 (read whole at the docket); cold_run_balak (CALL) — BK.peor(anger_third) = the third anger (25:3) — its mark the plague, stay, BK.peor(hang_before_the_sun) = 'hang them before the sun' — the heads installed a; the tape (the recon): hanging_commanded at Num 25:4 (FOUND by kind and first verse; mark_of_anger on Israel the status) — THE ANGER KEYED TO IDOLATRY'S PRESENCE — 'as long as idolatry is in the world, fierce anger is in the world' (96:3); as long as the wicked are in the world, fierce anger is in the world; when the wicked perish from the world, fierce anger departs (Mishnah 10:6 at 111b:13; 113b:2-3 — R. Shimon ben Yochai); Peor's anger (Numbers 25:4 by kind — the hanging before the sun, BK by CALL) and Achan's valley (Joshua 7:26 — 'and the LORD turned from the fierceness of His anger') the run's cases: the condition in devoted_thing_cleaving_barred's value, no write of its own"), ('DATA', "the anger keyed to idolatry a DATA row (the_anger_keyed — the condition; the four Bible seats of the clause); the readback row 13:18's anger by kind (hanging_commanded Num 25:4) — no second mark_of_anger; the exam's person the one who keeps the devoted thing while the anger stands — accepted against (96:3)")])
FACT seducers.the_whole_offering_the_heap_and_the_mercy(the_mercy_two_armed) = ("the mercy two-armed (13:18) — as you have mercy on creatures, Heaven has mercy on you (the Sifrei 96:4; Shabbat 151b:14; the three marks Yevamot 79a:3; Beitzah 32b:4; Tosefta Sotah 10:1): a promise's arm, a DATA row with no write; the merciful man accepted", ['accepted'], [('INK', 'Deut 13:18 — "and GIVE YOU MERCY, AND HAVE MERCY ON YOU and multiply you" — the clause [\'Deut 13:18\']; "give you mercy" the kin [\'Gen 43:14\', \'Jer 42:12\'] (Genesis 43:14 Jacob\'s "give you mercy before the man"); "have mercy on you" the book\'s two [(\'Deut 13:18\', \'ורחמך\'), (\'Deut 30:3\', \'ורחמך\')]; "multiply you" [\'Deut 13:18\', \'Deut 30:5\', \'Deut 7:13\']'), ('MOVE', "the Sifrei 96:4 (read whole at the reading); Shabbat 151b:14; Yevamot 79a:3; Beitzah 32b:4; Tosefta Sotah 10:1 (read whole at the docket) — THE MERCY TWO-ARMED — Rabban Gamliel son of Rabbi: whoever has mercy on creatures is shown mercy from Heaven; whoever has no mercy on creatures is shown none (96:4; Shabbat 151b:14); THE THREE MARKS of the nation — the merciful, the bashful, the doers of kindness (Yevamot 79a:3); the wealthy without compassion are not Abraham's seed but the mixed multitude (Beitzah 32b:4); the righteous and mercy (Tosefta Sotah 10:1): a promise's arm, not a law's — A DATA ROW, NO WRITE"), ('DATA', 'the mercy two-armed a DATA row (the_mercy_two_armed — no write: a promise\'s arm); Jacob\'s "give you mercy" (Genesis 43:14) a DATA row; the exam\'s person the merciful man shown mercy from Heaven — accepted (96:4)')])
FACT seducers.the_whole_offering_the_heap_and_the_mercy(as_he_swore_to_your_fathers) = ("as He swore to your fathers (13:18) — the oath's AS_WHEN form: the patriarchs' oath lines by kind (SN.the_holy_people by CALL), the fathers' merit (the Sifrei 96:5 — NR.the_intercession by CALL, 7b's parameter): the pointer row at 13:18, a RUN_CITATION if the census demands; the one who pleads the fathers' merit accepted", ['accepted'], [('INK', 'Deut 13:18 — "AS HE SWORE TO YOUR FATHERS" — the clause\'s Deuteronomy seats [\'Deut 13:18\', \'Deut 19:8\'] (13:18, 19:8); "as He swore" in the book 4; the parser reads NO number at 13:18 (the dump\'s bare check matched the seven inside the oath\'s root) []; "swore" the niphal perfect [(\'נשבע\', \'HVNp3ms\')]'), ('MOVE', "cold_run_seven_nations (CALL) — SN.the_holy_people(the_oath) = the oath (7:8) — the noun starred by the parser, the swearin; cold_run_not_righteousness (CALL) — NR.the_intercession(remember_your_servants) = remember Your servants (9:27) — 32:13's plea with Jacob for ; the Sifrei 96:5; the register's finder (the reading): the oath's AS_WHEN form, no receipt with the Name — 'AS HE SWORE TO YOUR FATHERS' THE OATH'S AS_WHEN FORM — the patriarchs' oath lines on the tape by kind (SN.the_holy_people('the_oath') by CALL — the three lines, the pointers at 7:8, 12, 13); the merit of the fathers — 'not for your sake but for your fathers' (96:5 — 7b's PARAMETER by CALL: NR.the_intercession's four settings); THE POINTER at 13:18 in the readback row — a RUN_CITATION of the oath IF the census demands it (the dispositions filed at the tail; 4b's to 10b's lesson: the census decides)"), ('DATA', 'the readback row 13:18\'s POINTER (pointer="Deut 13:18" — the oath\'s AS_WHEN form; RUN_CITATION if the census demands); the fathers\' merit a DATA row (7b\'s parameter by CALL — the four settings); the exam\'s person the one who pleads the fathers\' merit for the city\'s mercy — accepted (96:5)')])
FACT seducers.DATA[the_inciters_kin] = {'value': '{\'the_table\': [\'the brother by the father\', "the mother\'s son", \'the son and the daughter of any kind\', \'the betrothed and the married\', \'the convert\', "the father in \'as your own soul\'"], \'the_son_against_the_father\': \'the agent permitted (Sanhedrin 85b:2)\'}', 'settings': {'the_source': 'the Sifrei 87:4-11 (F3 the_inciters_kin)'}}
FACT seducers.DATA[the_five_prohibitions] = {'value': '{\'consent\': "against \'love your neighbor as yourself\' (89:1 — Leviticus 19:18)", \'hearken\': "against the enemy\'s ass (89:2 — Exodus 23:5)", \'pity\': "7:16\'s clause reused (pity_barred\'s second entry)", \'spare\': "against \'you shall not stand by your neighbor\'s blood\' (89:3 — Leviticus 19:16)", \'conceal\': \'the defense and the silence barred (89:4-5)\', \'the_negations\': 5}', 'settings': {'the_source': 'the Sifrei 89:1-5 (F3 the_five_prohibitions)'}}
FACT seducers.DATA[the_signs_status] = {'value': '{\'r_yosei_hagelili\': "THE DOMINION — the Torah gave the false prophet dominion in idolatry\'s matter: the sign REAL, and even if he stops the sun in mid-sky, do not heed him (the Sifrei 84:1; Sanhedrin 90a:10 — R. Abbahu in R. Yochanan\'s name: a prophet who says \'violate the Torah provisionally\' is heeded, EXCEPT for idolatry)", \'r_akiva\': "THE FALLEN PROPHET — Heaven forfend that the sun be stoppe', 'settings': {'the_source': "calendar_parameters.yaml the_signs_status — R. Yosei HaGelili's dominion (the Sifrei 84:1; Sanhedrin 90a:10) / R. Akiva's fallen prophet (84:2; 90a:11 — Hananiah); either arm the hearing barred (F2 th"}}
