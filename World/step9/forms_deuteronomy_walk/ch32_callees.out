FACT courts_prophet.the_idolaters_trial(found_means_witnesses) = ("found means witnesses (17:2) — 'when there is found' by two or three witnesses, 19:15's building from a father (the Sifrei 148:1; refuge's two_by_the_prototype by CALL): the idolater found by one witness exempt", ['exempt'], [('INK', 'Deut 17:2 — "WHEN THERE IS FOUND in your midst, in one of your gates" — "found" [\'ימצא\']; the parser [1] [1]; 19:15 the closest kin of 17:6 (\'Deut 19:15\', 4, 6)'), ('MOVE', "the Sifrei 148:1 (read whole at the reading); cold_run_refuge (CALL) — RG.DATA[the_one_witness] = two_by_the_prototype — 'WHEN THERE IS FOUND' — BY WITNESSES; from 19:15's 'by the mouth of two witnesses or three shall a matter stand' a building from a father: wherever 'found' is said, two or three witnesses (148:1 — the verse AHEAD cited by the spine; refuge's bare plural two by the prototype)"), ('DATA', "found means witnesses a DATA row (the passive verb the witnesses' finding; 19:15's building from a father — its own compile owed to chapter 19); the exam's person the idolater found by one witness — exempt (not 'found')")])
FACT courts_prophet.the_idolaters_trial(the_gate_and_the_stoning) = ("the gate and the stoning (17:2, 17:5) — the gate where found, not where judged; the seducers stoned where the led-astray fall by the sword (the Sifrei 148:2-4, 149:3-4; seducers' sword put_to_death by CALL): the idolater stoned at the gate where found, the evil purged", ['stoned', 'evil_purged_from_the_midst'], [('INK', 'Deut 17:2, 17:5 — "in one of your gates" and "bring them out to your gates" — "your gates" at [(17, 2), (17, 5), (18, 6)]; "stone them with stones" [\'וסקלתם\']; 13:16\'s sword the seducers\' kin'), ('MOVE', "the Sifrei 148:2-4, 149:3-4 (read whole at the reading); cold_run_seducers (CALL) — SE.the_sword = ['put_to_death'] — THE GATE WHERE THEY WERE FOUND, NOT WHERE THEY WERE JUDGED — 'your gates' 'your gates' an analogy by the shared word, read both ways (148:2, 149:4); the led-astray die by the sword, the seducers by stoning (148:3 — 'stone them'); a city is not made a city led astray by one witness nor by a woman, but the single seducer is liable (148:4); 'in Israel' widened to sojourners, women and slaves by 'the man or the woman' (149:3)"), ('DATA', "THE PARAMETER the_gate (the gate where found, not where judged); the exam's person the idolater found in one city and judged in another — stoned at the gate where found")])
FACT courts_prophet.the_idolaters_trial(the_three_acts_and_the_associator) = ("the three acts and the associator (17:3) — the goer, the server, the bower each liable; the associator by 28:14; the host not apportioned (the Sifrei 148:6-8; covenant_at_horeb's bow-and-serve put_to_death and obey_horeb's host by CALL): the one who bows to the sun put to death", ['put_to_death'], [('INK', 'Deut 17:3 — "and goes and serves other gods and bows to them, to the sun or the moon or all the host of heaven, WHICH I HAVE NOT COMMANDED" — the three verbs [\'וילך\', \'ויעבד\', \'וישתחו\']; 4:19\'s host the kin (obey_horeb)'), ('MOVE', "the Sifrei 148:6-8 (read whole at the reading; 148:8 reread from chapter 4); cold_run_covenant_at_horeb (CALL) — CH.bow_and_serve = ['put_to_death']; cold_run_obey_horeb (CALL) — OH.DATA[the_host_apportioned] = a_data_note_no_link — ONLY THIS ONE? the server — 'and goes and serves other gods'; the bower — 'and bows to them' (148:6: the three acts each liable); 'to serve them' (28:14) — to include THE ASSOCIATOR who joins the Name with another's (148:7 — the verse ahead cited); R. Yose the Galilean: 4:19's 'apportioned to all the peoples' against 29:25's 'not apportioned' (148:8 — the pair the obey_horeb row carries): the host not given to the nations to worship"), ('DATA', "the three acts and the associator a DATA row (the goer, the server, the bower; the associator by 28:14; the host not apportioned); the exam's person the one who bows to the sun — put to death by the second word's answer sheet (covenant_at_horeb by CALL)")])
FACT courts_prophet.the_idolaters_trial(the_seven_investigations) = ("the seven investigations (17:4) — 'well' 'well' the analogy with 13:15 at three verses: the seven investigations, the probes, the contradiction rule (the Sifrei 149:1-2, 93:6, 190:7; seducers' condemned_city_inquiry_required by CALL): THE WRITE idolater_inquiry_required, a STATUS on Israel at the chapters' own day; the witness who says 'I do not know' at an investigation accepted against", ['idolater_inquiry_required'], [('INK', 'Deut 17:4 — "and it is told you AND YOU HEAR AND INQUIRE WELL, and behold it is true, the thing certain" — 17:4 shares 9 of its tokens in order with 13:15 [\'היטב\', \'והנה\', \'אמת\', \'נכון\', \'הדבר\', \'נעשתה\', \'התועבה\', \'הזאת\'] (the reading\'s assert)'), ('MOVE', "the Sifrei 149:1-2, 93:6, 190:7 (read whole — the analogy at three verses); cold_run_seducers (CALL) — SE.the_seven_interrogations = ['condemned_city_inquiry_required'], SE.the_congruence_rule = ['accepted'] — 'WELL' 'WELL' AN ANALOGY with 13:15's 'inquire, search, ask well': THEY EXAMINE HIM WITH SEVEN INVESTIGATIONS; probes from 'and behold it is true'; investigations — 'I do not know' voids the testimony, probes — it stands; in both a contradiction voids (149:1-2 — Mishnah Sanhedrin 5:1-2 by the seducers' cell): ONE QUESTIONNAIRE for the city, the idolater and the conspiring witnesses (93:6, 149:1, 190:7)"), ('DATA', "THE WRITE idolater_inquiry_required — a STATUS on israel_people at the chapters' own day (DI2); THE PARAMETER the_seven_investigations (the cycle, the year, the month, the day, the weekday, the hour, the place); the exam's person the witness who says 'I do not know' at an investigation — accepted against, the testimony void")])
FACT courts_prophet.the_idolaters_trial(the_three_exclusions) = ("the three exclusions (17:5) — the coerced, the unwitting, the misled excluded by 'that man' and 'that woman' (the Sifrei 149:5-6; 155:8 the same on the rebel): the one who served under coercion exempt", ['exempt'], [('INK', 'Deut 17:5 — "bring out THAT MAN or THAT WOMAN" — the pronoun [\'ההוא\', \'ההוא\'] twice; 155:8 the same three on the rebel'), ('MOVE', "the Sifrei 149:5-6 (read whole at the reading) — 'THAT MAN' — not the coerced, not the unwitting, not the misled; 'THAT WOMAN' — not the coerced, the unwitting, the misled (fem.): THREE EXCLUSIONS from each pronoun — the liability conditions (intent, knowledge, freedom); 155:8 carries the same three to the rebel elder"), ('DATA', "THE PARAMETER the_three_exclusions (the coerced, the unwitting, the misled — from the pronoun, for the man and for the woman); the exam's person the one who served under coercion — exempt")])
FACT courts_prophet.the_idolaters_trial(two_witnesses_for_every_death) = ("two witnesses for every death (17:6) — 'shall the dead die' every capital case, men not women (the Sifrei 150:1, 190:3; refuge's two_by_the_prototype and ordinances' no_execution_without_witnesses by CALL): THE WRITE two_witnesses_required, a STATUS on Israel at the chapters' own day; the court that executes on one witness barred from it", ['two_witnesses_required'], [('INK', 'Deut 17:6 — "BY THE MOUTH OF TWO WITNESSES OR THREE WITNESSES SHALL THE DEAD DIE" — the parser [2, 3, 1]; 19:15 the closest kin (\'Deut 19:15\', 4, 6); 190:3 the outside row — men, not women'), ('MOVE', "the Sifrei 150:1, 190:3 (read whole at the reading); cold_run_refuge (CALL) — the prototype 'by the mouth of witnesses' (35:30) — the bare plural: TWO unless 'one; cold_run_ordinances (CALL) — OR.courts(circumstantial) = no_execution_without_witnesses — ONLY THIS ONE? WHENCE ALL THE OTHERS PUT TO DEATH? the teaching says the verse again — 'shall the dead die': TWO WITNESSES FOR EVERY CAPITAL CASE (150:1); 'two' 'two' with 19:15: as there men and not women, so here (190:3); no execution without witnesses (the Mekhilta — ordinances by CALL)"), ('DATA', "THE WRITE two_witnesses_required — a STATUS on israel_people at the chapters' own day (DI2); THE PARAMETER the_witnesses_number (two or three, men); the exam's person the court that executes on one witness's testimony and circumstance — barred from it")])
FACT courts_prophet.the_idolaters_trial(one_witness_and_the_disciple_silent) = ("one witness and the disciple silent (17:6) — neither argues for guilt (the Sifrei 150:2-3; ordinances' merit_by_one_liability_by_two by CALL): THE WRITE one_witness_barred, a BLOCK on Israel at the chapters' own day; the disciple who argues for guilt barred from it", ['one_witness_barred'], [('INK', 'Deut 17:6 — "HE SHALL NOT DIE BY THE MOUTH OF ONE WITNESS" — the negation [\'לא\']; "one" the parser\'s third number 1'), ('MOVE', "the Sifrei 150:2-3 (read whole at the reading); cold_run_ordinances (CALL) — OR.courts(one_vs_two) = merit_by_one_liability_by_two, (no_retrial_acquitted) = reversed_for_merit_not_for_liability — WHENCE THAT ONE WITNESS DOES NOT ARGUE FOR GUILT? 'he shall not die by the mouth of one witness'; WHENCE THAT A DISCIPLE DOES NOT ARGUE FOR GUILT? the same clause (150:2-3 — the single witness and the disciple silent for the prosecution, Sanhedrin 5:4 by the English's note); acquit by one and convict by two, reversed for merit not for liability (Mishnah Sanhedrin 4:1 — ordinances by CALL)"), ('DATA', "THE WRITE one_witness_barred — a BLOCK on israel_people at the chapters' own day (DI2); the exam's person the disciple who argues for guilt — barred from it; the single witness the same")])
FACT courts_prophet.the_idolaters_trial(the_witnesses_hand_first) = ("the witnesses' hand first (17:7) — the witnesses execute, any man after, the second stone (the Sifrei 151:1-2, 149:7; seducers' hand-first accepted and mekoshesh's both verses fulfilled: t by CALL), the doers of evil purged (151:3 — the formula's second seat): THE WRITE witnesses_hand_first_commanded, a STATUS on Israel at the chapters' own day; the convicted idolater stoned and the evil purged", ['witnesses_hand_first_commanded', 'stoned', 'evil_purged_from_the_midst'], [('INK', 'Deut 17:7 — "THE HAND OF THE WITNESSES SHALL BE ON HIM FIRST to put him to death, and the hand of all the people afterward; and you shall purge the evil from your midst" — 17:7 shares 7 tokens in order with 13:10 [\'להמיתו\', \'ויד\', \'כל\', \'העם\', \'באחרנה\']; the purge formula\'s second seat of nine'), ('MOVE', "the Sifrei 149:7, 151:1-3, 306:9 (read whole at the reading); cold_run_seducers (CALL) — SE.the_hand_first = ['accepted'], SE.the_purge_formulas_nine_seats = the purge formula's nine seats — 9 on th; cold_run_mekoshesh (CALL) — MK.stones_and_a_stone = both verses fulfilled: the second witness's stone, all Israel's stones — A COMMANDMENT ON THE WITNESSES TO PUT HIM TO DEATH (151:1); if he did not die by the witnesses' hand he dies by any man's (151:2 — Sanhedrin 6:4, R. Benaiah's image at 306:9); 'stone them with stones' — many? Leviticus 20:27's 'with a stone'; one? here 'stones': if not by the first, by the second (149:7 — mekoshesh's cell: the second witness's stone, all Israel's stones); 'purge the evil from your midst' — PURGE THE DOERS OF EVIL FROM ISRAEL (151:3 — persons, not an abstraction; Onkelos 'the doer of evil'; the formula's second seat of nine)"), ('DATA', "THE WRITE witnesses_hand_first_commanded — a STATUS on israel_people at the chapters' own day (DI2); the exam's person the idolater convicted on two witnesses — stoned by the witnesses' hand first and the evil purged (chapter 13's body effects reused, never a line's write)")])
CELL courts_prophet.the_high_court: asks 8 ['the_distinguished_judge_and_the_three_grades', 'the_pairs', 'rise_at_once_in_court', 'the_three_courts', 'the_court_at_yavneh_and_the_priests', 'the_judge_of_those_days', 'do_and_turn_not_right_or_left', 'the_rebel_elder'] | keys 0 [] | matching 'witness|two|three|inquir|hard|judge': ['the_distinguished_judge_and_the_three_grades', 'the_three_courts', 'the_judge_of_those_days']
FACT courts_prophet.the_high_court(the_distinguished_judge_and_the_three_grades) = ("the distinguished judge and the three grades (17:8) — 'too hard' the court's distinguished one; counsel, law, verdict (the Sifrei 152:1-4; opening_speech's hard matter by CALL): the local judge who cannot decide accepted, the matter goes up", ['accepted'], [('INK', 'Deut 17:8 — "WHEN A MATTER IS TOO HARD FOR YOU IN JUDGMENT" — "too hard" [\'יפלא\'] (the root of wonder); 1:17\'s "the matter too hard for you" the twin (shared 2)'), ('MOVE', "the Sifrei 152:1-4 (read whole at the reading); cold_run_opening_speech (CALL) — OP.the_hard_matter = the hard matter (1:17) — Exodus 18:26's status read (ES by C — 'TOO HARD' — THE VERSE SPEAKS OF THE DISTINGUISHED ONE (the court's distinguished judge, 152:1); 'from you' — this is counsel; 'a matter' — this is the law; 'for judgment' — this is the verdict (152:2-4): counsel, law, verdict THE THREE GRADES of the question the high court takes; 1:17's hard matter brought to Moses by CALL"), ('DATA', "THE PARAMETER the_three_grades (counsel, the law, the verdict — the question's three kinds); the exam's person the local court's distinguished judge who cannot decide — accepted, the matter goes up")])
FACT courts_prophet.the_high_court(the_three_courts) = ("the three courts (17:8-10) — the Temple Mount's, the courtyard's, the Chamber of Hewn Stone, the formula at each, Torah going out from the great court (the Sifrei 152:13-14 = Mishnah Sanhedrin 11:2 — the exam row read whole; festivals_judges' tiers accepted by CALL): THE WRITE high_court_at_the_place_commanded, a STATUS on Israel at the chapters' own day; the elder who taught but did not instruct to act exempt", ['high_court_at_the_place_commanded'], [('INK', 'Deut 17:8-10 — "to the place which the LORD your God will choose … from that place" — the place formula twice [(17, 8), (17, 10), (18, 6)]; "the priests the Levites" at [(17, 9), (17, 18), (18, 1), (18, 7)]'), ('MOVE', "the Sifrei 152:13-14 (read whole at the reading — the Mishnah cited in the spine's Hebrew); MISHNAH SANHEDRIN 11:2 (read whole at the design — THE EXAM ROW); cold_run_festivals_judges (CALL) — FJ.the_three_tiers = ['accepted'] — THREE COURTS WERE THERE — at the entrance of the Temple Mount, at the entrance of the courtyard, in the Chamber of Hewn Stone; they come to the first and he says 'THUS I EXPOUNDED AND THUS MY FELLOWS, THUS I TAUGHT AND THUS MY FELLOWS'; if they have heard, they tell them; if not, to the second; if not, both come to the great court in the Chamber of Hewn Stone, FROM WHICH TORAH GOES OUT TO ALL ISRAEL (152:13-14 = Sanhedrin 11:2); the elder who returned and taught as before exempt, who instructed to act liable, the student exempt (the Mishnah's own continuation): THE COURTS' SECOND DAEMON — 16:18's three tiers (by CALL) now seated"), ('DATA', "THE WRITE high_court_at_the_place_commanded — a STATUS on israel_people at the chapters' own day (DI2); THE PARAMETER the_three_courts (Mishnah Sanhedrin 11:2 — the three seats and the formula); the exam's person the elder who taught his ruling but did not instruct to act — exempt")])
FACT courts_prophet.the_high_court(the_judge_of_those_days) = ("the judge of those days (17:9) — a judge fit and established in your days, the details of judgment his answer (the Sifrei 153:4-5): the litigant who refuses his generation's judge accepted against", ['accepted'], [('INK', 'Deut 17:9 — "and to the judge WHO SHALL BE IN THOSE DAYS; and you shall inquire and they shall tell you the word of judgment" — "in those days" [\'בימים\', \'ההם\']'), ('MOVE', "the Sifrei 153:4-5 (read whole at the reading) — R. YOSE THE GALILEAN: would you go to a judge not in your days? rather, a judge fit and established in those days; was a kinsman and became distant — fit; Ecclesiastes 7:10 'say not the former days were better' (153:4); 'the word of judgment' — these are the details of judgment (153:5 — the answer's form)"), ('DATA', "the judge of those days a DATA row (the fit judge of one's own days; the details of judgment the answer); the exam's person the litigant who refuses his generation's judge for the former days' — accepted against")])
DATA KEYS courts_prophet ~ witness|two|three|stoning|inquiry: ['the_parsers_two_verses', 'the_three_true_prohibitions', 'the_three_exclusions', 'the_witnesses_number', 'the_three_grades', 'the_three_courts', 'the_three_limits', 'the_three_gifts', 'the_soothsayer_three_ways', 'the_two_penalties']
DEFS refuge ['Fraction', 'NF', 'dat', 'db', 'hyp', 'ink', 'ink_numbers', 'ink_ordinals', 'law_refuge', 'lemma_seats', 'lemma_tokens', 'move', 'narrative', 'out', 'scene', 'seats', 'strip', 'the_levite_cities', 'the_manslayer', 'the_murderer', 'the_refuge_law', 'the_statute', 'tok', 'verse_text', 'verse_words', 'words']
FACT refuge.DATA[the_one_witness] = {'value': 'two_by_the_prototype', 'settings': {'the_prototype': "'by the mouth of witnesses' (35:30) — the bare plural: TWO unless 'one' is written (the Sifrei 161:1's rule; Deuteronomy 17:6, 19:15 the spec, FORWARD)", 'for_acquittal': "'one witness shall not testify against a person to die' (35:30) — the Rabbis: nothing beyond his testimony; R. Yosei son of R. Yehuda: he may answer to ACQUIT (Sanhedrin 33b:15; the Sifrei 161:1)", 'the_oath': 'the oath of testimony — men, non-relatives, the fit; before the court (Mishnah Shevuot 4:1)', 'no_inference': "'we do not punish by inference' for the lashed ('wicked' / 'wicked', 35:31) and for the exiled ('murderer' / 'murderer', 35:21 / 35:11) — Makkot 5b:15-16; the Sifrei 157:6, 160:3 the same rule", 'the_witnesses_hand': "the witnesses' hands first (Deuteronomy 17:7; Sanhedrin 45b:7); conspiring witnesses on exile flogged, not exiled (Mishnah Makkot 1:1) — Deuteronomy 19 FORWARD"}, 'source': "35:30 — 'witnesses' the bare plural, 'one witness' the homograph told by the lemma (5707 against 5704's 'until')"}
FACT refuge.DATA[the_lands_atonement] = {'value': 'by_the_shedders_blood', 'settings': {'no_atonement_until_he_dies': 'the killer known — no atonement for the community until he is put to death; where the court cannot (no forewarning) — the tunic (Arakhin 16a:22; Zevachim 88b:13); not Yom Kippur (Keritot 26a:17)', 'the_heifer': "the heifer broken and then the killer found — he dies, not by the calf's blood (Mishnah Sotah 9:7; Sotah 47b:2; Ketubot 37b:6); the beheaded beheaded from the neck like the heifer, not with the cleave", 'the_presence_departs': 'for bloodshed the Temple is destroyed and the Presence departs — 35:33-34 read whole (Shabbat 33a:4); bloodshed an impurity the goat does not atone (Shevuot 7b:7); R. Yishmael reads 35:34 at the burgl', 'genesis_9_6': "'except by the blood of him who shed it' — Genesis 9:6's clause run as law: PR.cain by CALL, the blood_required HEAVEN entry on Noah", 'leviticus_18': "'you shall not defile the land' — Leviticus 18:25-28's land that vomits: SA.frame('land') by CALL"}, 'source': "35:33-34 — the pollute-root's only Torah seat, the passive 'no atonement', 'defile' — computed"}
FACT refuge.DATA[the_case_table] = {'value': 'computed_from_the_tokens', 'settings': {'instrument_x_manner_x_intent': 'the instruments (iron 16; a stone of the hand 17; a wooden instrument of the hand 18; any stone 23), the manners (thrust 20, 22; threw 20, 22; struck with his hand 21; dropped 23), the intents (hatred', 'the_downward_motion': "Shmuel from 'and he dropped it on him and he died' (35:23): exile only for a downward motion — the roller, the barrel, the ladder (Mishnah Makkot 2:1; Makkot 7b:2; the butcher 7b:10-12; the rung 7b:8-", 'the_permission_and_the_office': "the courtyard by permission (Deuteronomy 19:5's forest); Abba Shaul's optional act — the father, the teacher, the court's agent exempt (Mishnah Makkot 2:2; Makkot 8a:13-15): M3.killer('guile_excludes'", 'the_intents_table': "meant the beast / the gentile / the non-viable — exempt; the loins and the heart by the blow's force; R. Shimon: this one meant and that one killed — exempt (Mishnah Sanhedrin 9:2; Sanhedrin 79a:3-7)", 'causation': "held in the water or the fire — liable; pushed and could get out — exempt; the dog and the snake; the fangs (Mishnah Sanhedrin 9:1; Sanhedrin 76b:14-77b:16 — Rava's binding, the ladder, the shield, th", 'the_neither_row': "Issi ben Akiva's two-way uncertainty (the Sifrei 160:8 — neither death nor exile); Rava's 'one who says it is permitted' — neither executed nor exiled (Makkot 7b:4; 9a:7): the row's value 'unresolved'"}, 'source': "35:16-23's tokens — computed at import (CASE_TOKENS; the instruments, manners and intents by seat)"}
FACT refuge.DATA[the_ransom_rows] = {'value': 'refused_twice', 'settings': {'two_rules': '35:31 — no money to exempt from DEATH; 35:32 — no money to exempt from EXILE: one for the intentional, one for the unwitting, both needed (Ketubot 37b:3-4)', 'heavens_death_commuted': "R. Yishmael son of R. Yochanan ben Beroka: those executed at Heaven's hand give money and are atoned — the ox's owner (Exodus 21:29-30); those executed by man never ('dedicated of men shall not be red", 'the_talion_money': "'no ransom for the LIFE of a murderer' — but ransom for limbs: the talion's money through Leviticus 24:18-21 (Bava Kamma 83b:9-19; L24.talion by CALL)", 'the_lashes': "'wicked to die' (35:31) / 'wicked' (Deuteronomy 25:2) — the lashes' twenty-three, no partial lashes, no inference (Sanhedrin 10a:11; Makkot 5a:3; Ketubot 35a:5)", 'the_ox_cell': "the mishpatim runner's STONE+RANSOM cell and its effect ransom_imposed — the noun this chapter refuses (M1 by CALL); Sanhedrin 15b:4-5: where ransom is written there is no death — 'you execute him for"}, 'source': "35:31, 35:32 — 'you shall not take ransom' the two seats; the ransom-noun's Torah seats computed"}
FACT refuge.DATA[the_avengers_hand] = {'value': 'after_the_court', 'settings': {'the_court_first': "'the manslayer shall not die until he stands before the congregation for judgment' (35:12) written against 35:27's avenger — R. Eliezer: only after conviction; Rav: the avenger who kills before is lia", 'outside_the_border': "R. Yosei HaGelili: a MITZVA for the avenger, optional for any man; R. Akiva: optional for the avenger, any other man LIABLE — 'and the avenger slays' a narration, not 'shall slay' (Mishnah Makkot 2:7;", 'on_the_way': "Rav Huna: the avenger who killed him on the way to the city is exempt — 'no sentence of death' (Deuteronomy 19:6) the avenger's; the baraita: the manslayer's (Makkot 10b:7-9)", 'no_avenger': "the court appoints an avenger where there is none — 'when he meets him' (35:21; Sanhedrin 45b:13); the Sifrei 160:7's court-appointed avenger (the English moved it to 160:5)", 'two_verses_as_one': 'the murderer and the avenger — two verses that come as one, no principle from them (Sanhedrin 45b:12)', 'the_son': 'a son is no avenger against his father; the grandson is (Makkot 12a:16-18)'}, 'source': "35:19, 21 'when he meets him' — two seats; 35:12's clause"}
FACT refuge.DATA[the_court_of_twenty_three] = {'value': '23', 'settings': {'ten_and_ten_and_three': "'the congregation shall judge' ten, 'the congregation shall deliver' ten (a congregation ten by the spies, 14:27), a majority of two to convict (Exodus 23:2) and one for the odd number (Mishnah Sanhed", 'the_deliverance_verb': "the court must seek exoneration (Pesachim 12a:2; Rosh Hashanah 26a:2; Sanhedrin 69a:12); a Sanhedrin that saw the killing may not judge it — 'until he stands before the congregation' another court (Ma", 'in_all_your_dwellings': "'a statute of judgment for your generations in all your dwellings' (35:29): the Sanhedrin with capital authority in the land and outside it (Makkot 7a:3, 7a:7); no execution on the Sabbath by 'dwellin", 'the_kin_and_the_haters': "the kin off the bench and the witness stand (Mishnah Sanhedrin 3:4; 27b:10-15 from Deuteronomy 24:16); the hater of three days (3:5) — 'not his enemy' testifies, 'nor sought his harm' judges (Sanhedri", 'the_rate': 'a Sanhedrin that executes once in seven years is destructive (Mishnah Makkot 1:10; R. Elazar ben Azarya seventy; R. Tarfon and R. Akiva never; Rabban Shimon ben Gamliel: they would multiply murderers '}, 'source': "35:12, 24, 25, 25 — the congregation-token's four seats computed"}
