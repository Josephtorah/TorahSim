FACT second_tablets.the_stations_and_the_death(eleazar_ministered) = ("Eleazar ministered in his stead (10:6) — 'ministered as priest' the wayyiqtol at 10:6 and Numbers 3:4 alone; the tape's invested_office on eleazar at Hor (CK.edom_and_hor('succession') by CALL): the readback row VERBATIM in kind, no second investiture", ['accepted'], [('INK', 'Deut 10:6 — "and ELEAZAR HIS SON MINISTERED AS PRIEST IN HIS STEAD" — the phrase\'s one seat [\'Deut 10:6\']; "ministered as priest" the piel wayyiqtol at 10:6 and Numbers 3:4 ALONE [(\'Deut 10:6\', \'ויכהן\'), (\'Num 3:4\', \'ויכהן\')] (the lemma\'s seventeen Torah seats); Onkelos "ושמיש אלעזר בריה תחותוהי" (and Eleazar his son ministered in his stead)'), ('MOVE', "cold_run_chukat (CALL) — CK.edom_and_hor(succession) = the garments to Eleazar and the office with them — Exod 29:29-30 run at Mount Hor (20:26-2 — the garments to Eleazar and the office with them — Exodus 29:29-30's rule run at Mount Hor (20:26-28): invested_office on eleazar the tape's entry (DB6: no second investiture)"), ('DATA', 'the readback row 10:6 (Eleazar) VERBATIM in kind — the tape\'s garments_transferred_and_aaron_died carries to: eleazar; Numbers 3:4 "and Eleazar and Ithamar ministered as priests in the presence of Aaron their father" the verb\'s other seat — the sons in the father\'s presence there, the son in his stead here')])
FACT second_tablets.the_stations_and_the_death(arad_heard) = ("Arad heard (Rosh Hashanah 3a:1-3; Ta'anit 9a:9-12) — the clouds departed at Aaron's death, the Canaanite came (CK.edom_and_hor('arad_heard'), JO.aarons_death_retold('arad') by CALL); 'saw' read 'were seen' — the do-not-read reading named: a DATA row", ['accepted'], [('INK', 'Deut 10:6 — "there Aaron died" — the death the retelling\'s pivot between the stations; Numbers 21:1 "and the Canaanite, the king of Arad … heard that Israel came" the tape\'s next line after the mourning'), ('MOVE', "Rosh Hashanah 3a:1-3; Ta'anit 9a:9-12 (read whole at the docket); cold_run_chukat (CALL) — CK.edom_and_hor(arad_heard) = Arad heard that Aaron died and the clouds departed (Rosh Hashanah 3a; Taanit 9a) — ARAD HEARD THAT AARON DIED AND THE CLOUDS OF GLORY DEPARTED (R. Abbahu — 'and the Canaanite heard' 21:1 juxtaposed to Aaron's death: 'he is Sihon, he is Arad, he is Canaan'); THE THREE GIFTS BY THREE SHEPHERDS — the well by Miriam's merit, the cloud by Aaron's, the manna by Moses' (Ta'anit 9a:9-12): 'and all the congregation SAW' (20:29) read 'were seen' — the do-not-read reading NAMED, no code (vayiru / vayera'u)"), ('MOVE', "cold_run_journeys (CALL) — JO.aarons_death_retold(arad) = the Canaanite king of Arad heard (33:40) — 21:1's hearing alone, a run citation  — the journeys runner's cell on Arad's hearing (33:40 'and the Canaanite king of Arad heard' beside 33:38-39) — the era's chain (Rosh Hashanah 3a:4-13: from the death to the new king)"), ('DATA', "a DATA row — the clouds' departure a STATE the shelf reads from 20:29's verb; no write (the manna and the well the tape's lines, the cloud's departure none)")])
FACT second_tablets.the_stations_and_the_death(aaron_in_av) = ("Aaron in Av — the first of the fifth month of the fortieth year (Num 33:38, the ordinal reader; the tape's marker (40, 5, 1)); the burial dated at the same day; the editor's 'first of Tammuz' variant a DATA note (Seder Olam Rabbah 10:2; CK.edom_and_hor by CALL)", ['accepted'], [('INK', 'Num 33:38 — "in the fortieth year … in the fifth month, on the first of the month" — the ordinal reader [40, 5] and the number reader [1]: THE FIRST OF AV; the tape\'s marker at Num 20:28 (40, 5, 1) = (40, 5, 1); 33:39\'s age [123]'), ('MOVE', "Seder Olam Rabbah 10:2 (read whole at the docket); cold_run_chukat (CALL) — CK.edom_and_hor(death_dates) = Aaron (40, 5, 1) by the ink, aged 123; Miriam the tenth of N — Aaron died on the first of Av (33:38 — the one death in the Torah with its date written); THE EDITOR'S VARIANT — the export's 'first of Tammuz' in one arm of the chapter's text: a DATA note, the ink's 'fifth month' the tape's; Miriam the tenth of Nisan by the shelf, Moses the seventh of Adar"), ('DATA', 'the date on the tape the ink\'s own (the ordinal reader at 33:38); the burial line dated at the same day (40, 5, 1) — the retrograde marker M[\'burial_told\'] = M[\'aaron_death\']; the editor\'s "first of Tammuz" variant a DATA note (Seder Olam 10:2)')])
FACT second_tablets.the_stations_and_the_death(walk_after_his_attributes) = ("walk after His attributes (Sotah 14a:3-4) — 'after the LORD you shall walk' resolved as clothing the naked, visiting the sick, comforting mourners, BURYING THE DEAD (34:6): the burier accepted; 10:6's passive burial beside it; the Torah begins and ends with kindness (14a:6)", ['accepted'], [('INK', 'Deut 10:12 — "to WALK IN ALL HIS WAYS" (10:12 — [\'1Kgs 8:58\', \'Deut 10:12\', \'Deut 11:22\']; 11:22 and Solomon\'s charge the phrase\'s other seats) and 13:5\'s "after the LORD your God you shall walk"'), ('MOVE', "Sotah 14a:3-4, 14a:6 (read whole at the docket) — 'AFTER THE LORD YOUR GOD YOU SHALL WALK' — is it possible to walk after the Divine Presence, 'a consuming fire'? RATHER: walk after His attributes — clothe the naked, visit the sick, comfort mourners, BURY THE DEAD ('and He buried him in the valley', 34:6); 14a:6 — the Torah begins with kindness (Genesis 3:21) and ends with kindness (34:6)"), ('DATA', "the exam's person: the burier of the dead — the rule holds for him (walking after His attributes); 10:6's passive burial beside it (Aaron's burial by no named hand; Moses' by God's)")])
