FACT seven_nations.DATA[the_three_readings_of_favor] = {'value': '{\'no_land\': \'no chance to ENCAMP — no house rented, nothing attached to the ground sold to a gentile in the Land (Mishnah Avodah Zarah 1:8: R. Meir / R. Yosei on the Land, Syria and abroad; Avodah Zarah 20b:12-15 the sale on condition of cutting)\', \'no_praise\': "no FAVOR by praising — \'how beautiful is this gentile woman\' forbidden (Rav, 20a:9); the thanks to the Creator excepted (Rabban Shimon be', 'settings': {'the_ink': "'and show them no favor' (7:2) — the verb's one seat in this form (the root's six Torah seats as a verb); Avodah Zarah 20a:2-3 THE SPELLING ARGUMENT: the defective form yields all three readings (the ", 'onkelos': "'have no MERCY on them' (7:2; 13:9 the enticer)", 'the_exam_persons': 'the renter of a house in the Land ACCEPTED (the land reading holds against him); the praiser who thanks the Creator EXEMPT'}}
