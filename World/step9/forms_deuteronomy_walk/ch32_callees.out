FACT not_righteousness.DATA[the_ten_names_of_prayer] = {'value': '{\'the_ten\': "shava, tze\'aka, ne\'aka, rina, pegia, bitzur, keria, NIPUL, pilul, tachanunim (Devarim Rabbah 2:1; the Sifrei 26:7 read at sitting 7)", \'the_chapters\': "9:18 \'I THREW MYSELF DOWN\' (nipul) and 9:26 \'I prayed\' (pilul) — two of the ten this chapter\'s; 3:23\'s plea (tachanunim) chapter 3\'s", \'the_seats\': [(\'Deut 9:18\', \'ואתנפל\'), (\'Deut 9:25\', \'ואתנפל\'), (\'Deut 9:25\', \'התנפלתי\'), (\'Ezra 10:', 'settings': {'the_cell': 'F3 i_fell_down; F6 i_prayed_and_said — a DATA row'}}
FACT not_righteousness.DATA[the_three_voices_on_one_pronoun] = {'value': '{\'the_finding\': "the second person SINGULAR in twelve verses — 1-6 ISRAEL (Moses to the people), 12 and 14 GOD\'S \'you\' to Moses (the divine frames), 26-29 MOSES\' \'You\' to God (the prayer); PLURAL in twelve (8-10, 16-19, 21-25); BOTH at 9:7 alone (the switch inside the verse); NEITHER at 11, 13, 15, 20", \'the_register\': ([1, 2, 3, 4, 5, 6, 12, 14, 26, 27, 28, 29], [8, 9, 10, 16, 17, 18, 19, 21, 22,', 'settings': {'the_cell': "the reading's finding — no cell; a DATA row"}}
