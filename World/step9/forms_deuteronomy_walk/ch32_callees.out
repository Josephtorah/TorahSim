FACT refuge_war_family.the_landmark_and_the_witnesses(one_witness_for_any_iniquity) = ("one witness for any iniquity (19:15) — the general rule from the particular (I3): in capital cases, money, offerings and lashes one witness stands not; for an oath it obliges (the Sifrei 188:4-9; courts_prophet's two_witnesses_required and one_witness_barred, refuge's two_by_the_prototype and ordinances' merit_by_one_liability_by_two by CALL): THE WRITE two_or_three_witnesses_required, a STATUS on Israel at the chapters' own day; the creditor with one witness accepted for the oath alone", ['two_or_three_witnesses_required'], [('INK', 'Deut 19:15 — "ONE WITNESS SHALL NOT RISE AGAINST A MAN FOR ANY INIQUITY OR ANY SIN, in any sin that he sins; BY THE MOUTH OF TWO WITNESSES OR BY THE MOUTH OF THREE WITNESSES SHALL A MATTER STAND" — the parser [1, 2, 3] at 19:15 (one, two, three), the starred token [\'שני^\']; 19:15 shares 3 tokens in order with 17:6 ([\'עד\', \'אחד\'] the shared run — the reading\'s assert: the spelling of "two" changed), with Numbers 35:30 1; one_witness_barred ONE and two_witnesses_required ONE on israel_people (17:2-7\'s line) THE TAPE\'S REFERENCES'), ('MOVE', "the Sifrei 188:4-9 (read whole at the reading); cold_run_courts_prophet (CALL) — CP.found_means_witnesses = ['exempt'], CP.two_witnesses_for_every_death = ['two_witnesses_required'], CP.one_witness_and_the_disciple_silent = ['one_witness_barred']; cold_run_refuge (CALL) — RG.DATA[the_one_witness] = two_by_the_prototype; cold_run_ordinances (CALL) — OR.courts(one_vs_two) = merit_by_one_liability_by_two — 'ONE WITNESS SHALL NOT RISE' — a general rule built from the particular (I3 — the father from 17:6's death: checked in MIDDOT.md before it was typed): in capital cases, in money, in offerings, in lashes one witness stands not (188:4-8); the one witness for an oath — he obliges an oath (188:9; Shevuot 5:4 the English's note, not read); 'BY THE MOUTH OF TWO OR THREE' — the reading's design at 15b: '19:15's two or three — the rule recorded there, its own compile owed to chapter 19': PAID HERE; refuge's bare plural two by the prototype (Numbers 35:30)"), ('DATA', "THE WRITE two_or_three_witnesses_required — a STATUS on israel_people at the chapters' own day (DJ2; 17:6's two_witnesses_required the death's, this the general rule); the one witness for an oath a DATA row; the exam's person the creditor with one witness — the debtor obliged to an oath, not to pay: accepted for the oath alone")])
FACT refuge_war_family.the_landmark_and_the_witnesses(by_the_mouth_not_by_writing) = ("by the mouth, not by writing (19:15) — their mouth, not a letter, not an interpreter (the Sifrei 188:10; Onkelos 'by the word of'): the court that accepts a witnesses' letter barred from it", ['barred_from_it'], [('INK', 'Deut 19:15 — "BY THE MOUTH of two witnesses or BY THE MOUTH of three witnesses" — "by the mouth" twice; Onkelos "by the memra (the word) of two witnesses" at both (the reading\'s Aramaic assert)'), ('MOVE', "the Sifrei 188:10 (read whole at the reading) — 'BY THE MOUTH' — from their mouth, not from their writing: not a letter sent to the court and not through an interpreter (188:10); Onkelos's 'memra' (the word) the mouth's Aramaic"), ('DATA', "THE PARAMETER the_witnesses_mouth (188:10 — their mouth; no letter, no interpreter); the exam's person the court that accepts testimony by a letter the witnesses sent — barred from it")])
FACT refuge_war_family.the_landmark_and_the_witnesses(the_violent_witness_and_the_woman) = ("the violent witness and the woman (19:16-17) — Exodus 23:1's witness of violence; the litigants stand; the woman not a witness by 'two' 'two' (I2); the judges of those days (the Sifrei 189:1-2, 190:1-6; ordinances' robbers_disqualified and festivals_judges' judges_and_officers_commanded by CALL): the woman brought as a witness exempt from the stand", ['exempt'], [('INK', 'Deut 19:16-17 — "IF A VIOLENT WITNESS RISES AGAINST A MAN to testify against him a falling away — THEN THE TWO MEN who have the controversy SHALL STAND before the LORD, before the priests and the judges who shall be in those days" — "a violent witness" at 19:16 and Exodus 23:1 alone (the reading\'s formula assert; 2 tokens in order shared); the parser [2] at 19:17 ("two"), the starred token [\'שני^\']; "in those days" 19:17 with 17:9 (3 shared)'), ('MOVE', "the Sifrei 189:1-2, 190:1-6 (read whole at the reading); cold_run_ordinances (CALL) — OR.courts(witness_of_violence) = robbers_disqualified, OR.courts(false_report) = hapax; cold_run_festivals_judges (CALL) — FJ.the_court_for_all_israel = ['judges_and_officers_commanded'] — 'A VIOLENT WITNESS' — Exodus 23:1's witness of violence (ordinances by CALL: the robbers disqualified); 'THE TWO MEN SHALL STAND' — the litigants stand, the judges sit (190:1); 'THE TWO MEN' — men, not women: THE WOMAN NOT A WITNESS by 'two' 'two' — the gezerah shavah (the verbal analogy) I2 on 19:15's and 17:6's 'two' (checked in MIDDOT.md before it was typed; the reading's assert: the spelling changed between the seats, the analogy on the word); 'BEFORE THE LORD' — as if before the Presence; 'BEFORE THE PRIESTS AND THE JUDGES OF THOSE DAYS' — 17:9's judge of those days (190:4-6; festivals_judges' court for all Israel by CALL)"), ('DATA', "THE PARAMETER the_witnesses_gender (190:2-3 — men, not women, by the verbal analogy I2); the litigants stand a DATA row; the exam's person the woman brought as one of the two witnesses — exempt from the stand (not a witness)")])
FACT refuge_war_family.the_landmark_and_the_witnesses(the_inquiry_well_at_three_verses) = ("the inquiry well at three verses (19:18) — 'well' 'well' 'well': one questionnaire, the seven interrogations (the Sifrei 190:7 with 93:6 and 149:1; seducers' condemned_city_inquiry_required and courts_prophet's idolater_inquiry_required by CALL): THE WRITE witnesses_inquiry_commanded, a STATUS on Israel at the chapters' own day; the witness who says 'I do not know' at an interrogation accepted against", ['witnesses_inquiry_commanded'], [('INK', 'Deut 19:18 — "AND THE JUDGES SHALL INQUIRE WELL, and behold the witness is a false witness, he testified falsely against his brother" — "and the judges shall inquire well" the Bible\'s one seat, "well" at 13:15, 17:4 and 19:18 one questionnaire (the reading\'s formula assert; KINC [(\'Deut 13:15\', 2, 2), (\'Deut 17:4\', 2, 2), (\'Prov 25:18\', 2, 2)]); "a false witness" the Decalogue\'s word (Exodus 20:16)'), ('MOVE', "the Sifrei 190:7 (REREAD from chapters 13 and 17-18); cold_run_seducers (CALL) — SE.the_seven_interrogations = ['condemned_city_inquiry_required']; cold_run_courts_prophet (CALL) — CP.the_seven_investigations = ['idolater_inquiry_required'] — 'WELL' 'WELL' — 13:15's 'inquire, search, ask well', 17:4's 'inquire well', 19:18's 'the judges shall inquire well': ONE QUESTIONNAIRE for the city, the idolater and the plotting witnesses — the seven interrogations (Mishnah Sanhedrin 5:1 by the seducers' cell; 190:7)"), ('DATA', "THE WRITE witnesses_inquiry_commanded — a STATUS on israel_people at the chapters' own day (DJ2 — the third seat's own status; condemned_city_inquiry_required and idolater_inquiry_required the tape's references); THE PARAMETER the_inquiry_well (the seven at three verses); the exam's person the witness who says 'I do not know' at an interrogation — accepted against, the testimony void")])
FACT refuge_war_family.the_landmark_and_the_witnesses(as_he_plotted) = ("as he plotted (19:19) — refuted in their persons, not in their testimony; killed by the second set's mouth; as he plotted, not as he did (the Sifrei 190:8-12; Mishnah Makkot 1:4; courts_prophet's witnesses_hand_first_commanded by CALL): THE WRITE plotting_witness_talion_commanded, a STATUS on Israel at the chapters' own day; the plotting witness refuted in his person put to death", ['plotting_witness_talion_commanded', 'put_to_death'], [('INK', 'Deut 19:19 — "THEN YOU SHALL DO TO HIM AS HE PLOTTED TO DO TO HIS BROTHER; and you shall purge the evil from your midst" — "as he plotted" at 19:19 and Zechariah 1:6 alone (the reading\'s formula assert); the purge formula\'s FOURTH seat of nine (19:19 sharing 3 tokens in order with 13:6\'s first)'), ('MOVE', "the Sifrei 190:8-12 (read whole at the reading); MISHNAH MAKKOT 1:4 (the exam row, read whole); cold_run_courts_prophet (CALL) — CP.the_witnesses_hand_first = ['witnesses_hand_first_commanded'] — 'AS HE PLOTTED' — the plotting witnesses undone by their fellows, not by the accused (190:8-9); MISHNAH MAKKOT 1:4: witnesses are not made plotters until they themselves are refuted — 'you were with us that day in such a place' refutes the persons, 'the killed or the killer was with us' refutes only the testimony; then THEY ARE KILLED BY THE MOUTH OF THE SECOND SET; 'AS HE PLOTTED TO DO' — and not as he did: money for money, lashes for lashes, death for death (190:10-11); the refuted not killed until the verdict finishes (190:12 — Makkot 1:6, the ledger's row, not in the twenty-eight); the priest's daughter's case (Sanhedrin 9:1 — the English's note) a DATA row"), ('DATA', "THE WRITE plotting_witness_talion_commanded — a STATUS on israel_people at the chapters' own day (DJ2); THE PARAMETER as_he_plotted (Makkot 1:4 — refuted in their persons; by the second set's mouth; as plotted, not as done); the exam's person the plotting witness refuted in his person in a capital case — put to death by the second set's mouth, the evil purged (the body effects reused)")])
FACT refuge_war_family.the_landmark_and_the_witnesses(the_rest_hear_and_fear) = ("the rest hear and fear (19:20) — the formula's third seat of four; the purge formula's fourth of nine (the Sifrei 190:13; seducers' the purge formula's nine by CALL): israel_hears_and_fears the tape's reference, no second write; the executed plotter's evil purged from the midst", ['evil_purged_from_the_midst'], [('INK', 'Deut 19:20 — "AND THOSE WHO REMAIN SHALL HEAR AND FEAR, and shall not again do such an evil thing in your midst" — "shall hear and fear" at 17:13, 19:20 and 21:21 (the reading\'s formula assert; 13:12\'s "all Israel" the fourth form): 19:20 shares 7 tokens in order with 13:12 ([\'כדבר\', \'הרע\', \'הזה\', \'בקרבך\'] the shared run); israel_hears_and_fears ONE on israel_people (13:12\'s line) THE TAPE\'S REFERENCE'), ('MOVE', "the Sifrei 190:13 (read whole at the reading); cold_run_seducers (CALL) — SE.the_purge_formulas_nine_seats = the purge formula's nine seats — 9 on  — 'THOSE WHO REMAIN SHALL HEAR AND FEAR' — the formula's third seat of four (13:12 all Israel, 17:13 all the people, 19:20 those who remain, 21:21 all Israel): a proclamation is needed (190:13); 'PURGE THE EVIL FROM YOUR MIDST' — the fourth seat of nine (seducers' nine seats by CALL): the evil-doers purged, persons"), ('DATA', "the formula's seat a DATA row — israel_hears_and_fears the tape's reference, NEVER A SECOND WRITE (DJ4); evil_purged_from_the_midst the plotters' body effect; the exam's person the plotting witness executed in the sight of the rest — the evil purged from the midst (the body effect reused, never a line's write)")])
FACT refuge_war_family.the_landmark_and_the_witnesses(the_talion_in_be) = ("the talion in 'be' (19:21) — 'eye in eye' for 'eye in place of eye'; the talion money by Leviticus 24:20's operator (the Sifrei 190:14-15; lev24's PAY-MONEY by CALL; Onkelos one preposition): THE WRITE talion_pity_barred, a BLOCK on Israel at the chapters' own day; the plotter of a blinding pays the eye's value", ['talion_pity_barred', 'pays'], [('INK', 'Deut 19:21 — "AND YOUR EYE SHALL NOT PITY: LIFE IN LIFE, EYE IN EYE, TOOTH IN TOOTH, HAND IN HAND, FOOT IN FOOT" — Exodus 21:24 and Leviticus 24:20 say "eye TACHAT (in place of) eye", Deuteronomy "eye BE- (in) eye" (the reading\'s find: 19:21 shares 4 tokens in order with Exodus 21:24, "eye" the one shared token); "your eye shall not pity" 19:13\'s and 25:12\'s formula; Onkelos CHALAF (in place of) at both (the reading\'s Aramaic assert)'), ('MOVE', "the Sifrei 190:14-15 (read whole at the reading); cold_run_lev24 (CALL) — L24.talion(eye) = PAY-MONEY, effect substitution — 'YOUR EYE SHALL NOT PITY' — read to 25:12's money and here (190:14 — Bava Kamma's ransom the English's note, not read); 'HAND IN HAND, FOOT IN FOOT' — from Exodus 21:24 by the verbal analogy; 'EYE IN EYE' — the talion as MONEY: Leviticus 24:20's substitution the compiled law's operator (lev24 by CALL — through 24:18-22, money is what equalizes); the plotting witness who plotted a blinding pays the eye's value"), ('DATA', "THE WRITE talion_pity_barred — a BLOCK on israel_people at the chapters' own day (DJ2 — the pity formula's seat on the talion); THE PARAMETER the_talions_money (Leviticus 24:20 by CALL — PAY-MONEY, substitution); Onkelos's one preposition a DATA row; the exam's person the plotting witness who plotted to blind — pays the eye's value, no pity")])
