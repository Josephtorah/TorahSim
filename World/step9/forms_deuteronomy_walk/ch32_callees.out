FACT seven_nations.the_holy_people(holy_people) = ("a holy people (7:6) — 19:5-6's treasure and holy nation read back with 14:2 the pair; treasured_people stands (ES by CALL); the readback row EXPANDED", ['accepted'], [('INK', 'Deut 7:6 — "for you are a HOLY PEOPLE to the LORD your God" — the phrase [\'Deut 14:2\', \'Deut 14:21\', \'Deut 7:6\', \'Dan 12:7\', \'Deut 26:19\'] (all this book\'s and Daniel); "a treasured people" [\'1Chr 29:3\', \'Deut 14:2\', \'Deut 26:18\', \'Deut 7:6\', \'Exod 19:5\', \'Mal 3:17\'] (19:5 the first); "above all the peoples on the face of the earth" [\'Deut 14:2\', \'Deut 7:6\']; 14:2 one letter and one word apart [(\'replace\', [\'בך\'], [\'ובך\']), (\'delete\', [\'אלהיך\'], [])]'), ('MOVE', "cold_run_exodus_story (CALL) — ES.sinai(treasure_seats) = 4, fx ['treasured_people'] — 19:5-6's offer — 'you shall be my treasure … a kingdom of priests and a holy nation': treasured_people on the world a heaven entry OPEN on its condition (CQ5); the tape's covenant_offered FOUND"), ('DATA', "the readback row 7:6 EXPANDED — computed 20 tokens against 19:5-6's 31, 3 and 1 shared")])
FACT seven_nations.the_holy_people(chose_you) = ("chose you (7:6-7) — the choice of the people after 4:37's choice of the fathers' seed (OH by CALL); 'set his love' the captive's and Shechem's word", ['accepted'], [('INK', 'Deut 7:6-7 — "the LORD your God CHOSE you" [\'Deut 7:6\'] — the one seat of the form; "and he chose you" [\'Deut 7:7\']; "set his love" [\'1Kgs 9:19\', \'2Chr 8:6\', \'Deut 10:15\', \'Deut 21:11\', \'Deut 7:7\', \'Gen 34:8\', \'Isa 38:17\', \'Ps 91:14\'] (10:15 the fathers; 21:11 the captive woman; Shechem)'), ('MOVE', "cold_run_obey_horeb (CALL) — OH.the_one_god(because_he_loved_your_fathers) = because he loved your fathers (4:37) — the choice of the see — 4:37 'because he loved your fathers he chose their seed after them' — the choice's first Deuteronomy seat; 7:7-8 the love and the choice of the people themselves")])
FACT seven_nations.the_holy_people(the_fewest) = ("the fewest (7:7) — 'not because you were more': the humblest, on the shelf (Chullin 89a); Onkelos 'the smallest': a DATA row, no write", ['accepted'], [('INK', 'Deut 7:7 — "not because you were more than all the peoples did the LORD set his love on you and choose you, for you were THE FEWEST of all peoples" — "the fewest of all peoples" [\'Deut 7:7\']; "because of your multitude" [\'Deut 7:7\']; the plural verse (7:5, 7:7 the two)'), ('MOVE', "Chullin 89a:5-10 (opened whole) — R. Eliezer son of R. Yosei HaGelili: I desire you because when I bestow greatness you DIMINISH yourselves — Abraham 'dust and ashes', Moses and Aaron 'what are we', David 'a worm'; the nations: Nimrod, Pharaoh, Sennacherib, Nebuchadnezzar, Hiram; the world endures by those who make themselves nothing"), ('DATA', "the row the_fewest: 'not because you were more … for you were the fewest of all peoples' (7:7) — the humblest: 'I desire you, since even when I bestow greatness you diminish yourselves before Me' (R. Eliezer son of R. Yosei HaGelili, Chullin 89a:5-10 — Abraham 'dust and ashes', Moses and Aaron 'what are we', David 'a worm'; the nations' boasts — Nimrod, Pharaoh, Sennacherib, Nebuchadnezzar, Hiram)")])
FACT seven_nations.the_holy_people(the_oath) = ('the oath (7:8) — the noun starred by the parser, the swearing no number; the three lines on the tape (MA and JS by CALL); the pointers at 7:8, 7:12, 7:13', ['accepted'], [('INK', 'Deut 7:8 — "because of the LORD\'s love for you and his keeping THE OATH which he swore to your fathers" — "the oath" the noun\'s ten Torah seats [(\'Deut 7:8\', \'השבעה\'), (\'Exod 22:10\', \'שבעת\'), (\'Gen 24:8\', \'משבעתי\'), (\'Gen 26:3\', \'השבעה\'), (\'Lev 5:4\', \'בשבעה\'), (\'Num 5:21\', \'בשבעת\'), (\'Num 5:21\', \'ולשבעה\'), (\'Num 30:3\', \'שבעה\'), (\'Num 30:11\', \'בשבעה\'), (\'Num 30:14\', \'שבעת\')], 7:8 STARRED by the parser (the seven-stem homograph; "swore" no number); "swore to your fathers" [8, 12, 13] in the chapter'), ('MOVE', "cold_run_mamre (CALL) — MA.moriah(test_verb_seats) = 1, MA.isaac_gerar(famine_ordinal) = the_second; cold_run_joseph (CALL) — JS.the_oath(kindness_and_truth) = kindness_and_truth; cold_run_decalogue (CALL) — DC.vain_name(vain_oath) = ['lashes'] — the oath's three lines on the tape — sworn_by_himself (22:16-18), oath_upheld (26:3-5), visitation_promised (50:24); the RUN_CITATION pointers at 7:8 / 7:12 / 7:13 name them (6:10's form); the oath's noun beside the third word's cell (the prohibition's side — 4b's form at 6:13); Onkelos: the oath and the swearing both 'the covenant which he established'")])
FACT seven_nations.the_holy_people(brought_out_redeemed) = ("brought out and redeemed (7:8) — the going out read back with the oath's reason (ES by CALL; the tape's brought_out found): the readback row EXPANDED; no write", ['accepted'], [('INK', 'Deut 7:8 — "the LORD brought you out with a strong hand and REDEEMED you from the house of bondage, from the hand of Pharaoh king of Egypt" — [\'Deut 7:8\']; "redeemed you" the verb\'s six Deuteronomy seats [\'Deut 7:8\', \'Deut 9:26\', \'Deut 13:6\', \'Deut 15:15\', \'Deut 21:8\', \'Deut 24:18\']; "from the hand of Pharaoh king of Egypt" [\'Deut 7:8\']; the narrative verbs of the chapter {7: [\'ויבחר\'], 8: [\'ויפדך\']}'), ('MOVE', "cold_run_exodus_story (CALL) — ES.plagues(ten) = 10; the tape's brought_out at 12:51 — the going out read back with the oath (6:21-23's form): brought_out (12:51) FOUND on the running world; 'with a strong hand' 13:9's own ink; 'redeemed' the chapter's second narrative verb (7:7 'and he chose', 7:8 'and he redeemed you')"), ('DATA', "the readback row 7:8 EXPANDED — computed 22 tokens against 12:51's 13, 2 shared")])
