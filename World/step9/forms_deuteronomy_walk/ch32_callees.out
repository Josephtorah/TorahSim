FACT journeys.DATA[the_four_writings] = {'value': "['Exod 24:4', 'Num 33:2', 'Deut 31:9', 'Deut 31:22']", 'settings': {'four': "'and Moses wrote' at four Torah seats — the covenant's words (Exodus 24:4), THE JOURNEYS (33:2), this Torah (Deuteronomy 31:9), this song (31:22); the tablets at Exodus 34:28 and Deuteronomy 10:4 the "}, 'source': "33:2 'and Moses wrote' — the phrase's seats computed (WROTE)"}
FACT journeys.DATA[the_death_date] = {'value': '(40, 5, 1)', 'settings': {'ordinal_reader': "33:38 'in the fortieth year … in the fifth month, on the first of the month' — the year and the month article-bearing ORDINALS [40, 5], the day [1]: THE TAPE'S OWN MARKER at 20:28 is built from this v", 'first_of_av_or_tammuz': "Seder Olam Rabbah 10:2 'Aaron on the first of Av' with the export's note of the French manuscripts' 'first of Tammuz' — a variant on the month the ink fixes as the fifth (OBSERVED, RESEARCH_LOG)"}, 'source': '33:38 — the ordinals and the number computed (ORDS, INTS); CK.AARON_DATE READ; the marker at Num 20:28 on the tape (CZ5)'}
FACT journeys.DATA[aarons_age] = {'value': '123', 'settings': {'83_plus_40': "Aaron 83 at the speaking before Pharaoh (Exodus 7:7 — [80, 83]) + the era's fortieth year = 123 (33:39 — [123]); Moses 80 + 40 = 120 (Deuteronomy 34:7 — [120]): the brothers three years apart at both "}, 'source': '33:39 by the same parser as Exodus 7:7 and Deuteronomy 34:7 (RETOLD); CK.AARON_AGE READ'}
FACT journeys.DATA[the_eras_stamps] = {'value': "['Exod 19:1', 'Num 33:38', '1Kgs 6:1']", 'settings': {'three_stamps': "'of the going out of the children of Israel from the land of Egypt' at THREE Bible seats — Exodus 19:1 (the third month), Numbers 33:38 (the fortieth year), 1 Kings 6:1 (the 480th year — [480] with th"}, 'source': "33:38 — the phrase's three seats computed (STAMPS); the engine's Calendar with the exodus era's new year in the first month reproduces the chain (ERA_AV, ERA_SHEVAT, ERA_NISAN2, ERA_IYAR2)"}
FACT journeys.DATA[the_morrow_of_the_passover] = {'value': 'the_omer_then_the_produce', 'settings': {'the_omer_then_the_produce': "Joshua 5:11 'they ate of the produce of the land on the morrow of the Passover' — they brought the omer and only afterward ate (Kiddushin 37b:14-38a:1: the new crop's 'dwelling' is wherever you dwell)", 'the_manna_sufficed': "they did not need the new produce, for they still had manna (Kiddushin 38a:2) — the manna's end the morrow's meaning (38a:3-4: forty years less thirty days, the sixteenth of Iyar to the sixteenth of N"}, 'source': "33:3 'on the morrow of the Passover' and Joshua 5:11 — THE PHRASE'S TWO BIBLE SEATS (MORROW): the going out of Egypt and the land's bread on one date-word; Seder Olam Rabbah 10:2 the same reckoning"}
FACT journeys.DATA[the_judgments_on_the_gods] = {'value': 'recorded_at_33_4_alone', 'settings': {'recorded_at_33_4_alone': "Exodus 12:12 'on all the gods of Egypt I will execute judgments' THE SPEC (the future at 12:12 and Ezekiel 25:11 alone); Exodus narrates the firstborn struck (12:29) and never the gods; 'and on their "}, 'source': "33:4 against Exodus 12:12 — the verb's forms computed (JUDG_PERF, JUDG_FUT, the noun's sixteen seats); NO entry on the tape before 33:4 carries the judgments (measured)"}
FACT journeys.DATA[the_three_objects] = {'value': "['figured_stones', 'molten_images', 'high_places']", 'settings': {'figured_stones': "Leviticus 26:1's word (the lemma's six Bible seats: Lev 26:1, Num 33:52, Ezek 8:12, Ps 73:7, Prov 18:11, 25:11) — the ban 'a figured stone you shall not install in your land to bow upon it': Ulla, bow", 'molten_images': "the calf's word (Exodus 32:4, 32:8; Deuteronomy 9:12, 9:16) and the ban's — 'molten gods you shall not make for yourself' (Exodus 34:17; Leviticus 19:4 with the vav; Deuteronomy 27:15 the curse): ER.c", 'high_places': "Leviticus 26:30's curse in the same verb on the same object — 'I will DESTROY your high places' / 'their high places you shall DEMOLISH' (the verb's two Torah seats; the noun's five): the Canaanites' "}, 'source': "33:52 — the three objects' tokens and their seats computed; the other iconoclasm commands (Exodus 23:24, 34:13, Deuteronomy 7:5, 12:2-3) name altars, pillars, asherim and graven images — ER.covenant('demolition_grows') [3, 4, 5] by CALL: 33:52's three are its own list"}
CELL journeys.aarons_death_retold: asks 10 ['the_date', 'the_age', 'the_eras_stamps', 'the_era_new_year', 'verbal_analogy', 'by_the_mouth_kiss', 'moses_seventh_adar', 'arad', 'the_order', 'no_write'] | keys 0 []
FACT journeys.aarons_death_retold(the_date) = ("Aaron died on (40, 5, 1) (33:38) — the tape's marker at 20:28, built from this verse; the ordinal reader's year and month", ['accepted'], [('INK', 'Num 33:38 — "in the fortieth year of the going out … in the fifth month, on the first of the month" — the ordinals [40, 5] and the day [1] = (40, 5, 1); "in the fortieth year" [\'1Chr 26:31\', \'Num 33:38\']; "in the fifth month" [\'Ezra 7:8\', \'Jer 1:3\', \'Jer 28:1\', \'Num 33:38\'] (the Torah\'s one)'), ('MOVE', "cold_run_chukat (CALL) — CK.AARON_DATE = (40, 5, 1); CK.edom_and_hor(death_dates) = Aaron (40, 5, 1) by the ink, aged 123; Miriam the tenth of Nisan by the shelf; Moses the seventh of Adar (33:38-39; Seder Olam 10:2) — the tape's marker at 20:28 is built from this verse (CZ5)"), ('DATA', 'the row the_death_date: (40, 5, 1)')])
FACT journeys.aarons_death_retold(the_age) = ("Aaron 123 at his death (33:39) = Exodus 7:7's 83 + 40; Moses 120 = 80 + 40 — the brothers three years apart at both ends, the ink's checksum", ['accepted'], [('INK', 'Num 33:39 — "a hundred and twenty-three years at his death" — [123]; Exodus 7:7 [80, 83]: 83 + 40 = 123; Moses 80 + 40 = 120 (Deuteronomy 34:7 [120]); "at his death" [\'Deut 34:7\', \'Num 33:39\']'), ('MOVE', "cold_run_chukat (CALL) — CK.AARON_AGE = [123]; CK.edom_and_hor(aaron_age) = Aaron 123 at his death (33:39 — [123]) — the chukat runner's age READ"), ('DATA', 'the row aarons_age: 123')])
FACT journeys.aarons_death_retold(the_eras_stamps) = ("the era's three stamps — Exodus 19:1, Numbers 33:38, 1 Kings 6:1 (the 480th year): the shelf's own chain of proof (Rosh Hashanah 2b:7, 3a:11)", ['accepted'], [('INK', 'Num 33:38 — "of the going out of the children of Israel from the land of Egypt" — [\'1Kgs 6:1\', \'Exod 19:1\', \'Num 33:38\']: THE ERA\'S THREE STAMPS; 1 Kings 6:1 by the parser [480] with the ordinal [2]'), ('MOVE', "Rosh Hashanah 2b:7, 3a:11 — R. Yochanan: kings' years from Nisan — 1 Kings 6:1 juxtaposes Solomon's reign to the going out; the baraita's chain 1 Kings 6:1, Numbers 33:38, Deuteronomy 1:3"), ('DATA', "the row the_eras_stamps: ['Exod 19:1', 'Num 33:38', '1Kgs 6:1']")])
FACT journeys.aarons_death_retold(the_era_new_year) = ("the era's new year from the chapter's date — (40, 5, 1) and (40, 11, 1) in one year, (2, 1, 1) and (2, 2, 20) in one year on the Calendar: not Tishrei, not Iyar (Rosh Hashanah 2b:9, 3a:5)", ['accepted'], [('INK', 'Num 33:38 / Deuteronomy 1:3 — the fortieth year in Av (40, 5, 1) and in Shevat (40, 11, 1) — ONE year on the Calendar; the second year in Nisan (2, 1, 1) and Iyar (2, 2, 20) — one year'), ('MOVE', "Rosh Hashanah 2b:9, 3a:5-6 — Av and the following Shevat both 'the fortieth year' — the exodus count's New Year is not Tishrei; Nisan and Iyar both 'the second year' — not Iyar; 'the third month' without 'the second year' — not Sivan"), ('MOVE', "cold_run_beha (CALL) — BH.march(year_turns) = not in Iyar — Nisan and Iyar in one year — the beha runner's own row")])
FACT journeys.aarons_death_retold(verbal_analogy) = ("the fortieth year / the fortieth year — Deuteronomy 1:3's bare date counted from the exodus by the verbal analogy with 33:38 (Rosh Hashanah 2b:11, taught); the two date readers meet", ['accepted'], [('INK', "Num 33:38 / Deuteronomy 1:3 — the ordinal date (40, 5, 1) (the article-bearing year and month) against the cardinal date (40, 11, 1) (the number reader's) — THE TWO DATE FORMS HAVE TWO READERS"), ('MOVE', "Rosh Hashanah 2b:10-11 — 33:38's epoch EXPLICIT ('of the going out from the land of Egypt'), Deuteronomy 1:3's bare — the verbal analogy 'the fortieth year' / 'the fortieth year' (Rav Pappa's form): a TRANSFER TAUGHT, the teacher named")])
FACT journeys.aarons_death_retold(by_the_mouth_kiss) = ("by the mouth of the LORD at the death (33:38) — the kiss (Bava Batra 17a:3); the chukat runner's row death_by_the_kiss by CALL", ['accepted'], [('INK', 'Num 33:38 — "Aaron the priest went up Mount Hor BY THE MOUTH OF THE LORD and died there" — the phrase\'s seat at the death'), ('MOVE', 'Bava Batra 17a:3 — Moses, Aaron and Miriam died by the mouth of the LORD (33:38; Deuteronomy 34:5) — the kiss, not the Angel of Death'), ('MOVE', "cold_run_chukat (CALL) — CK.DATA[death_by_the_kiss] = miriam_too_by_there_there — the chukat runner's row: Miriam too, by 'there' / 'there'")])
FACT journeys.aarons_death_retold(moses_seventh_adar) = ("Moses' seventh of Adar — computed backward from the tenth of Nisan (Kiddushin 38a:5-6); born and died the same day, a hundred and twenty exact (38a:7): Aaron's date the ink's, Moses' the shelf's", ['accepted'], [('MOVE', "Kiddushin 38a:5-7; Seder Olam Rabbah 10:2 — Moses died on the seventh of Adar — the tenth of Nisan (Joshua 4:19) less thirty-three days (thirty of mourning, three of preparation); born the same day ('this day', Deuteronomy 31:2): the years of the righteous completed to the day"), ('MOVE', 'cold_run_chukat (CALL) — CK.edom_and_hor(death_dates) = Aaron (40, 5, 1) by the ink, aged 123; Miriam the tenth of Nisan by the shelf; Moses the seventh of Adar (33:38-39; Seder Olam 10:2) — Aaron by the ink, Miriam and Moses by the shelf'), ('INK', "Num 33:38-39 — the Torah's one full death-date is Aaron's; Moses' date the shelf's, computed BACKWARD from a run's marker")])
FACT journeys.aarons_death_retold(arad) = ("the Canaanite king of Arad heard (33:40) — 21:1's hearing alone, a run citation of the tape's line at (40, 5, 1); what he heard by CALL: that Aaron died and the clouds departed", ['accepted'], [('INK', 'Num 33:40 — "and the Canaanite king of Arad heard" — [\'Num 21:1\', \'Num 33:40\'] / [\'Num 21:1\', \'Num 33:40\']: 21:1\'s hearing WITHOUT the war, the captives, the vow and Hormah, WITH "in the land of Canaan"; placed right after the death'), ('MOVE', 'cold_run_chukat (CALL) — CK.edom_and_hor(arad_heard) = Arad heard that Aaron died and the clouds departed (Rosh Hashanah 3a; Taanit 9a) — the attack during the mourning — what he heard: that Aaron died and the clouds departed (Rosh Hashanah 3a:1; Taanit 9a:10; Seder Olam Rabbah 9:2)'), ('MOVE', "Rosh Hashanah 3a:3 — 'he is Sihon, he is Arad, he is Canaan' — the hearer's identity disputed on the shelf"), ('DATA', 'the row arads_hearing: that_aaron_died_and_the_clouds_departed')])
FACT journeys.aarons_death_retold(the_order) = ("the fortieth year's order — Aaron's death, Arad, the departure, Sihon: the tape's days in the shelf's order (Rosh Hashanah 2b:13)", ['accepted'], [('MOVE', "Rosh Hashanah 2b:13, 3a:2 — 'after he had slain Sihon' (Deuteronomy 1:4) — Sihon alive at Aaron's death: Av before Shevat"), ('INK', "Num 33:38-40 — the tape's own order: the death at (40, 5, 1), Arad's hearing at (40, 5, 1), the departure from Hor at (40, 6, 1) — CK.D_AARON 14194 < CK.D_DEPART 14224; Sihon smitten after; Moses' oration past the Torah")])
FACT journeys.aarons_death_retold(no_write) = ("no write for 33:38-40 — the death and the hearing are the tape's 20:28 and 21:1 lines, checkpointed, not rewritten", ['—'], [('INK', 'Num 33:38-40 — the death and the hearing stand on the tape at 20:28 (garments_transferred_and_aaron_died, date [40, 5, 1], age 123) and 21:1 (arad_fought_and_took_captives): A RETELLING NEVER WRITES AN ACT TWICE — no line for 33:38-40, the checkpoints CZ5 and CZ6 read the tape')])
DATA KEYS journeys ~ death|aaron|hor|adar|writ|selfsame|manna|forty: ['the_four_writings', 'aarons_age', 'the_death_date']
CELL festivals_judges.the_three_pilgrimages: asks 7 ['the_three_times', 'who_appears', 'the_order_of_the_names', 'not_empty', 'the_two_amounts', 'the_gift_of_the_hand', 'the_guard_of_the_land'] | keys 0 [] | matching 'appear|gift|hand|empty|measure|reiyah|chagig': ['who_appears', 'not_empty', 'the_gift_of_the_hand']
FACT festivals_judges.the_three_pilgrimages(who_appears) = ("who appears (16:16) — all obligated except the twelve exempt, the minor by the father's shoulders (Shammai) or hand (Hillel) — Mishnah Chagigah 1:1 read whole (the Sifrei 143:3-5; calendar.pilgrimage by CALL: the woman exempt): THE PARAMETER the_exempt_from_appearing; the woman at the feast exempt", ['exempt'], [('INK', 'Deut 16:16 — "ALL YOUR MALES" — "your males" [\'זכורך\']; the phrase "all your males shall appear" three in the Bible (Exodus 23:17, 34:23, here — asserted at the reading)'), ('MOVE', "the Sifrei 143:3-5 (read whole at the reading — the Mishnah's minor inside the spine); MISHNAH CHAGIGAH 1:1 (read whole at the design — THE EXAM ROW); cold_run_calendar (CALL) — woman exempt, lame exempt, one-eyed exempt — WHO APPEARS — all are obligated in the appearance except the deaf-mute, the imbecile, the minor, the tumtum, the hermaphrodite, women, unfreed slaves, the lame, the blind, the sick, the old and one who cannot ascend on foot; THE MINOR — the House of Shammai: one who cannot ride on his father's shoulders; the House of Hillel: one who cannot hold his father's hand and ascend, 'three regalim' read at the feet: A PARAMETER with the list and the minor's two arms; the calendar's exempt arms by CALL"), ('DATA', "THE PARAMETER the_exempt_from_appearing (the twelve exempt, the minor two arms); the exam's person the woman at the feast — exempt; the child who can hold his father's hand — obligated by Hillel's arm")])
FACT festivals_judges.the_three_pilgrimages(not_empty) = ("not empty (16:16) — the appearance offering owed at the appearing (the Sifrei 143:8; erection.repeats standing_liability_like_the_appearance_offering by CALL): THE WRITE empty_appearance_barred, a BLOCK on Israel at the chapter's own day; the pilgrim without an offering barred from it", ['empty_appearance_barred'], [('INK', 'Deut 16:16 — "AND NONE SHALL APPEAR BEFORE THE LORD EMPTY" — the one seat of the form (Exodus 23:15 and 34:20 "they shall not appear before Me empty" the plural twins [(\'Exod\', 23, 15), (\'Exod\', 34, 20)]); Onkelos "empty" one seat'), ('MOVE', "the Sifrei 143:8 (read whole at the reading); cold_run_erection (CALL) — ER.repeats(empty_where_it_stands) = standing_liability_like_the_appearance_offering; the one database — appearance_gift_owed on [] — NOT EMPTY — the appearance burnt offering (143:8); 'empty'/'empty' from the appearance offering the standing liability (Bekhorot 51b — the erection's cell by CALL; appearance_gift_owed the erection's debit on its case world, NONE on the tape UNMOVED): THE BLOCK empty_appearance_barred the chapter's third seat of the clause"), ('DATA', "THE WRITE empty_appearance_barred — a BLOCK on israel_people at the counter's day (DH2); the exam's person the pilgrim who appears without an offering — barred from it")])
FACT festivals_judges.the_three_pilgrimages(the_gift_of_the_hand) = ('the gift of the hand (16:17) — many eaters and little property: many peace offerings and few burnt; the reverse reversed; both few the minimums; both many as his hand — Mishnah Chagigah 1:5 read whole (the Sifrei 143:9): THE PARAMETER the_gift_of_the_hand; the man of many eaters accepted', ['accepted'], [('INK', 'Deut 16:17 — "EACH MAN AS THE GIFT OF HIS HAND, according to the blessing of the LORD your God which He has given you" — the verse [\'איש\', \'כמתנת\', \'ידו\']; 12:15\'s six tokens shared in order 6'), ('MOVE', "the Sifrei 143:9 (read whole at the reading — the Mishnah cited in the spine's Hebrew); MISHNAH CHAGIGAH 1:5 (read whole at the design — THE EXAM ROW) — THE GIFT OF THE HAND — one with many eaters and little property brings many peace offerings and few burnt offerings; much property and few eaters — many burnt and few peace; both few — the ma'ah and the two silver; both many — 'each man as the gift of his hand, according to the blessing': A PARAMETER with the four cases"), ('DATA', "THE PARAMETER the_gift_of_the_hand (the four cases); the exam's person the man of many eaters and little property who brings many peace offerings — accepted")])
DATA KEYS festivals_judges ~ appear|reiyah|gift|hand|measure|chagigah|booth: ['the_two_measures', 'the_freewill_measure', 'the_booths_ownership', 'the_exempt_from_appearing', 'the_gift_of_the_hand']
CELL firstfruits_ebal_curses.the_first_fruits: asks 5 ['when_you_come_into_the_land_and_dwell_in_it', 'the_first_of_all_the_fruit_in_a_basket_to_the_place', 'i_declare_this_day_to_the_priest', 'the_recital_a_wandering_aramean', 'set_it_down_bow_and_rejoice_with_the_levite_and_the_stranger'] | keys 0 [] | matching 'measure|amount|species|seven|basket|time|shiur': ['the_first_of_all_the_fruit_in_a_basket_to_the_place']
FACT firstfruits_ebal_curses.the_first_fruits(the_first_of_all_the_fruit_in_a_basket_to_the_place) = ("the first of all the fruit in a basket to the place (26:2) — only the seven species and not before Shavuot, from your own land, in a basket of silver or of peeled willow to the chosen place (the Sifrei 297:4-9, 298:1-2; Bikkurim 1:1-3, 3:8, Terumot 11:3; the calendar's first-ness bring to the house (seven kinds — fetched list) and korach's grant the first fruits of all — holy while attached (18:13; Sifrei 117:2); partners liable, outside the land exempt (Chullin 136a); roofs and ships (Menachot 84b); the household eats (84b:10) by CALL): THE WRITE first_fruits_basket_commanded, a STATUS on Israel at the chapters' own day; the bringer of the hills' dates refused", ['first_fruits_basket_commanded'], [('INK', "Deut 26:2 — 'you shall take OF THE FIRST OF ALL THE FRUIT OF THE GROUND which you bring from your land … and put it IN A BASKET and go to THE PLACE which the LORD your God chooses' — 'of the first' and not all the first; 'your land'; the basket a vessel; the place the chosen one (12:5's cell)"), ('MOVE', "the Sifrei 297:4-9, 298:1-2 (read whole at the reading — the species by the two loaves' analogy, I2, checked in MIDDOT.md); MISHNAH BIKKURIM 1:1, 1:2, 1:3, 3:8 and TERUMOT 11:3 (the exam rows, read whole — 1:1-2 CITED IN THE SPINE'S OWN HEBREW at 297); cold_run_calendar (CALL) — CA.first_fruits = bring to the house (seven kinds — fetched list); cold_run_korach (CALL) — KO.the_gifts(bikkurim) = the first fruits of all — holy while attached (18:13; Sifrei 117:2); partners liable, outside the land exempt (Chullin 136a); roofs and ships (Menachot 84b); the household eats (84b:10), (the_best_triad) = the best of the oil, the wine and the grain (18:12) — Izhar's word; the triad reversed against eleven seats (computed); kind for kind: each type its first (Bekhorot 53b, 54b); cold_run_place_name (CALL) — PN.the_place_chosen(the_stations_six_rows) read — ONLY THE SEVEN SPECIES, not dates of the hills nor fruit of the valleys nor olives not choice, NOT BEFORE SHAVUOT (Bikkurim 1:3 — the men of Mount Zevoim refused); no liquids but from olives and grapes (Terumot 11:3); the one who plants in his own and bends into another's does not bring, sharecroppers and robbers do not bring — 'the first fruits of YOUR land' (Bikkurim 1:1-2; Exodus 23:19 by the calendar's cell — first-ness the ink's, the species the transmitted list); the basket — the rich in silver and gold, the poor in peeled willow, THE BASKETS AND THE FIRST FRUITS TO THE PRIESTS (Bikkurim 3:8); Shiloh and the House by the place's eras"), ('DATA', "THE WRITE first_fruits_basket_commanded — a STATUS on israel_people at the chapters' own day (DL2); THE PARAMETERS the_species (Bikkurim 1:3; Terumot 11:3), the_bringers_and_the_reciters (Bikkurim 1:1-2), the_baskets (Bikkurim 3:8); the exam's person the one who brings dates from the hills — refused, not of the seven")])
CELL firstfruits_ebal_curses.the_curses_of_the_siege_and_the_exile: asks 16 ['all_these_curses_pursue_you_until_you_are_destroyed', 'because_you_served_not_with_joy', 'serve_your_enemies_in_hunger_thirst_nakedness_and_want_an_iron_yoke', 'a_nation_from_the_end_of_the_earth_as_the_eagle_flies', 'it_eats_the_fruit_of_your_beast_and_your_ground', 'besieges_you_in_all_your_gates_until_the_high_walls_fall', 'you_eat_the_fruit_of_your_own_womb_in_the_siege_and_the_distress', 'the_tender_man_and_the_delicate_woman_grudge_their_children', 'if_you_keep_not_all_the_words_of_this_law_written_in_this_book', 'plagues_made_wonderful_the_diseases_of_egypt_returned', 'left_few_in_number_as_he_rejoiced_so_he_rejoices_to_destroy', 'scattered_among_all_peoples_to_serve_wood_and_stone', 'no_rest_for_the_sole_of_your_foot_a_trembling_heart', 'your_life_hangs_in_doubt_morning_and_evening', 'back_to_egypt_in_ships_sold_and_none_buys', 'these_are_the_words_of_the_covenant_in_the_land_of_moab_besides_horeb'] | keys 0 []
FACT firstfruits_ebal_curses.the_curses_of_the_siege_and_the_exile(a_nation_from_the_end_of_the_earth_as_the_eagle_flies) = ("a nation from the end of the earth as the eagle flies (28:49-50) — the eagle's three seats in the book; a tongue not understood: THE WRITE eagle_nation_devours, a HEAVEN entry on Israel at the chapters' own day", ['eagle_nation_devours'], [('INK', "Deut 28:49-50 — 'THE LORD WILL BRING A NATION AGAINST YOU FROM AFAR, FROM THE END OF THE EARTH, AS THE EAGLE FLIES, a nation whose tongue you shall not understand, a nation of fierce countenance which shall not regard the old nor favor the young' — the eagle's three seats in the book (14:12, 28:49, 32:11)"), ('MOVE', "Onkelos 28:49 plain; cold_run_food_tithe (CALL) — the eagle 14:12's first seat in the book (FT.the_third_year(the_resident_alien_at_the_gate) = the resident alien at the gate (14:21, 1 — the cell's edge live; the birds' list the chapter's) — a nation from afar as the eagle flies — the siege's people; a tongue not understood, a fierce countenance"), ('DATA', "THE WRITE eagle_nation_devours — a HEAVEN entry on israel_people at the chapters' own day (DL2); the exam's person the nation whose tongue is not understood — accepted")])
