teousness=עַמִּים הַר יִקְרָאוּ שָׁם יִזְבְּחוּ זִבְחֵי צֶדֶק | gad_enlarged_lioness_first_part_lawgivers_portion_blessed=בָּרוּךְ מַרְחִיב גָּד כְּלָבִיא שָׁכֵן | gad_came_with_the_heads_righteousness_of_the_lord_executed=וַיֵּתֵא רָאשֵׁי עָם צִדְקַת יְהוָה עָשָׂה | dan_lions_whelp_leaps_from_bashan_blessed=דָּן גּוּר אַרְיֵה יְזַנֵּק מִן הַבָּשָֽׁן | naphtali_sated_with_favor_sea_and_south_blessed=נַפְתָּלִי שְׂבַע רָצוֹן וּמָלֵא בִּרְכַּת יְהוָה | asher_blessed_above_sons_foot_dipped_in_oil=בָּרוּךְ מִבָּנִים אָשֵׁר יְהִי רְצוּי אֶחָיו | iron_and_brass_bars_strength_as_your_days_blessed=בַּרְזֶל וּנְחֹשֶׁת מִנְעָלֶיךָ וּכְיָמֶיךָ דָּבְאֶֽךָ | none_like_the_god_of_jeshurun_rider_of_the_heaven_declared=אֵין כָּאֵל יְשֻׁרוּן רֹכֵב שָׁמַיִם בְעֶזְרֶךָ | eternal_god_dwelling_everlasting_arms_enemy_driven_out_declared=מְעֹנָה אֱלֹהֵי קֶדֶם וּמִתַּחַת זְרֹעֹת עוֹלָם | israel_dwells_in_safety_alone_fountain_of_jacob_declared=וַיִּשְׁכֹּן יִשְׂרָאֵל בֶּטַח בָּדָד עֵין יַעֲקֹב | happy_are_you_israel_shield_and_sword_high_places_trodden_declared=אַשְׁרֶיךָ יִשְׂרָאֵל מִי כָמוֹךָ עַם נוֹשַׁע בַּֽיהוָה
