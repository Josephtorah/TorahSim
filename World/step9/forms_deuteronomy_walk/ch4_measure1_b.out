==== A. THE RETELLINGS DIFFED
  Deut 4:3 (20) vs Num 25:3 (8): [replace: 'עיניכם הראת את אשר עשה' -> 'ויצמד ישראל לבעל פעור ויחר אף'] =יהוה [replace: 'בבעל פעור כי כל האיש אשר הלך אחרי בעל פעור השמידו יהוה אלהיך מקרבך' -> 'בישראל']
  Deut 4:3 (20) vs Num 25:5 (11): [replace: 'עיניכם הראת את אשר עשה יהוה בבעל' -> 'ויאמר משה אל שפטי ישראל הרגו איש אנשיו הנצמדים לבעל'] =פעור [delete: 'כי כל האיש אשר הלך אחרי בעל פעור השמידו יהוה אלהיך מקרבך' -> '']
  Deut 4:11 (13) vs Exod 19:17 (11): [replace: 'ותקרבון ותעמדון תחת' -> 'ויוצא משה את העם לקראת האלהים מן המחנה ויתיצבו בתחתית'] =ההר [delete: 'וההר בער באש עד לב השמים חשך ענן וערפל' -> '']
  Deut 4:11 (13) vs Exod 19:18 (18): [replace: 'ותקרבון ותעמדון תחת' -> 'והר סיני עשן כלו מפני אשר ירד עליו יהוה באש ויעל עשנו כעשן הכבשן ויחרד כל'] =ההר [replace: 'וההר בער באש עד לב השמים חשך ענן וערפל' -> 'מאד']
  Deut 4:11 (13) vs Deut 5:22 (24): [replace: 'ותקרבון ותעמדון תחת ההר וההר בער באש עד לב השמים חשך ענן וערפל' -> 'את הדברים האלה דבר יהוה אל כל קהלכם בהר מתוך האש הענן והערפל קול גדול ולא יסף ויכתבם על שני לחת אבנים ויתנם אלי']
  Deut 4:12 (14) vs Deut 5:4 (8): [replace: 'וידבר' -> 'פנים בפנים דבר'] =יהוה [replace: 'אליכם' -> 'עמכם בהר'] =מתוך האש [delete: 'קול דברים אתם שמעים ותמונה אינכם ראים זולתי קול' -> '']
  Deut 4:12 (14) vs Deut 5:24 (23): [replace: 'וידבר' -> 'ותאמרו הן הראנו'] =יהוה [replace: 'אליכם' -> 'אלהינו את כבדו ואת גדלו ואת קלו שמענו'] =מתוך האש [replace: 'קול דברים אתם שמעים ותמונה אינכם ראים זולתי קול' -> 'היום הזה ראינו כי ידבר אלהים את האדם וחי']
  Deut 4:13 (15) vs Exod 34:28 (22): [replace: 'ויגד לכם' -> 'ויהי שם עם יהוה ארבעים יום וארבעים לילה לחם לא אכל ומים לא שתה ויכתב על הלחת'] =את [replace: 'בריתו אשר צוה אתכם לעשות' -> 'דברי הברית'] =עשרת הדברים [delete: 'ויכתבם על שני לחות אבנים' -> '']
  Deut 4:13 (15) vs Exod 31:18 (16): [replace: 'ויגד לכם את בריתו אשר צוה אתכם לעשות עשרת הדברים ויכתבם על' -> 'ויתן אל משה ככלתו לדבר אתו בהר סיני'] =שני [replace: 'לחות אבנים' -> 'לחת העדת לחת אבן כתבים באצבע אלהים']
  Deut 4:13 (15) vs Deut 5:22 (24): [delete: 'ויגד לכם' -> ''] =את [delete: 'בריתו אשר צוה אתכם לעשות עשרת' -> ''] =הדברים [insert: '' -> 'האלה דבר יהוה אל כל קהלכם בהר מתוך האש הענן והערפל קול גדול ולא יסף'] =ויכתבם על שני [replace: 'לחות' -> 'לחת'] =אבנים [insert: '' -> 'ויתנם אלי']
