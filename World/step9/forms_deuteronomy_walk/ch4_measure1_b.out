  Deut 4:16 (12) vs Deut 5:8 (16): [replace: 'פן תשחתון ועשיתם לכם' -> 'לא תעשה לך'] =פסל [delete: 'תמונת' -> ''] =כל [replace: 'סמל תבנית זכר או נקבה' -> 'תמונה אשר בשמים ממעל ואשר בארץ מתחת ואשר במים מתחת לארץ']
  Deut 4:19 (28) vs Deut 17:3 (16): [replace: 'ופן תשא עיניך השמימה וראית את השמש ואת הירח ואת הכוכבים כל' -> 'וילך ויעבד אלהים אחרים וישתחו להם ולשמש או לירח או לכל'] =צבא השמים [delete: 'ונדחת והשתחוית להם ועבדתם' -> ''] =אשר [replace: 'חלק יהוה אלהיך אתם לכל העמים תחת כל השמים' -> 'לא צויתי']
  Deut 4:21 (21) vs Deut 3:26 (19): [replace: 'ויהוה התאנף' -> 'ויתעבר יהוה'] =בי [replace: 'על דבריכם וישבע לבלתי עברי את הירדן ולבלתי בא' -> 'למענכם ולא שמע אלי ויאמר יהוה אלי רב לך'] =אל [replace: 'הארץ הטובה אשר יהוה אלהיך נתן לך נחלה' -> 'תוסף דבר אלי עוד בדבר הזה']
  Deut 4:21 (21) vs Deut 1:37 (11): [replace: 'ויהוה' -> 'גם בי'] =התאנף [delete: 'בי על דבריכם וישבע לבלתי עברי את הירדן ולבלתי בא אל הארץ הטובה אשר' -> ''] =יהוה [replace: 'אלהיך נתן לך נחלה' -> 'בגללכם לאמר גם אתה לא תבא שם']
  Deut 4:21 (21) vs Num 20:12 (25): [replace: 'ויהוה התאנף' -> 'ויאמר יהוה אל משה ואל אהרן יען לא האמנתם'] =בי [replace: 'על דבריכם וישבע לבלתי עברי' -> 'להקדישני לעיני בני ישראל לכן לא תביאו'] =את [replace: 'הירדן ולבלתי בא' -> 'הקהל הזה'] =אל הארץ [delete: 'הטובה' -> ''] =אשר [replace: 'יהוה אלהיך נתן לך נחלה' -> 'נתתי להם']
  Deut 4:22 (16) vs Deut 3:27 (17): [insert: '' -> 'עלה ראש הפסגה ושא עיניך ימה וצפנה ותימנה ומזרחה וראה בעיניך'] =כי [replace: 'אנכי מת בארץ הזאת אינני עבר' -> 'לא תעבר'] =את הירדן [replace: 'ואתם עברים וירשתם את הארץ הטובה הזאת' -> 'הזה']
