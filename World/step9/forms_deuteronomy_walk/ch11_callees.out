  second_census.the_roll({ask:hu_dathan})                        ('this is Dathan and Abiram — the same from beginning to end', ['accepted'])
  second_census.the_roll({ask:korach_recalled})                  ("both deaths on one verse; the mode the Korach runner's open row", ['accepted'])
  second_census.the_roll({ask:korachs_dead})                     ('14700 and 250 carry no tribe — no delta row explained by them', ['counted'])
  second_census.the_roll({ask:reuben_firstborn})                 ("the firstborn kept on the roll; the birthright Joseph's by Chronicles", ['accepted'])
  second_census.the_roll({ask:serah})                            ("Serah on three rosters — the shelf's survivor of both rolls", ['souls_counted'])
  second_census.the_roll({ask:simeons_gap})                      ("-37100 against the plague's 24000: 13100 unexplained", ['counted'])
  second_census.the_roll({ask:single_son_plural})                ("sons for one son (26:8); a grandson not a son — the roll's Ard and Naaman", ['accepted'])
  second_census.the_roll({ask:sons_of_korach})                   ('the sons of Korach did not die', ['accepted'])
  second_census.the_roll({ask:total})                            ('601730 = the twelve summed; 603,550 at the first roll', ['counted'])
  second_census.the_roll({ask:twelve_counts})                    ("twelve at both seats, the parser's", ['counted'])
