  second_census.the_roll({ask:daughters_row})                    ('no sons, only daughters — the premise on the roll; the heir the daughter', ['holding_owed'])
  second_census.the_roll({ask:deltas})                           ('five fell, seven rose, the whole -1820 — declared, not derived', ['counted'])
